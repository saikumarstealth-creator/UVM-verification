// ---------------------------------------------------------------------------
// All-Register Sequence — direct writes/reads to every register
// ---------------------------------------------------------------------------
class {{ spec.design_name }}_all_regs_seq extends uvm_reg_sequence #(uvm_reg_item);
  `uvm_object_utils({{ spec.design_name }}_all_regs_seq)

  {{ spec.design_name }}_reg_block reg_model;

  function new(string name = "{{ spec.design_name }}_all_regs_seq");
    super.new(name);
  endfunction

  task body;
    uvm_status_e st;
    uvm_reg_data_t val;

    `uvm_info("RAL_SEQ", "Starting exhaustive register access sequence", UVM_LOW)

    foreach (reg_model.reg_map.get_regs()[i]) begin
      uvm_reg rg = reg_model.reg_map.get_regs()[i];
      if (rg == null) continue;

      val = $urandom_range(0, (1 << {{ data_width }}) - 1);
      `uvm_info("RAL_SEQ", $sformatf("Writing 0x%0h to %s", val, rg.get_name()), UVM_MEDIUM)
      rg.write(st, val, .parent(this));
      if (st != UVM_IS_OK)
        `uvm_error("RAL_SEQ", $sformatf("%s write failed with status %s", rg.get_name(), st.name()))
    end

    foreach (reg_model.reg_map.get_regs()[i]) begin
      uvm_reg rg = reg_model.reg_map.get_regs()[i];
      if (rg == null) continue;

      rg.read(st, val, .parent(this));
      if (st != UVM_IS_OK)
        `uvm_error("RAL_SEQ", $sformatf("%s read failed with status %s", rg.get_name(), st.name()))
    end

    `uvm_info("RAL_SEQ", "Exhaustive register access sequence completed", UVM_LOW)
  endtask
endclass
