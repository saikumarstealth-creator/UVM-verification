// UVM RAL Model for {{ spec.design_name }}
// Auto-generated from spec registers — production-grade
{% set regs = spec.registers if spec.registers else [] %}
{% set sizes = regs|map(attribute='size')|select('number')|list %}
{% set data_width = sizes|max if sizes else 32 %}
{% set all_addrs = regs|map(attribute='address')|map('replace', '0x', '')|map('replace', 'h', '')|map('int', 16)|list %}
{% set max_addr = all_addrs|max if all_addrs else 0 %}
{% set addr_bits = [max_addr.bit_length(), 3]|max %}
{% set stride = [data_width // 8, 1]|max %}

// ============================================================================
// Register Classes
// ============================================================================
{% for r in regs %}
{% set reg_width = r.size if r.size else data_width %}
{% set reg_access = r.access|upper if r.access else "RW" %}

class {{ spec.design_name }}_reg_{{ r.name|lower }} extends uvm_reg;
  `uvm_object_utils({{ spec.design_name }}_reg_{{ r.name|lower }})
{% if r.fields %}
{% for f in r.fields %}
  rand uvm_reg_field {{ f.name|lower }};
{% endfor %}
{% else %}
  rand uvm_reg_field data;
{% endif %}

  function new(string name = "{{ spec.design_name }}_reg_{{ r.name|lower }}");
    super.new(name, {{ reg_width }}, UVM_CVR_ALL);
  endfunction

  virtual function void build();
{% set ns = namespace(lsb=0) %}
{% if r.fields %}
{% for f in r.fields %}
  {% set f_acc = f.access|upper if f.access else reg_access %}
  {% if ':' in f.bits %}
    {% set parts = f.bits.split(':') %}
    {% set msb = parts[0]|int %}
    {% set lsb = parts[1]|int %}
    {% set f_width = msb - lsb + 1 %}
  {% else %}
    {# Single bit: bits: '3' means 1-bit field at position 3 #}
    {% set lsb = f.bits|int %}
    {% set f_width = 1 %}
  {% endif %}
  {% set f_reset = f.reset if f.reset else (r.reset_value if r.reset_value else '0') %}
    {{ f.name|lower }} = uvm_reg_field::type_id::create("{{ f.name|lower }}");
    {{ f.name|lower }}.configure(this, {{ f_width }}, {{ lsb }}, "{{ f_acc }}",
      {% if r.volatile %}1{% else %}0{% endif %}, {{ reg_width }}'h{{ f_reset }}, 1, 1, 1);
{% endfor %}
{% else %}
  {% set r_reset = r.reset_value if r.reset_value else '0' %}
    data = uvm_reg_field::type_id::create("data");
    data.configure(this, {{ reg_width }}, 0, "{{ reg_access }}",
      {% if r.volatile %}1{% else %}0{% endif %}, {{ reg_width }}'h{{ r_reset }}, 1, 1, 1);
{% endif %}
  endfunction

  // Enable field-value coverage for functional coverage analysis
  function void build_coverage();
    if (get_coverage() inside {UVM_CVR_ALL, UVM_CVR_FIELD_VALS})
      super.build_coverage();
    has_cover = (get_coverage() == UVM_CVR_ALL) ? 1 : get_coverage();
  endfunction

  // HDL path for backdoor access (peek/poke/mirror against RTL)
  virtual function void add_hdl_path();
    add_hdl_path_slice("{{ r.name|lower }}_reg", 0, {{ reg_width }});
  endfunction
endclass

{% endfor %}

// ============================================================================
// Register Block
// ============================================================================
class {{ spec.design_name }}_reg_block extends uvm_reg_block;
  `uvm_object_utils({{ spec.design_name }}_reg_block)
{% for r in regs %}
  rand {{ spec.design_name }}_reg_{{ r.name|lower }} {{ r.name|lower }};
{% endfor %}

  uvm_reg_map reg_map;

  function new(string name = "{{ spec.design_name }}_reg_block");
    super.new(name, UVM_CVR_ALL);
  endfunction

  virtual function void build();
{% for r in regs %}
    {{ r.name|lower }} = {{ spec.design_name }}_reg_{{ r.name|lower }}::type_id::create("{{ r.name|lower }}");
{% endfor %}
{% for r in regs %}
    {{ r.name|lower }}.configure(this, null, "");
{% endfor %}
{% for r in regs %}
    {{ r.name|lower }}.build();
{% endfor %}
    reg_map = create_map("reg_map", 'h0, {{ stride }}, UVM_LITTLE_ENDIAN, 1);
{% for r in regs %}
    reg_map.add_reg({{ r.name|lower }}, 'h{{ r.address.replace('0x', '').replace('h', '') }}, "{{ r.access|upper if r.access else 'RW' }}");
{% endfor %}
    lock_model();
  endfunction

  // ── Predictor wiring ──────────────────────────────────────────────────
  // Call this after environment build:
  //   reg_block.connect_predictor(predictor, adapter, monitor.ap);
  function void connect_predictor(
    {{ spec.design_name }}_reg_predictor predictor,
    {{ spec.design_name }}_reg_adapter  adapter,
    uvm_analysis_port #({{ spec.design_name }}_seq_item) bus_ap
  );
    predictor.map       = this.reg_map;
    predictor.adapter   = adapter;
    bus_ap.connect(predictor.bus_in);
  endfunction
endclass

// ============================================================================
// Register Adapter
// ============================================================================
class {{ spec.design_name }}_reg_adapter extends uvm_reg_adapter;
  `uvm_object_utils({{ spec.design_name }}_reg_adapter)

  function new(string name = "{{ spec.design_name }}_reg_adapter");
    super.new(name);
    supports_byte_enable = 0;
    provides_responses   = 1;
  endfunction

  virtual function uvm_sequence_item reg2bus(const ref uvm_reg_bus_op rw);
    {{ spec.design_name }}_seq_item item;
    item = {{ spec.design_name }}_seq_item::type_id::create("item");
    item.we   = (rw.kind == UVM_WRITE) ? 1'b1 : 1'b0;
    item.addr = rw.addr[{{ (addr_bits-1) if addr_bits > 0 else 0 }}:0];
    item.data = rw.data[{{ data_width-1 }}:0];
    return item;
  endfunction

  virtual function void bus2reg(uvm_sequence_item bus_item, ref uvm_reg_bus_op rw);
    {{ spec.design_name }}_seq_item item;
    if (!$cast(item, bus_item)) begin
      `uvm_fatal("NOT_REG_TYPE", "bus_item is not of the {{ spec.design_name }}_seq_item type")
      return;
    end
    rw.kind   = item.we ? UVM_WRITE : UVM_READ;
    rw.addr   = item.addr;
    rw.data   = item.data;
    rw.status = UVM_IS_OK;
  endfunction
endclass

// ============================================================================
// Memory Walk Sequence — walks address map (registers and memory regions),
// validates decode and read/write integrity.
// ============================================================================
class {{ spec.design_name }}_reg_mem_walk_seq extends uvm_reg_mem_walk_seq;
  `uvm_object_utils({{ spec.design_name }}_reg_mem_walk_seq)

  {{ spec.design_name }}_reg_block reg_model;
  int total_regions;
  int completed_regions;
  int errors;

  function new(string name = "{{ spec.design_name }}_reg_mem_walk_seq");
    super.new(name);
  endfunction

  task body();
    model = reg_model;
    super.body();
  endtask
endclass

// ---------------------------------------------------------------------------
// Enhanced All-Registers Sequence: writes unique patterns to every register
// then reads them back. Supports burst mode and data integrity checks.
// ---------------------------------------------------------------------------
class {{ spec.design_name }}_enhanced_regs_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_enhanced_regs_seq)

  rand int burst_size;
  int writes_issued;
  int reads_issued;
  int mismatches;

  constraint c_burst { burst_size inside {[1:16]}; }

  function new(string n = "{{ spec.design_name }}_enhanced_regs_seq");
    super.new(n);
    burst_size = 4;
  endfunction

  task body;
    uvm_status_e st;
    uvm_reg_data_t val;
    uvm_reg rg;
    uvm_reg rg_array[$];
    logic [{{ data_width-1 }}:0] golden[$];
    int burst_cnt;
    string rg_name;

    if (reg_model == null) begin
      `uvm_fatal("SEQ", "reg_model not set in enhanced_regs_seq")
    end

    rg_array = reg_model.reg_map.get_regs();
    `uvm_info("ENH_REG", $sformatf("Starting enhanced reg walk: %0d registers, burst=%0d",
              rg_array.size(), burst_size), UVM_LOW)

    // ── Write phase (burst mode) ──────────────────────────────────────
    foreach (rg_array[i]) begin
      rg = rg_array[i];
      if (rg == null) continue;
      rg_name = rg.get_name();

      // Skip read-only registers
      if (rg.get_access() inside {"RO", "RC"}) begin
        `uvm_info("ENH_REG", $sformatf("Skipping RO/RC register: %s", rg_name), UVM_HIGH)
        continue;
      end

      // Generate data: walking-1 pattern based on register index
      val = ({{ data_width }}'(1) << (i % {{ data_width }})) |
            {{ data_width }}'(i * 32 + 16);
      golden.push_back(val);

      `uvm_info("ENH_REG", $sformatf("Writing %s = 0x%0h (walking-bit pattern)",
                rg_name, val), UVM_MEDIUM)
      rg.write(st, val, .parent(this));
      writes_issued++;

      if (st != UVM_IS_OK) begin
        `uvm_error("ENH_REG", $sformatf("%s write failed with status %s", rg_name, st.name()))
      end

      // Burst pacing: insert a few ns between burst groups
      burst_cnt++;
      if (burst_cnt >= burst_size) begin
        burst_cnt = 0;
        #100ns;
      end
    end

    // Separator between write and read bursts
    #200ns;

    // ── Read phase ────────────────────────────────────────────────────
    foreach (rg_array[j]) begin
      rg = rg_array[j];
      if (rg == null) continue;
      rg_name = rg.get_name();

      if (rg.get_access() inside {"RO", "RC"}) begin
        // Read-only: just verify it reads without error
        rg.read(st, val, .parent(this));
        if (st != UVM_IS_OK)
          `uvm_error("ENH_REG", $sformatf("RO %s read failed with status %s", rg_name, st.name()))
        else
          `uvm_info("ENH_REG", $sformatf("RO %s = 0x%0h (no golden check)", rg_name, val), UVM_HIGH)
        continue;
      end

      rg.read(st, val, .parent(this));
      reads_issued++;

      if (st != UVM_IS_OK) begin
        `uvm_error("ENH_REG", $sformatf("%s read failed with status %s", rg_name, st.name()))
        mismatches++;
      end else if (j < golden.size() && val !== golden[j]) begin
        mismatches++;
        `uvm_error("ENH_REG", $sformatf("%s mismatch: wrote 0x%0h, read 0x%0h",
                  rg_name, golden[j], val))
      end else begin
        `uvm_info("ENH_REG", $sformatf("%s MATCH: 0x%0h", rg_name, val), UVM_HIGH)
      end
    end

    `uvm_info("ENH_REG", $sformatf(
      "\n  === Enhanced Register Walk Report ==="
      "\n  Writes:     %0d"
      "\n  Reads:      %0d"
      "\n  Mismatches: %0d"
      "\n  Status:     %s",
      writes_issued, reads_issued, mismatches,
      (mismatches == 0) ? "PASS" : "FAIL"
    ), UVM_LOW)
  endtask
endclass

