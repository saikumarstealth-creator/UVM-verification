// UVM RAL (Register Abstraction Layer) Model for {{ spec.design_name }}
// Generated from YAML register specification
// --- DO NOT EDIT: auto-generated from spec registers ---
{% set regs = spec.registers if spec.registers else [] %}
{% set sizes = regs|map(attribute='size')|select('number')|list %}
{% set data_width = sizes|max if sizes else 8 %}
{% set addr_bits = (regs|map(attribute='address')|map('replace', '0x', '')|map('replace', 'h', '')|map('int', 16)|max + 1).bit_length() if regs else 8 %}

// ============================================================================
// Register Classes — one class per register in spec
// ============================================================================
{% for r in regs %}
class {{ spec.design_name }}_reg_{{ r.name|lower }} extends uvm_reg;
  `uvm_object_utils({{ spec.design_name }}_reg_{{ r.name|lower }})
{% if r.fields %}
{% for f in r.fields %}
  {% if f.bits %}
    {% set access = r.access|default("rw")|upper %}
    {% set is_ro = access in ("RO", "RO") %}
  rand uvm_reg_field {{ f.name|lower }};
  {% endif %}
{% endfor %}
{% else %}
  rand uvm_reg_field data;
{% endif %}

  function new(string name = "{{ spec.design_name }}_reg_{{ r.name|lower }}");
    super.new(name, {{ r.size|default(8) }}, UVM_NO_COVERAGE);
  endfunction

  virtual function void build();
{% if r.fields %}
  {% set ns = namespace(lsb=0) %}
  {% for f in r.fields %}
    {% set access = "RW" %}
    {% if r.access %}
      {% set access = r.access|upper %}
    {% endif %}
    {% if access == "RO" %}
      {% set access_str = "RO" %}
    {% elif access == "WO" %}
      {% set access_str = "WO" %}
    {% else %}
      {% set access_str = "RW" %}
    {% endif %}
    {% if ':' in f.bits %}
      {% set parts = f.bits.split(':') %}
      {% set msb = parts[0]|int %}
      {% set lsb = parts[1]|int %}
      {% set f_width = msb - lsb + 1 %}
    {% else %}
      {% set f_width = f.bits|int %}
      {% if f_width <= 0 %}{% set f_width = 1 %}{% endif %}
      {% set lsb = ns.lsb %}
    {% endif %}
    {{ f.name|lower }} = uvm_reg_field::type_id::create("{{ f.name|lower }}");
    {{ f.name|lower }}.configure(this, {{ f_width }}, {{ lsb }}, "{{ access_str }}", {% if r.volatile %}1{% else %}0{% endif %}, {% if r.reset_value %}{{ r.size|default(8) }}'h{{ r.reset_value }}{% else %}'h0{% endif %}, 1, 1, 1);
    {% set ns.lsb = lsb + f_width %}
  {% endfor %}
{% else %}
    data = uvm_reg_field::type_id::create("data");
    data.configure(this, {{ r.size|default(8) }}, 0, "{% if r.access %}{{ r.access|upper }}{% else %}RW{% endif %}", {% if r.volatile %}1{% else %}0{% endif %}, {% if r.reset_value %}{{ r.size|default(8) }}'h{{ r.reset_value }}{% else %}'h0{% endif %}, 1, 1, 1);
{% endif %}
  endfunction
endclass
{% endfor %}

// ============================================================================
// Register Block
// ============================================================================
class {{ spec.design_name }}_reg_block extends uvm_reg_block;
  `uvm_object_utils({{ spec.design_name }}_reg_block)
{% for r in regs %}
  rand {{ spec.design_name }}_reg_{{ r.name|lower }} {{ r.name|lower }};
{% endfor %}

  uvm_reg_map reg_map;

  function new(string name = "{{ spec.design_name }}_reg_block");
    super.new(name, UVM_NO_COVERAGE);
  endfunction

  virtual function void build();
{% for r in regs %}
    {{ r.name|lower }} = {{ spec.design_name }}_reg_{{ r.name|lower }}::type_id::create("{{ r.name|lower }}");
{% endfor %}
{% for r in regs %}
    {{ r.name|lower }}.configure(this, null, "");
{% endfor %}
{% for r in regs %}
    {{ r.name|lower }}.build();
{% endfor %}
    reg_map = create_map("reg_map", 'h0, 1, UVM_LITTLE_ENDIAN, 1);
{% for r in regs %}
    reg_map.add_reg({{ r.name|lower }}, 'h{{ r.address.replace('0x', '').replace('h', '') }}, "{% if r.access %}{{ r.access|upper }}{% else %}RW{% endif %}");
{% endfor %}
    lock_model();
  endfunction
endclass

// ============================================================================
// Register Adapter
// ============================================================================
class {{ spec.design_name }}_reg_adapter extends uvm_reg_adapter;
  `uvm_object_utils({{ spec.design_name }}_reg_adapter)

  function new(string name = "{{ spec.design_name }}_reg_adapter");
    super.new(name);
    supports_byte_enable = 0;
    provides_responses = 1;
  endfunction

  virtual function uvm_sequence_item reg2bus(const ref uvm_reg_bus_op rw);
    {{ spec.design_name }}_seq_item item;
    item = {{ spec.design_name }}_seq_item::type_id::create("item");
    item.we   = (rw.kind == UVM_WRITE) ? 1'b1 : 1'b0;
    item.addr = rw.addr[{{ (addr_bits-1) if addr_bits > 0 else 0 }}:0];
    item.data = rw.data[{{ data_width-1 }}:0];
    return item;
  endfunction

  virtual function void bus2reg(uvm_sequence_item bus_item, ref uvm_reg_bus_op rw);
    {{ spec.design_name }}_seq_item item;
    if (!$cast(item, bus_item)) begin
      `uvm_fatal("NOT_REG_TYPE", "bus_item is not of the {{ spec.design_name }}_seq_item type")
      return;
    end
    rw.kind = item.we ? UVM_WRITE : UVM_READ;
    rw.addr = item.addr;
    rw.data = item.data;
    rw.status = UVM_IS_OK;
  endfunction
endclass

// ============================================================================
// Register Predictor
// ============================================================================
class {{ spec.design_name }}_reg_predictor extends uvm_reg_predictor #({{ spec.design_name }}_seq_item);
  `uvm_component_utils({{ spec.design_name }}_reg_predictor)

  function new(string name, uvm_component parent);
    super.new(name, parent);
  endfunction
endclass
