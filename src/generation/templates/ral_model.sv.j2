// ---------------------------------------------------------------------------
// All-Register Sequence — direct writes/reads to every register
// ---------------------------------------------------------------------------
class {{ spec.design_name }}_all_regs_seq extends uvm_reg_sequence #(uvm_reg_item);
  `uvm_object_utils({{ spec.design_name }}_all_regs_seq)

  {{ spec.design_name }}_reg_block reg_model;

  function new(string name = "{{ spec.design_name }}_all_regs_seq");
    super.new(name);
  endfunction

  task body;
    uvm_status_e st;
    uvm_reg_data_t val;

    `uvm_info("RAL_SEQ", "Starting exhaustive register access sequence", UVM_LOW)

    foreach (reg_model.reg_map.get_regs()[i]) begin
      uvm_reg rg = reg_model.reg_map.get_regs()[i];
      if (rg == null) continue;

      val = $urandom();
      `uvm_info("RAL_SEQ", $sformatf("Writing 0x%0h to %s", val, rg.get_name()), UVM_MEDIUM)
      rg.write(st, val, .parent(this));
      if (st != UVM_IS_OK)
        `uvm_error("RAL_SEQ", $sformatf("%s write failed with status %s", rg.get_name(), st.name()))
    end

    foreach (reg_model.reg_map.get_regs()[i]) begin
      uvm_reg rg = reg_model.reg_map.get_regs()[i];
      if (rg == null) continue;

      rg.read(st, val, .parent(this));
      if (st != UVM_IS_OK)
        `uvm_error("RAL_SEQ", $sformatf("%s read failed with status %s", rg.get_name(), st.name()))
    end

    `uvm_info("RAL_SEQ", "Exhaustive register access sequence completed", UVM_LOW)
  endtask
endclass

// ---------------------------------------------------------------------------
// Frontdoor vs Backdoor Comparison Sequence — validates RAL mirror accuracy
// by writing via frontdoor, then reading via backdoor and comparing.
// ---------------------------------------------------------------------------
class {{ spec.design_name }}_reg_fd_bd_cmp_seq extends uvm_reg_sequence #(uvm_reg_item);
  `uvm_object_utils({{ spec.design_name }}_reg_fd_bd_cmp_seq)

  {{ spec.design_name }}_reg_block reg_model;
  int mismatches;
  int compares;

  function new(string name = "{{ spec.design_name }}_reg_fd_bd_cmp_seq");
    super.new(name);
  endfunction

  task body;
    uvm_status_e st;
    uvm_reg_data_t fd_val, bd_val;
    uvm_reg rg_array[$];
    uvm_reg rg;

    if (reg_model == null) begin
      `uvm_fatal("SEQ", "reg_model not set in fd_bd_cmp_seq")
    end

    rg_array = reg_model.reg_map.get_regs();
    `uvm_info("FD_BD", $sformatf("Frontdoor/backdoor comparison: %0d registers", rg_array.size()), UVM_LOW)

    foreach (rg_array[i]) begin
      rg = rg_array[i];
      if (rg == null) continue;
      if (rg.get_access() inside {"RO", "RC"}) continue;

      fd_val = $urandom();
      rg.write(st, fd_val, .parent(this));
      if (st != UVM_IS_OK) begin
        `uvm_error("FD_BD", $sformatf("%s frontdoor write failed", rg.get_name()))
        continue;
      end
      rg.peek(st, bd_val);
      if (st != UVM_IS_OK) begin
        `uvm_error("FD_BD", $sformatf("%s backdoor peek failed", rg.get_name()))
        continue;
      end
      compares++;
      if (bd_val !== fd_val) begin
        mismatches++;
        `uvm_error("FD_BD", $sformatf("%s mismatch: frontdoor=0x%0h backdoor=0x%0h",
                  rg.get_name(), fd_val, bd_val))
      end else begin
        `uvm_info("FD_BD", $sformatf("%s MATCH: 0x%0h", rg.get_name(), fd_val), UVM_HIGH)
      end
    end
    `uvm_info("FD_BD", $sformatf(
      "Frontdoor/backdoor: %0d compares, %0d mismatches — %s",
      compares, mismatches, (mismatches == 0) ? "PASS" : "FAIL"), UVM_LOW)
  endtask
endclass

// ---------------------------------------------------------------------------
// Register Mirror Sequence — validates RAL mirror vs hardware using
// reg_model.mirror() with UVM_CHECK.
// ---------------------------------------------------------------------------
class {{ spec.design_name }}_reg_mirror_seq extends uvm_reg_sequence #(uvm_reg_item);
  `uvm_object_utils({{ spec.design_name }}_reg_mirror_seq)

  {{ spec.design_name }}_reg_block reg_model;
  int err_count;

  function new(string name = "{{ spec.design_name }}_reg_mirror_seq");
    super.new(name);
  endfunction

  task body;
    uvm_status_e st;
    if (reg_model == null) begin
      `uvm_fatal("SEQ", "reg_model not set in reg_mirror_seq")
    end
    `uvm_info("MIRROR", "Starting register mirror check with UVM_CHECK", UVM_LOW)
    reg_model.reg_map.set_auto_predict(1);
    reg_model.mirror(st, UVM_CHECK, UVM_FRONTDOOR, .parent(this));
    if (st == UVM_IS_OK)
      `uvm_info("MIRROR", "Mirror check PASSED — all registers match hardware", UVM_LOW)
    else begin
      err_count = st;
      `uvm_error("MIRROR", $sformatf("Mirror check FAILED — %0d errors detected", err_count))
    end
  endtask
endclass

// ---------------------------------------------------------------------------
// Register Coverage Closure Sequence — samples every register field with
// edge-case values to close functional coverage gaps.
// ---------------------------------------------------------------------------
class {{ spec.design_name }}_reg_cov_closure_seq extends uvm_reg_sequence #(uvm_reg_item);
  `uvm_object_utils({{ spec.design_name }}_reg_cov_closure_seq)

  {{ spec.design_name }}_reg_block reg_model;
  int bins_hit;
  int total_bins;

  function new(string name = "{{ spec.design_name }}_reg_cov_closure_seq");
    super.new(name);
  endfunction

  task body;
    uvm_status_e st;
    uvm_reg rg;
    uvm_reg rg_array[$];
    logic [{{ data_width-1 }}:0] edge_vals[4];

    if (reg_model == null) begin
      `uvm_fatal("SEQ", "reg_model not set in reg_cov_closure_seq")
    end
    rg_array = reg_model.reg_map.get_regs();
    `uvm_info("COV_CLOSE", $sformatf("Coverage closure: %0d registers", rg_array.size()), UVM_LOW)

    edge_vals[0] = 'h0;
    edge_vals[1] = '1;
    edge_vals[2] = {{ data_width }}'(1);
    edge_vals[3] = {{ data_width }}'('1 << ({{ data_width }} - 1));

    foreach (rg_array[i]) begin
      rg = rg_array[i];
      if (rg == null) continue;
      if (rg.get_access() inside {"RO", "RC"}) continue;
      foreach (edge_vals[j]) begin
        uvm_reg_data_t write_val = edge_vals[j];
        rg.write(st, write_val, .parent(this));
        if (st == UVM_IS_OK) begin
          bins_hit++;
          void'(rg.sample_values());
        end
      end
      total_bins += 4;
    end
    `uvm_info("COV_CLOSE", $sformatf(
      "Coverage closure: hit %0d/%0d bins — %s",
      bins_hit, total_bins,
      (bins_hit >= total_bins) ? "FULL COVERAGE" : "partial"), UVM_LOW)
  endtask
endclass

{% if p == "uart" %}
// ---------------------------------------------------------------------------
// UART Register Alias Sequence — validates THR/RBR ↔ DLL aliasing via DLAB
// ---------------------------------------------------------------------------
class {{ spec.design_name }}_reg_alias_seq extends uvm_reg_sequence #(uvm_reg_item);
  `uvm_object_utils({{ spec.design_name }}_reg_alias_seq)

  {{ spec.design_name }}_reg_block reg_model;
  int alias_mismatches;

  function new(string name = "{{ spec.design_name }}_reg_alias_seq");
    super.new(name);
  endfunction

  task body;
    uvm_status_e st;
    uvm_reg_data_t thr_val, dll_val, rbr_val, dlh_val, readback;

    if (reg_model == null) begin
      `uvm_fatal("SEQ", "reg_model not set in reg_alias_seq")
    end
    `uvm_info("ALIAS", "Starting UART register alias test (DLAB switching)", UVM_LOW)

    thr_val = 8'hA5;
    reg_model.thr.write(st, thr_val, .parent(this));
    if (st != UVM_IS_OK) begin
      `uvm_error("ALIAS", "THR write failed"); alias_mismatches++;
    end

    reg_model.lcr.write(st, 8'h80, .parent(this));
    if (st != UVM_IS_OK) begin
      `uvm_error("ALIAS", "LCR write (DLAB=1) failed"); alias_mismatches++;
    end

    dll_val = 8'h01;
    reg_model.dll.write(st, dll_val, .parent(this));
    if (st != UVM_IS_OK) begin
      `uvm_error("ALIAS", "DLL write failed"); alias_mismatches++;
    end

    dlh_val = 8'h00;
    reg_model.dlh.write(st, dlh_val, .parent(this));
    if (st != UVM_IS_OK) begin
      `uvm_error("ALIAS", "DLH write failed"); alias_mismatches++;
    end

    reg_model.lcr.write(st, 8'h03, .parent(this));
    if (st != UVM_IS_OK) begin
      `uvm_error("ALIAS", "LCR write (DLAB=0) failed"); alias_mismatches++;
    end

    reg_model.rbr.read(st, rbr_val, .parent(this));
    if (st != UVM_IS_OK) begin
      `uvm_error("ALIAS", "RBR read failed"); alias_mismatches++;
    end

    reg_model.lcr.read(st, readback, .parent(this));
    if (st != UVM_IS_OK) begin
      `uvm_error("ALIAS", "LCR read failed"); alias_mismatches++;
    end else if (readback[7] != 1'b0) begin
      `uvm_error("ALIAS", $sformatf("LCR DLAB still set after writing 0x03: readback=0x%0h", readback))
      alias_mismatches++;
    end

    if (alias_mismatches == 0)
      `uvm_info("ALIAS", "Register alias test PASSED — DLAB switching works correctly", UVM_LOW)
    else
      `uvm_error("ALIAS", $sformatf("Register alias test FAILED — %0d mismatches", alias_mismatches))
  endtask
endclass
{% endif %}
