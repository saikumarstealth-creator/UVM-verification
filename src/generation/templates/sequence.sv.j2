// -------------------------------------------------------------------------
// UART Break Sequence — sets break condition, verifies LSR.BI
// -------------------------------------------------------------------------
class {{ spec.design_name }}_break_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_break_seq)

  int break_detected;

  function new(string n = "{{ spec.design_name }}_break_seq");
    super.new(n);
  endfunction

  task body;
    logic [7:0] lcr_val, lsr_val;

    `uvm_info("BREAK_SEQ", "Starting break condition test", UVM_LOW)

    // Read current LCR
    read_reg({{ addr_bits }}'h03, lcr_val);

    // Set break enable (LCR[6] = 1) — hold for multiple frame times
    write_reg({{ addr_bits }}'h03, lcr_val | 8'h40);
    `uvm_info("BREAK_SEQ", "Break condition asserted (LCR[6]=1)", UVM_LOW)
    #200000;

    // Poll LSR for BI (bit 4) with timeout
    begin
      int poll;
      do begin
        read_reg({{ addr_bits }}'h05, lsr_val);
        poll++;
        #10000;
        if (poll > 50) break;
      end while (!lsr_val[4]);
      if (lsr_val[4]) begin
        break_detected++;
        `uvm_info("BREAK_SEQ", $sformatf("Break Interrupt (LSR[4]) detected after %0d polls", poll), UVM_LOW)
      end else begin
        `uvm_warning("BREAK_SEQ", "Break Interrupt NOT detected within timeout")
      end
    end

    // Clear break (LCR[6] = 0)
    write_reg({{ addr_bits }}'h03, lcr_val & ~8'h40);
    `uvm_info("BREAK_SEQ", "Break condition de-asserted", UVM_LOW)
    #100000;

    if (break_detected == 0)
      `uvm_error("BREAK_SEQ", "Break test FAILED — no break detected")
    else
      `uvm_info("BREAK_SEQ", "Break test PASSED", UVM_LOW)

    if (sb_handle != null) sb_handle.record_error("break", break_detected);
  endtask
endclass

// -------------------------------------------------------------------------
// UART Overrun Sequence — TX flood in loopback, verify LSR.OE
// -------------------------------------------------------------------------
class {{ spec.design_name }}_overrun_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_overrun_seq)

  int overrun_detected;
  int tx_count;

  function new(string n = "{{ spec.design_name }}_overrun_seq");
    super.new(n);
  endfunction

  task body;
    logic [7:0] mcr_val, lsr_val;

    `uvm_info("OVR_SEQ", "Starting overrun test — TX flood in loopback", UVM_LOW)

    // Configure UART
    {{ spec.design_name }}_config_seq cfg_seq;
    cfg_seq = {{ spec.design_name }}_config_seq::type_id::create("cfg_seq");
    cfg_seq.reg_model = reg_model;
    cfg_seq.baud_rate = 115200;
    cfg_seq.data_bits = 8;
    cfg_seq.stop_bits = 1;
    cfg_seq.start(m_sequencer);

    // Enable loopback (MCR[4] = 1)
    read_reg({{ addr_bits }}'h04, mcr_val);
    write_reg({{ addr_bits }}'h04, mcr_val | 8'h10);
    `uvm_info("OVR_SEQ", "Loopback enabled (MCR[4]=1)", UVM_LOW)

    // Flood TX without reading RBR to cause overrun (writes are faster than serial TX)
    for (int i = 0; i < 20; i++) begin
      write_reg({{ addr_bits }}'h00, 8'($urandom_range(0, 255)));
      tx_count++;
      #1000;
    end

    // Wait for loopback data to arrive at RX (at 115200: ~87us/byte, 16 bytes ~1.4ms)
    #200000;

    // Poll LSR for overrun (OE = bit 1) with timeout
    begin
      int poll;
      do begin
        read_reg({{ addr_bits }}'h05, lsr_val);
        poll++;
        #10000;
        if (poll > 100) break;
      end while (!lsr_val[1]);
      if (lsr_val[1]) begin
        overrun_detected++;
        `uvm_info("OVR_SEQ", $sformatf("Overrun (LSR[1]) detected after %0d TX, %0d polls", tx_count, poll), UVM_LOW)
      end else begin
        `uvm_warning("OVR_SEQ", "No overrun detected — may need more TX or faster baud")
      end
    end
      `uvm_info("OVR_SEQ", $sformatf("Overrun (LSR[1]) detected after %0d TX", tx_count), UVM_LOW)
    end else begin
      `uvm_warning("OVR_SEQ", "No overrun detected — may need more TX or faster baud")
    end

    // Read RBR to clear overrun condition
    write_reg({{ addr_bits }}'h00, 8'h00);
    read_reg({{ addr_bits }}'h00, lsr_val);

    // Disable loopback
    write_reg({{ addr_bits }}'h04, mcr_val & ~8'h10);

    if (overrun_detected == 0)
      `uvm_warning("OVR_SEQ", "Overrun test: no overrun observed (DUT-dependent)")
    else
      `uvm_info("OVR_SEQ", "Overrun test PASSED", UVM_LOW)

    if (sb_handle != null) sb_handle.record_error("overrun", overrun_detected);
  endtask
endclass

