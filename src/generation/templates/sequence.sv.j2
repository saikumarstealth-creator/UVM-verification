// -------------------------------------------------------------------------
// UART Error Injection Sequence — injects parity, framing, break errors
// Uses driver-level corruption via seq_item corruption flags (not register
// manipulation).  The driver reads corrupt_parity / corrupt_stop_bit /
// force_break during serialisation and corrupts the TX bitstream at the
// pin level.  This is the IEEE 1800.2-correct method.
// -------------------------------------------------------------------------
class uart_error_injection_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils(uart_error_injection_seq)

  typedef enum {
    INJ_PARITY, INJ_FRAMING, INJ_BREAK, INJ_ALL
  } inj_type_t;

  rand inj_type_t inj_type;
  rand int        num_injections;
  int             injected_count;
  int             observed_errors;

  constraint c_inj_count { num_injections inside {[1:16]}; }

  function new(string n = "uart_error_injection_seq");
    super.new(n);
    num_injections = 3;
    injected_count = 0;
    observed_errors = 0;
  endfunction

  task body;
    logic [7:0] lsr_val;

    `uvm_info("UART_INJ", $sformatf("Starting error injection: %s, count=%0d",
              inj_type.name(), num_injections), UVM_LOW)

    if (sb_handle != null) begin
      sb_handle.configure_injection(inj_type.name(), num_injections);
    end

    for (int i = 0; i < num_injections; i++) begin
      {{ spec.design_name }}_seq_item inj_req;
      inj_req = {{ spec.design_name }}_seq_item::type_id::create($sformatf("inj_req_%0d", i));
      start_item(inj_req);

      case (inj_type)
        INJ_PARITY: begin
          if (!inj_req.randomize() with {
            we == 1;
            addr == 3'h0;
            data == 8'hA5;
            delay == 0;
            corrupt_parity == 1;
            corrupt_stop_bit == 0;
            force_break == 0;
          }) `uvm_fatal("RAND", "Parity injection req randomization failed")
        end
        INJ_FRAMING: begin
          if (!inj_req.randomize() with {
            we == 1;
            addr == 3'h0;
            data == 8'h5A;
            delay == 0;
            corrupt_parity == 0;
            corrupt_stop_bit == 1;
            force_break == 0;
          }) `uvm_fatal("RAND", "Framing injection req randomization failed")
        end
        INJ_BREAK: begin
          if (!inj_req.randomize() with {
            we == 1;
            addr == 3'h0;
            data == 8'h00;
            delay == 0;
            corrupt_parity == 0;
            corrupt_stop_bit == 0;
            force_break == 1;
          }) `uvm_fatal("RAND", "Break injection req randomization failed")
        end
        INJ_ALL: begin
          if (i % 3 == 0)
            if (!inj_req.randomize() with {
              we == 1; addr == 3'h0; data == 8'hA5; delay == 0;
              corrupt_parity == 1; corrupt_stop_bit == 0; force_break == 0;
            }) `uvm_fatal("RAND", "All-injection parity req failed")
          if (i % 3 == 1)
            if (!inj_req.randomize() with {
              we == 1; addr == 3'h0; data == 8'h5A; delay == 0;
              corrupt_parity == 0; corrupt_stop_bit == 1; force_break == 0;
            }) `uvm_fatal("RAND", "All-injection framing req failed")
          if (i % 3 == 2)
            if (!inj_req.randomize() with {
              we == 1; addr == 3'h0; data == 8'h00; delay == 0;
              corrupt_parity == 0; corrupt_stop_bit == 0; force_break == 1;
            }) `uvm_fatal("RAND", "All-injection break req failed")
        end
      endcase

      finish_item(inj_req);
      injected_count++;

      #5us;
      read_reg(3'h5, lsr_val);
      case (inj_type)
        INJ_PARITY: begin
          if (lsr_val[2]) begin
            observed_errors++;
            `uvm_info("UART_INJ", $sformatf("Parity error observed LSR[2]: 0x%02h", lsr_val), UVM_MEDIUM)
          end else begin
            `uvm_warning("UART_INJ", "Parity error flag not set in LSR after driver corruption")
          end
        end
        INJ_FRAMING: begin
          if (lsr_val[3]) begin
            observed_errors++;
            `uvm_info("UART_INJ", $sformatf("Framing error observed LSR[3]: 0x%02h", lsr_val), UVM_MEDIUM)
          end else begin
            `uvm_warning("UART_INJ", "Framing error flag not set in LSR after driver corruption")
          end
        end
        INJ_BREAK: begin
          if (lsr_val[4]) begin
            observed_errors++;
            `uvm_info("UART_INJ", $sformatf("Break observed LSR[4]: 0x%02h", lsr_val), UVM_MEDIUM)
          end else begin
            `uvm_warning("UART_INJ", "Break flag not set in LSR after driver corruption")
          end
        end
        INJ_ALL: begin
          if (lsr_val[2] || lsr_val[3] || lsr_val[4])
            observed_errors++;
        end
      endcase
    end

    if (injected_count > 0) begin
      `uvm_info("UART_INJ", $sformatf(
        "\n  === Error Injection Report ==="
        "\n  Type:           %s"
        "\n  Injected:       %0d"
        "\n  Observed in HW: %0d"
        "\n  Detection Rate: %0d/100",
        inj_type.name(), injected_count, observed_errors,
        (injected_count > 0) ? (observed_errors * 100 / injected_count) : 0
      ), UVM_LOW)
    end
  endtask
endclass

// -------------------------------------------------------------------------
// UART Random Traffic Sequence — randomizes baud, parity, word length, data
// -------------------------------------------------------------------------
class uart_random_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils(uart_random_seq)

  rand int rand_baud;
  rand int rand_data_bits;
  rand int rand_stop_bits;
  rand bit rand_parity_en;
  rand bit rand_even_parity;
  rand int num_transactions;
  int tx_count;
  int rx_count;

  constraint c_random_params {
    rand_baud inside {9600, 19200, 38400, 57600, 115200, 1000000};
    rand_data_bits inside {5, 6, 7, 8};
    rand_stop_bits inside {1, 2};
    num_transactions inside {[1:16]};
  }

  function new(string n = "uart_random_seq");
    super.new(n);
  endfunction

  task body;
    uart_config_seq cfg_seq;
    uart_tx_seq     tx_seq;

    `uvm_info("UART_RAND", $sformatf(
      "Randomized config: baud=%0d, data=%0d, stop=%0d, parity(en=%0d,even=%0d), xactions=%0d",
      rand_baud, rand_data_bits, rand_stop_bits, rand_parity_en, rand_even_parity, num_transactions
    ), UVM_LOW)

    cfg_seq = uart_config_seq::type_id::create("cfg_seq");
    cfg_seq.reg_model = reg_model;
    cfg_seq.baud_rate = rand_baud;
    cfg_seq.data_bits = rand_data_bits;
    cfg_seq.stop_bits = rand_stop_bits;
    cfg_seq.parity_en = rand_parity_en;
    cfg_seq.even_parity = rand_even_parity;
    cfg_seq.start(m_sequencer);

    for (int i = 0; i < num_transactions; i++) begin
      tx_seq = uart_tx_seq::type_id::create($sformatf("tx_seq_%0d", i));
      tx_seq.reg_model = reg_model;
      if (!tx_seq.randomize() with { num_bytes == 1; }) begin
        `uvm_error("UART_RAND", "TX seq randomization failed")
      end else begin
        tx_seq.start(m_sequencer);
        tx_count++;
      end
    end

    `uvm_info("UART_RAND", $sformatf(
      "Random traffic complete: %0d TX transactions",
      tx_count
    ), UVM_LOW)
  endtask
endclass

