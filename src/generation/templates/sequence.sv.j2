    `uvm_info("I2C_RD", $sformatf("I2C read: addr=0x%02h, %0d bytes", slave_addr, num_bytes), UVM_LOW)

    write_reg(0, {1'b1, slave_addr});
    write_reg(1, 8'h02);

    for (int i = 0; i < num_bytes; i++) begin
      logic [7:0] val;
      read_reg(3, val);
      read_data.push_back(val);
      if (sb_handle != null) sb_handle.record_rx(3, val);
      #500;
    end

    write_reg(1, 8'h00);
    `uvm_info("I2C_RD", $sformatf("I2C read complete: %0d bytes received", read_data.size()), UVM_MEDIUM)
  endtask
