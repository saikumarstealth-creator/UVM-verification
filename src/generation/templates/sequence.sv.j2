// -------------------------------------------------------------------------
// I2C Master Write Sequence — standard 7-bit address write
// -------------------------------------------------------------------------
class {{ spec.design_name }}_i2c_master_write_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_i2c_master_write_seq)

  rand logic [6:0] slave_addr;
  rand logic [7:0] write_data[$];
  rand bit         use_10bit_addr;

  constraint c_i2c_wr {
    write_data.size() inside {[1:32]};
    slave_addr inside {[8'h00:8'h77]};
  }

  function new(string n = "{{ spec.design_name }}_i2c_master_write_seq");
    super.new(n);
  endfunction

  task body;
    `uvm_info("I2C_WR", $sformatf("I2C write: addr=0x%02h, %0d bytes", slave_addr, write_data.size()), UVM_LOW)

    write_reg(0, {1'b0, slave_addr});
    write_reg(1, 8'h01);

    foreach (write_data[i]) begin
      write_reg(2, write_data[i]);
      #500;
      if (sb_handle != null) sb_handle.record_tx(2, write_data[i]);
    end

    write_reg(1, 8'h00);
    `uvm_info("I2C_WR", "I2C write complete", UVM_MEDIUM)
  endtask
endclass

// -------------------------------------------------------------------------
// I2C Master Read Sequence
// -------------------------------------------------------------------------
class {{ spec.design_name }}_i2c_master_read_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_i2c_master_read_seq)

  rand logic [6:0] slave_addr;
  rand int         num_bytes;
  logic [7:0]      read_data[$];

  constraint c_i2c_rd {
    num_bytes inside {[1:16]};
  }

  function new(string n = "{{ spec.design_name }}_i2c_master_read_seq");
    super.new(n);
  endfunction

  task body;
    `uvm_info("I2C_RD", $sformatf("I2C read: addr=0x%02h, %0d bytes", slave_addr, num_bytes), UVM_LOW)

    write_reg(0, {1'b1, slave_addr});
    write_reg(1, 8'h02);

    for (int i = 0; i < num_bytes; i++) begin
      logic [7:0] val;
      read_reg(3, val);
      read_data.push_back(val);
      if (sb_handle != null) sb_handle.record_rx(3, val);
      #500;
    end

    write_reg(1, 8'h00);
    `uvm_info("I2C_RD", $sformatf("I2C read complete: %0d bytes received", read_data.size()), UVM_MEDIUM)
  endtask
endclass

// -------------------------------------------------------------------------
// I2C Repeated Start Sequence — write-then-read with repeated start
// -------------------------------------------------------------------------
class {{ spec.design_name }}_i2c_repeated_start_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_i2c_repeated_start_seq)

  rand logic [6:0] slave_addr;
  rand logic [7:0] write_data;
  logic [7:0]      read_data;
  bit              repeated_start_detected;

  function new(string n = "{{ spec.design_name }}_i2c_repeated_start_seq");
    super.new(n);
  endfunction

  task body;
    `uvm_info("I2C_RSTART", $sformatf("Repeated start: write 0x%02h then read from 0x%02h",
              write_data, slave_addr), UVM_LOW)

    write_reg(0, {1'b0, slave_addr});
    write_reg(1, 8'h05);

    write_reg(2, write_data);
    #200;

    write_reg(0, {1'b1, slave_addr});
    write_reg(1, 8'h06);

    #500;
    read_reg(3, read_data);
    #200;

    write_reg(1, 8'h00);

    if (sb_handle != null) sb_handle.record_tx(0, write_data);
    `uvm_info("I2C_RSTART", $sformatf("Repeated start complete: wrote 0x%02h, read 0x%02h",
              write_data, read_data), UVM_MEDIUM)
  endtask
endclass

