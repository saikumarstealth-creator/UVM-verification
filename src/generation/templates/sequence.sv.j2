// -------------------------------------------------------------------------
// AXI Write Burst Sequence — burst of write transactions
// -------------------------------------------------------------------------
class {{ spec.design_name }}_axi_write_burst_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_axi_write_burst_seq)

  rand int burst_len;
  rand logic [7:0] burst_data[$];

  constraint c_axi_wr_burst {
    burst_len inside {[1:16]};
    burst_data.size() == burst_len;
  }

  function new(string n = "{{ spec.design_name }}_axi_write_burst_seq");
    super.new(n);
  endfunction

  task body;
    `uvm_info("AXI_WR", $sformatf("Write burst: %0d transactions", burst_len), UVM_LOW)

    for (int i = 0; i < burst_len; i++) begin
      {{ spec.design_name }}_seq_item wr_req;
      wr_req = {{ spec.design_name }}_seq_item::type_id::create($sformatf("axi_wr_%0d", i));
      start_item(wr_req);
      if (!wr_req.randomize() with {
        we == 1; addr == i; data == local::burst_data[i]; delay == 0;
      }) `uvm_fatal("RAND", "AXI write req randomization failed")
      finish_item(wr_req);
      if (sb_handle != null) sb_handle.record_tx(i, burst_data[i]);
      #100;
    end

    `uvm_info("AXI_WR", $sformatf("Write burst complete: %0d writes", burst_len), UVM_MEDIUM)
  endtask
endclass

// -------------------------------------------------------------------------
// AXI Read Burst Sequence — burst of read transactions
// -------------------------------------------------------------------------
class {{ spec.design_name }}_axi_read_burst_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_axi_read_burst_seq)

  rand int burst_len;
  logic [7:0] read_results[$];
  int mismatches;

  constraint c_axi_rd_burst { burst_len inside {[1:16]}; }

  function new(string n = "{{ spec.design_name }}_axi_read_burst_seq");
    super.new(n);
  endfunction

  task body;
    `uvm_info("AXI_RD", $sformatf("Read burst: %0d transactions", burst_len), UVM_LOW)

    for (int i = 0; i < burst_len; i++) begin
      logic [7:0] rd_data;
      {{ spec.design_name }}_seq_item rd_req;
      rd_req = {{ spec.design_name }}_seq_item::type_id::create($sformatf("axi_rd_%0d", i));
      start_item(rd_req);
      if (!rd_req.randomize() with {
        we == 0; addr == i; delay == 0;
      }) `uvm_fatal("RAND", "AXI read req randomization failed")
      finish_item(rd_req);
      get_response(rsp);
      rd_data = rsp.data;
      read_results.push_back(rd_data);
      if (sb_handle != null) sb_handle.record_rx(i, rd_data);
      #100;
    end

    `uvm_info("AXI_RD", $sformatf("Read burst complete: %0d reads, %0d mismatches",
              burst_len, mismatches), UVM_MEDIUM)
  endtask
endclass

// -------------------------------------------------------------------------
// AXI Write-Read Compare Sequence — write then read back and compare
// -------------------------------------------------------------------------
class {{ spec.design_name }}_axi_write_read_cmp_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_axi_write_read_cmp_seq)

  rand logic [2:0] target_addr;
  rand logic [7:0] write_val;
  int matches;
  int mismatches;

  function new(string n = "{{ spec.design_name }}_axi_write_read_cmp_seq");
    super.new(n);
  endfunction

  task body;
    logic [7:0] read_val;

    write_reg(target_addr, write_val);
    #50;
    read_reg(target_addr, read_val);

    if (read_val === write_val) begin
      matches++;
      `uvm_info("AXI_CMP", $sformatf("Match: addr=0x%0h data=0x%02h", target_addr, write_val), UVM_MEDIUM)
    end else begin
      mismatches++;
      `uvm_error("AXI_CMP", $sformatf("Mismatch: addr=0x%0h wrote=0x%02h read=0x%02h",
                 target_addr, write_val, read_val))
    end
  endtask
endclass

// -------------------------------------------------------------------------
// AXI Outstanding Transaction Sequence — multiple outstanding transactions
// -------------------------------------------------------------------------
class {{ spec.design_name }}_axi_outstanding_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_axi_outstanding_seq)

  rand int outstanding_count;
  int completed;

  constraint c_outstanding { outstanding_count inside {[2:8]}; }

  function new(string n = "{{ spec.design_name }}_axi_outstanding_seq");
    super.new(n);
  endfunction

  task body;
    {{ spec.design_name }}_seq_item outstanding_reqs[$];

    `uvm_info("AXI_OUT", $sformatf("Outstanding transactions: %0d", outstanding_count), UVM_LOW)

    for (int i = 0; i < outstanding_count; i++) begin
      {{ spec.design_name }}_seq_item req;
      req = {{ spec.design_name }}_seq_item::type_id::create($sformatf("out_req_%0d", i));
      start_item(req);
      if (!req.randomize() with {
        we == 1; addr == i; data == 8'($urandom_range(0, 255)); delay == 0;
      }) `uvm_fatal("RAND", "Outstanding req randomization failed")
      finish_item(req);
      outstanding_reqs.push_back(req);
    end

    foreach (outstanding_reqs[i]) begin
      get_response(rsp);
      completed++;
    end

    `uvm_info("AXI_OUT", $sformatf("Outstanding test: %0d/%0d completed", completed, outstanding_count), UVM_LOW)
  endtask
endclass

// -------------------------------------------------------------------------
// AXI Illegal Address Sequence — tests address decode error handling
// -------------------------------------------------------------------------
class {{ spec.design_name }}_axi_illegal_addr_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_axi_illegal_addr_seq)

  int illegal_ops;
  logic [{{ addr_bits-1 }}:0] illegal_addrs[$];
  logic [{{ addr_bits-1 }}:0] used_addrs[$] = '{
{% for a in addr_ints %}      {{ addr_bits }}'h{{ '%0x' % a }}{{ ',' if not loop.last }}
{% endfor %}    };

  function new(string n = "{{ spec.design_name }}_axi_illegal_addr_seq");
    super.new(n);
  endfunction

  task body;
    logic [7:0] val;

    `uvm_info("AXI_ILL", "Starting illegal address test", UVM_LOW)

    // Dynamically compute illegal addresses (outside valid register range)
    for (int a = 0; a < (1 << {{ addr_bits }}); a++) begin
      if (!(a inside {used_addrs}))
        illegal_addrs.push_back({{ addr_bits }}'(a));
    end
    // Also try out-of-range addresses if addr_bits < 8
    if ({{ addr_bits }} < 8) begin
      illegal_addrs.push_back({{ addr_bits }}'(1 << {{ addr_bits }}));
      illegal_addrs.push_back({{ addr_bits }}'((1 << {{ addr_bits }}) + 1));
    end

    foreach (illegal_addrs[i]) begin
      write_reg(illegal_addrs[i], 8'hA5);
      illegal_ops++;
      #50;
      read_reg(illegal_addrs[i], val);
      `uvm_info("AXI_ILL", $sformatf("Addr 0x%0h: readback=0x%02h", illegal_addrs[i], val), UVM_MEDIUM)
    end

    `uvm_info("AXI_ILL", $sformatf("Illegal access: %0d operations", illegal_ops), UVM_LOW)
  endtask
endclass

