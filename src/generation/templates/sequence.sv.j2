  task body;
    logic [7:0] readback;

    `uvm_info("APB_WS", $sformatf("Wait state test: idle_delay=%0d", idle_delay), UVM_LOW)
{% for reg in sorted_regs %}
{% if reg.access != "ro" %}
    write_reg({{ addr_bits }}'h{{ reg.address|replace('0x', '')|replace('h', '') }}, $urandom_range(0, 255));
    repeat (idle_delay) @(posedge vif.clk);
{% endif %}
    read_reg({{ addr_bits }}'h{{ reg.address|replace('0x', '')|replace('h', '') }}, readback);
    repeat (idle_delay) @(posedge vif.clk);
{% endfor %}

    `uvm_info("APB_WS", "Wait state test completed", UVM_LOW)
  endtask
endclass
{% endif %}

{% if _has_pslverr %}
// -------------------------------------------------------------------------
// APB PSLVERR Sequence — exhaustive slave error response testing
// -------------------------------------------------------------------------
class {{ spec.design_name }}_apb_pslverr_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_apb_pslverr_seq)

  rand int num_injections;
  int errors_seen;
  int recoveries;

  constraint c_pslverr { num_injections inside {[1:10]}; }

  function new(string n = "{{ spec.design_name }}_apb_pslverr_seq");
    super.new(n);
  endfunction

  task body;
    logic [7:0] val;
    int num_pending;

    `uvm_info("APB_ERR", $sformatf("PSLVERR injection: %0d transactions", num_injections), UVM_LOW)

    for (int i = 0; i < num_injections; i++) begin
      {{ spec.design_name }}_seq_item err_req;
      err_req = {{ spec.design_name }}_seq_item::type_id::create($sformatf("pslverr_%0d", i));
      start_item(err_req);
      if (!err_req.randomize() with {
        we == 1; addr inside {[{{ max_addr_val + 1 }}:(1 << {{ addr_bits }}) - 1]}; data == 8'($urandom_range(0, 255)); delay == 0;
      }) `uvm_fatal("RAND", "PSLVERR req randomization failed")
      finish_item(err_req);

      read_reg({{ max_addr_val }}, val);
      if (val !== 8'hA5) begin
        errors_seen++;
        `uvm_info("APB_ERR", $sformatf("SLVERR on transaction %0d", i), UVM_MEDIUM)
      end
      #100;
    end

{% for reg in sorted_regs if reg.access == "rw" %}
    // Recovery check via {{ reg.name }} (rw register)
    write_reg({{ addr_bits }}'h{{ reg.address|replace('0x', '')|replace('h', '') }}, 8'hA5);
    read_reg({{ addr_bits }}'h{{ reg.address|replace('0x', '')|replace('h', '') }}, val);
    if (val == 8'hA5) begin
      recoveries++;
      `uvm_info("APB_ERR", $sformatf("Slave recovered (%0d)", recoveries), UVM_LOW)
    end else begin
      `uvm_error("APB_ERR", $sformatf("Slave did not recover via %s", "{{ reg.name }}"))
    end
{% else %}
    `uvm_warning("APB_ERR", "No rw registers available for recovery check")
{% endfor %}

    `uvm_info("APB_ERR", $sformatf(
      "PSLVERR report: %0d injections, %0d errors seen, recovered=%0s",
      num_injections, errors_seen, recoveries ? "YES" : "NO"), UVM_LOW)
  endtask
endclass
{% endif %}

// -------------------------------------------------------------------------
// APB Illegal Access Sequence — out-of-bounds addresses, invalid transfers
// -------------------------------------------------------------------------
class {{ spec.design_name }}_apb_illegal_access_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_apb_illegal_access_seq)

  int illegal_ops;
  int error_responses;

  function new(string n = "{{ spec.design_name }}_apb_illegal_access_seq");
    super.new(n);
  endfunction

  task body;
    logic [7:0] val;
    logic [{{ addr_bits-1 }}:0] illegal_addrs[$];
    logic [{{ addr_bits-1 }}:0] used_addrs[$] = '{
{% for a in addr_ints %}      {{ addr_bits }}'h{{ '%0x' % a }}{{ ',' if not loop.last }}
{% endfor %}    };

    `uvm_info("APB_ILL", "Starting illegal access test", UVM_LOW)

    for (int a = 0; a < (1 << {{ addr_bits }}); a++) begin
      if (!(a inside {used_addrs}))
        illegal_addrs.push_back(a);
    end

    foreach (illegal_addrs[i]) begin
      write_reg(illegal_addrs[i], 8'hA5);
      illegal_ops++;
      #10;
      read_reg(illegal_addrs[i], val);
      `uvm_info("APB_ILL", $sformatf("Illegal addr 0x%0h: readback=0x%02h", illegal_addrs[i], val), UVM_MEDIUM)
    end

    `uvm_info("APB_ILL", $sformatf("Illegal access test: %0d operations attempted", illegal_ops), UVM_LOW)
  endtask
endclass

