{% if p == "axi4lite" %}
class {{ spec.design_name }}_axi_burst_seq extends uvm_sequence #({{ spec.design_name }}_seq_item);
  `uvm_object_utils({{ spec.design_name }}_axi_burst_seq)

  rand int burst_len;
  constraint c_burst { burst_len inside {[1:4]}; }

  function new(string n = "{{ spec.design_name }}_axi_burst_seq");
    super.new(n);
  endfunction

  task body;
    for (int i = 0; i < burst_len; i++) begin
      req = {{ spec.design_name }}_seq_item::type_id::create("req");
      start_item(req);
      if (!req.randomize() with { addr == i; we == 1; })
        `uvm_fatal("RAND", "AXI write req randomization failed")
      finish_item(req);
      start_item(req);
      if (!req.randomize() with { addr == i; we == 0; })
        `uvm_fatal("RAND", "AXI read req randomization failed")
      finish_item(req);
    end
  endtask
endclass
{% endif %}
