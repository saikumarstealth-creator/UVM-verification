// -------------------------------------------------------------------------
// UART Reset Test — verifies all regs match expected reset values
// -------------------------------------------------------------------------
class {{ spec.design_name }}_reset_test_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_reset_test_seq)

  int num_mismatches;

  function new(string n = "{{ spec.design_name }}_reset_test_seq");
    super.new(n);
  endfunction

  task body;
    uvm_status_e status;
    uvm_reg_data_t val;
    uvm_reg rglist[$];

    if (reg_model == null) begin
      `uvm_fatal("{{ spec.design_name|upper }}_RST", "reg_model not set in reset_test_seq")
    end

    `uvm_info("{{ spec.design_name|upper }}_RST", "Starting register reset value verification", UVM_LOW)

    // 1. Apply hardware reset stimulus
    `uvm_info("{{ spec.design_name|upper }}_RST", "Applying hardware reset", UVM_MEDIUM)
    vif.rst_n <= 1'b0;
    repeat (10) @(posedge vif.clk);
    vif.rst_n <= 1'b1;
    repeat (5) @(posedge vif.clk);

    // Use get_registers() for spec-driven dynamic iteration — no hardcoded names
    reg_model.get_registers(rglist);

    foreach (rglist[i]) begin
      uvm_reg rg = rglist[i];
      if (rg == null) continue;
      rg.read(status, val, .parent(this));
      `uvm_info("{{ spec.design_name|upper }}_RST", $sformatf("Reg %s = 0x%0h (reset: 0x%0h)",
                rg.get_name(), val, rg.get_reset()), UVM_MEDIUM)
      if (val !== rg.get_reset()) begin
        num_mismatches++;
        `uvm_error("{{ spec.design_name|upper }}_RST", $sformatf("Reg %s mismatch: got 0x%0h, expected 0x%0h",
                  rg.get_name(), val, rg.get_reset()))
      end
    end

    if (num_mismatches == 0) begin
      `uvm_info("{{ spec.design_name|upper }}_RST", "All register reset values match", UVM_LOW)
    end else begin
      `uvm_error("{{ spec.design_name|upper }}_RST", $sformatf("%0d register(s) have unexpected reset values", num_mismatches))
    end
  endtask
endclass

// -------------------------------------------------------------------------
// UART Coverage Exploration Sequence — sweeps all config combinations
// Requires: LCR (0x03) for config_seq, THR+LSR (0x00+0x05) for tx_seq
// -------------------------------------------------------------------------
{% if _need_lcr and _need_tx %}
class {{ spec.design_name }}_coverage_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_coverage_seq)

  int baud_list[$] = {9600, 19200, 38400, 57600, 115200, 230400, 1000000};
  int data_bits_list[$] = {5, 6, 7, 8};
  int stop_bits_list[$] = {1, 2};
  int parity_modes[3][2] = '{'{0,0}, '{1,1}, '{1,0}};

  int total_combos;
  int covered_combos;
  int cov_write;
  int cov_read;
  int cov_addr;
  int cov_data;
  int cov_baud;
  int cov_parity;
  int cov_wordlen;

  function new(string n = "{{ spec.design_name }}_coverage_seq");
    super.new(n);
    total_combos = baud_list.size() * data_bits_list.size() * stop_bits_list.size() * 3;
    covered_combos = 0;
  endfunction

  task body;
    `uvm_info("{{ spec.design_name|upper }}_COV", $sformatf("Starting coverage exploration: %0d combinations", total_combos), UVM_LOW)

    foreach (baud_list[b]) begin
      foreach (data_bits_list[d]) begin
        foreach (stop_bits_list[s]) begin
          logic [7:0] pattern;

          exercise_config(baud_list[b], data_bits_list[d], stop_bits_list[s], 0, 0);
          exercise_config(baud_list[b], data_bits_list[d], stop_bits_list[s], 1, 0);
          exercise_config(baud_list[b], data_bits_list[d], stop_bits_list[s], 1, 1);

          pattern = (d == 0) ? 8'h55 : (d == 1) ? 8'hAA : (d == 2) ? 8'hCC : 8'h33;
          {{ spec.design_name }}_tx_seq tx_seq;
          tx_seq = {{ spec.design_name }}_tx_seq::type_id::create($sformatf("tx_seq_%0d_%0d_%0d", b, d, s));
          tx_seq.tx_data = {pattern, ~pattern, 8'h00, 8'hFF};
          tx_seq.num_bytes = 4;
          tx_seq.start(m_sequencer);
          #50us;
        end
      end
    end

    if (sb_handle != null) begin
      sb_handle.extract_coverage(cov_write, cov_read, cov_addr, cov_data,
                                  cov_baud, cov_parity, cov_wordlen);
      `uvm_info("{{ spec.design_name|upper }}_COV", $sformatf(
        "\n  === Coverage Report ==="
        "\n  Bus Writes:       %0d"
        "\n  Bus Reads:        %0d"
        "\n  Addr Bins Hit:    %0d/8"
        "\n  Data Patterns:    %0d/3 (alt+walk+edge)"
        "\n  Baud Rates:       %0d/%0d"
        "\n  Parity Modes:     %0d/5"
        "\n  Word Lengths:     %0d/4",
        cov_write, cov_read, cov_addr, cov_data,
        cov_baud, baud_list.size(),
        cov_parity, cov_wordlen
      ), UVM_LOW)
    end else begin
      `uvm_warning("{{ spec.design_name|upper }}_COV", "sb_handle null — extract_coverage() not supported, scoreboard coverage data unavailable")
    end
  endtask

  protected task exercise_config(int baud, int dbits, int sbits, bit pen, bit eps);
    {{ spec.design_name }}_config_seq cfg_seq;
    cfg_seq = {{ spec.design_name }}_config_seq::type_id::create($sformatf("cfg_seq_%0d", covered_combos));
    cfg_seq.baud_rate = baud;
    cfg_seq.data_bits = dbits;
    cfg_seq.stop_bits = sbits;
    cfg_seq.parity_en = pen;
    cfg_seq.even_parity = eps;
    cfg_seq.start(m_sequencer);
    `uvm_info("{{ spec.design_name|upper }}_COV", $sformatf("Config: baud=%0d data=%0d stop=%0d parity(en=%0d,even=%0d)",
              baud, dbits, sbits, pen, eps), UVM_HIGH)
    covered_combos++;
  endtask
endclass
{% endif %}  {# /LCR+THR+LSR check for {{ spec.design_name }}_coverage_seq #}

{% set _need_vseq = _need_lcr and _need_tx %}
{% set _need_vseq = _need_vseq and ('0x04' in _reg_addr_set or '0x4' in _reg_addr_set) %}
{% set _need_vseq = _need_vseq and ('0x01' in _reg_addr_set or '0x1' in _reg_addr_set) %}
