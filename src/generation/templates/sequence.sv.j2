// Enhanced UVM Sequences for {{ spec.design_name }} ({{ spec.protocol|default("wishbone", true) }})
// Includes: RAL-based sequences, register access, protocol-specific tests
{% set p = spec.protocol|default("wishbone") %}
{% set regs = spec.registers if spec.registers else [] %}
{% set num_regs = regs|length %}
{% if num_regs == 0 %}{% set num_regs = 8 %}{% endif %}
{% set addr_ints = regs|map(attribute='address')|map('replace', '0x', '')|map('replace', 'h', '')|map('int', 16)|list %}
{% set max_addr_val = addr_ints|max if addr_ints else 0 %}
{% set addr_bits = [max_addr_val.bit_length(), 3]|max %}
{% set sizes = regs|map(attribute='size')|select('number')|list %}
{% set data_width = sizes|max if sizes else 8 %}
{% set ro_regs = regs|selectattr('access', 'equalto', 'ro')|map(attribute='name')|map('lower')|list %}
{% set wo_regs = regs|selectattr('access', 'equalto', 'wo')|map(attribute='name')|map('lower')|list %}
{% set reg_names = regs|map(attribute='name')|map('lower')|list %}
{% set sorted_regs = regs|sort(attribute='address') %}
{% set reg_addresses = addr_ints|sort %}

// ---------------------------------------------------------------------------
// Base Sequence — all sequences inherit from here
// ---------------------------------------------------------------------------
class {{ spec.design_name }}_base_seq extends uvm_sequence #({{ spec.design_name }}_seq_item);
  `uvm_object_utils({{ spec.design_name }}_base_seq)

  {{ spec.design_name }}_reg_block       reg_model;
  {{ spec.design_name }}_scoreboard      sb_handle;
  {{ spec.design_name }}_seq_item        req;
  {{ spec.design_name }}_seq_item        rsp;

  function new(string n = "{{ spec.design_name }}_base_seq");
    super.new(n);
  endfunction

  virtual task pre_body();
    if (!uvm_config_db #({{ spec.design_name }}_scoreboard)::get(null, "uvm_test_top.env", "sb", sb_handle))
      `uvm_warning("CFG", $sformatf("Scoreboard handle not found for %s", get_type_name()))
  endtask

  task body;
    `uvm_info("SEQ", "Starting base sequence", UVM_MEDIUM)
  endtask

  // ---------------------------------------------------------------
  // Helper: Write to a register by address
  // ---------------------------------------------------------------
  protected task write_reg(logic [2:0] addr, logic [7:0] data);
    if (reg_model) begin
      uvm_status_e st;
{% if p == "uart" %}
      if (addr inside {3'h0, 3'h1}) begin
        logic [7:0] lcr_val;
        reg_model.lcr.read(st, lcr_val, .parent(this));
        if (addr == 3'h0) begin
          if (lcr_val[7]) {% if 'dll' in reg_names %}reg_model.dll.write(st, data, .parent(this));{% endif %}
          else            {% if 'thr' in reg_names %}reg_model.thr.write(st, data, .parent(this));{% endif %}
        end else begin
          if (lcr_val[7]) {% if 'dlh' in reg_names %}reg_model.dlh.write(st, data, .parent(this));{% endif %}
          else            {% if 'ier' in reg_names %}reg_model.ier.write(st, data, .parent(this));{% endif %}
        end
        if (sb_handle != null) sb_handle.record_tx(addr, data);
        return;
      end
{% endif %}
      case (addr)
{% set seen = [] %}
{% for reg in sorted_regs if reg.name|lower not in ro_regs %}
  {% set a = reg.address.replace('0x', '').replace('h', '') %}
  {% if a not in seen %}
    {% set _ = seen.append(a) %}
        {{ addr_bits }}'h{{ a }}: reg_model.{{ reg.name|lower }}.write(st, data, .parent(this));
  {% endif %}
{% endfor %}
        default: `uvm_error("REG", $sformatf("Write to invalid address 0x%0h", addr))
      endcase
    end else begin
      {{ spec.design_name }}_seq_item req_h;
      req_h = {{ spec.design_name }}_seq_item::type_id::create("req_h");
      start_item(req_h);
      if (!req_h.randomize() with { we == 1; addr == local::addr; data == local::data; delay == 0; })
        `uvm_fatal("RAND", "write_reg req_h randomization failed")
      finish_item(req_h);
      get_response(rsp);
    end
    if (sb_handle != null) sb_handle.record_tx(addr, data);
  endtask

  // ---------------------------------------------------------------
  // Helper: Read from a register by address
  // ---------------------------------------------------------------
  protected task read_reg(logic [2:0] addr, output logic [7:0] data);
    if (reg_model) begin
      uvm_status_e st;
{% if p == "uart" %}
      if (addr inside {3'h0, 3'h1}) begin
        logic [7:0] lcr_val;
        reg_model.lcr.read(st, lcr_val, .parent(this));
        if (addr == 3'h0) begin
          if (lcr_val[7]) {% if 'dll' in reg_names %}reg_model.dll.read(st, data, .parent(this));{% endif %}
          else            {% if 'rbr' in reg_names %}reg_model.rbr.read(st, data, .parent(this));{% endif %}
        end else begin
          if (lcr_val[7]) {% if 'dlh' in reg_names %}reg_model.dlh.read(st, data, .parent(this));{% endif %}
          else            {% if 'ier' in reg_names %}reg_model.ier.read(st, data, .parent(this));{% endif %}
        end
        if (sb_handle != null) sb_handle.record_rx(addr, data);
        return;
      end
{% endif %}
      case (addr)
{% set seen = [] %}
{% for reg in sorted_regs %}
  {% set a = reg.address.replace('0x', '').replace('h', '') %}
  {% if a not in seen %}
    {% set _ = seen.append(a) %}
        {{ addr_bits }}'h{{ a }}: reg_model.{{ reg.name|lower }}.read(st, data, .parent(this));
  {% endif %}
{% endfor %}
        default: `uvm_error("REG", $sformatf("Read from invalid address 0x%0h", addr))
      endcase
    end else begin
      {{ spec.design_name }}_seq_item req_h;
      req_h = {{ spec.design_name }}_seq_item::type_id::create("req_h");
      start_item(req_h);
      if (!req_h.randomize() with { we == 0; addr == local::addr; delay == 0; })
        `uvm_fatal("RAND", "read_reg req_h randomization failed")
      finish_item(req_h);
      get_response(rsp);
      data = rsp.data;
    end
    if (sb_handle != null) sb_handle.record_rx(addr, data);
  endtask

  // ---------------------------------------------------------------
  // Helper: Report error to scoreboard
  // ---------------------------------------------------------------
  protected task record_error(string err_type, string msg);
    if (sb_handle != null) sb_handle.record_error(err_type, msg);
    `uvm_error("SEQ_ERR", $sformatf("[%s] %s", err_type, msg))
  endtask
endclass

// ---------------------------------------------------------------------------
// Write Register Sequence
// ---------------------------------------------------------------------------
class {{ spec.design_name }}_write_reg_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_write_reg_seq)

  rand logic [{{ addr_bits-1 }}:0] reg_addr;
  rand logic [{{ data_width-1 }}:0] write_data;

  constraint c_reg_addr { reg_addr inside { {% for r in sorted_regs if r.name|lower not in ro_regs %}{{ addr_bits }}'h{{ r.address[2:] }}{% if not loop.last %}, {% endif %}{% endfor %} }; }

  function new(string n = "{{ spec.design_name }}_write_reg_seq");
    super.new(n);
  endfunction

  task body;
    write_reg(reg_addr, write_data);
    `uvm_info("SEQ", $sformatf("Write reg[0x%0h] = 0x%0h", reg_addr, write_data), UVM_MEDIUM)
  endtask
endclass

// ---------------------------------------------------------------------------
// Read Register Sequence
// ---------------------------------------------------------------------------
class {{ spec.design_name }}_read_reg_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_read_reg_seq)

  rand logic [{{ addr_bits-1 }}:0] reg_addr;
  logic [{{ data_width-1 }}:0] read_data;

  constraint c_reg_addr { reg_addr inside { {% for r in sorted_regs %}{{ addr_bits }}'h{{ r.address[2:] }}{% if not loop.last %}, {% endif %}{% endfor %} }; }

  function new(string n = "{{ spec.design_name }}_read_reg_seq");
    super.new(n);
  endfunction

  task body;
    read_reg(reg_addr, read_data);
    `uvm_info("SEQ", $sformatf("Read reg[0x%0h] => 0x%0h", reg_addr, read_data), UVM_MEDIUM)
  endtask
endclass

// ---------------------------------------------------------------------------
// All Registers Sequence
// ---------------------------------------------------------------------------
class {{ spec.design_name }}_all_regs_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_all_regs_seq)

  function new(string n = "{{ spec.design_name }}_all_regs_seq");
    super.new(n);
  endfunction

  task body;
    logic [{{ addr_bits-1 }}:0] addrs[$];
    {% for r in sorted_regs if r.name|lower not in ro_regs %}
    addrs.push_back({{ addr_bits }}'h{{ r.address[2:] }});
    {% endfor %}
    foreach (addrs[i]) begin
      {{ spec.design_name }}_write_reg_seq wseq;
      {{ spec.design_name }}_read_reg_seq  rseq;
      wseq = {{ spec.design_name }}_write_reg_seq::type_id::create($sformatf("wseq_%0d", i));
      rseq = {{ spec.design_name }}_read_reg_seq::type_id::create($sformatf("rseq_%0d", i));
      if (!wseq.randomize() with { reg_addr == addrs[i]; write_data == (addrs[i]*16+5); })
        `uvm_fatal("RAND", "write_reg_seq randomization failed")
      wseq.start(m_sequencer);
      rseq = {{ spec.design_name }}_read_reg_seq::type_id::create($sformatf("rseq_rd_%0d", i));
      if (!rseq.randomize() with { reg_addr == addrs[i]; })
        `uvm_fatal("RAND", "read_reg_seq randomization failed")
      rseq.start(m_sequencer);
    end
  endtask
endclass

// ---------------------------------------------------------------------------
// Random Registers Sequence
// ---------------------------------------------------------------------------
class {{ spec.design_name }}_random_regs_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_random_regs_seq)

  rand logic [{{ data_width-1 }}:0] write_data[{{ num_regs }}];
  rand bit         pattern_type;

  constraint c_patterns {
    if (pattern_type == 0) {
      foreach (write_data[i]) write_data[i] == (i * 32 + 5);
    } else {
      foreach (write_data[i]) write_data[i] inside {
        8'h00, 8'h01, 8'h02, 8'h04, 8'h08, 8'h10, 8'h20, 8'h40, 8'h80, 8'hFF,
        8'hAA, 8'h55, 8'hCC, 8'h33, 8'hFE, 8'hFD, 8'hFB, 8'hF7, 8'hEF, 8'hDF,
        8'hBF, 8'h7F, 8'h11, 8'h22, 8'h44, 8'h88, 8'h66, 8'h99, 8'hBB, 8'hDD
      };
    }
  }

  function new(string n = "{{ spec.design_name }}_random_regs_seq");
    super.new(n);
    pattern_type = 1;
  endfunction

  task body;
    logic [{{ addr_bits-1 }}:0] addrs[$];
    {% for r in sorted_regs if r.name|lower not in ro_regs %}
    addrs.push_back({{ addr_bits }}'h{{ r.address[2:] }});
    {% endfor %}
    foreach (addrs[i]) begin
      {{ spec.design_name }}_write_reg_seq wseq;
      {{ spec.design_name }}_read_reg_seq  rseq;
      wseq = {{ spec.design_name }}_write_reg_seq::type_id::create($sformatf("wseq_%0d", i));
      if (!wseq.randomize() with { reg_addr == addrs[i]; write_data == local::write_data[i]; })
        `uvm_fatal("RAND", "write_reg_seq randomization failed")
      `uvm_info("SEQ_RAND", $sformatf("Randomized write[%0d]: addr=0x%0h data=0x%02h",
                i, addrs[i], write_data[i]), UVM_HIGH)
      wseq.start(m_sequencer);
      rseq = {{ spec.design_name }}_read_reg_seq::type_id::create($sformatf("rseq_%0d", i));
      if (!rseq.randomize() with { reg_addr == addrs[i]; })
        `uvm_fatal("RAND", "read_reg_seq randomization failed")
      rseq.start(m_sequencer);
    end
  endtask
endclass

{% if p == "uart" %}

// =========================================================================
//  UART-Specific Sequences
// =========================================================================

// -------------------------------------------------------------------------
// UART Configuration Sequence — sets baud, word length, stop bits, parity
// -------------------------------------------------------------------------
class uart_config_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils(uart_config_seq)

  rand int baud_rate;
  rand int data_bits;
  rand int stop_bits;
  rand bit parity_en;
  rand bit even_parity;
  rand bit ascii_mode;

  constraint c_valid {
    baud_rate inside {9600, 19200, 38400, 57600, 115200, 1000000};
    data_bits inside {5, 6, 7, 8};
    stop_bits inside {1, 2};
  }

  function new(string n = "uart_config_seq");
    super.new(n);
    baud_rate = 115200;
    data_bits = 8;
    stop_bits = 1;
    parity_en = 0;
    even_parity = 0;
    ascii_mode = 0;
  endfunction

  task body;
    logic [7:0] lcr_val;
    logic [15:0] divisor;

    divisor = get_divisor(baud_rate);

    lcr_val[1:0] = get_wls(data_bits);
    lcr_val[2] = (stop_bits == 2) ? 1'b1 : 1'b0;
    lcr_val[3] = parity_en;
    lcr_val[4] = even_parity;
    lcr_val[7] = 1'b1;

    `uvm_info("UART_CFG", $sformatf("Configuring: Baud=%0d, Data bits=%0d, Stop bits=%0d, Parity=%0d",
              baud_rate, data_bits, stop_bits, parity_en), UVM_MEDIUM)

    write_reg(3'h3, lcr_val);
    write_reg(3'h0, divisor[7:0]);
    write_reg(3'h1, divisor[15:8]);
    lcr_val[7] = 1'b0;
    write_reg(3'h3, lcr_val);
    if (sb_handle != null) sb_handle.record_config(baud_rate, data_bits, stop_bits, parity_en, even_parity);
  endtask

  function logic [1:0] get_wls(int bits);
    case (bits)
      5: return 2'b00;
      6: return 2'b01;
      7: return 2'b10;
      8: return 2'b11;
      default: return 2'b11;
    endcase
  endfunction

  function logic [15:0] get_divisor(int baud);
    int clk_freq = 100_000_000;
    return (clk_freq / (16 * baud));
  endfunction
endclass

// -------------------------------------------------------------------------
// UART Transmit Sequence — sends bytes via THR
// -------------------------------------------------------------------------
class uart_tx_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils(uart_tx_seq)

  rand logic [7:0] tx_data[$];
  int num_bytes;
  rand bit ascii_constraint;

  constraint c_tx_data {
    tx_data.size() == num_bytes;
    num_bytes inside {[1:32]};
    if (ascii_constraint) {
      foreach (tx_data[i]) tx_data[i] inside {[8'h20:8'h7E]};
    }
  }

  function new(string n = "uart_tx_seq");
    super.new(n);
    num_bytes = 1;
    ascii_constraint = 0;
  endfunction

  task body;
    `uvm_info("UART_TX", $sformatf("Transmitting %0d bytes: %p", num_bytes, tx_data), UVM_MEDIUM)

    for (int i = 0; i < num_bytes; i++) begin
      wait_for_tx_empty();

      write_reg(3'h0, tx_data[i]);
      if (sb_handle != null) sb_handle.record_tx(3'h0, tx_data[i]);
      `uvm_info("UART_TX", $sformatf("Wrote byte: 0x%02h (%c)", tx_data[i], tx_data[i]), UVM_HIGH)
    end

    `uvm_info("UART_TX", "TX sequence complete", UVM_MEDIUM)
  endtask

  task wait_for_tx_empty(int timeout = 100000);
    logic [7:0] lsr_data;
    repeat (timeout) begin
      read_reg(3'h5, lsr_data);
      if (lsr_data[5]) begin
        return;
      end
      @(posedge m_sequencer.vif.clk);
    end
    `uvm_error("UART_TX", "Timeout waiting for TX empty")
  endtask
endclass

// -------------------------------------------------------------------------
// UART Receive Sequence — waits for RX bytes via RBR
// -------------------------------------------------------------------------
class uart_rx_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils(uart_rx_seq)

  logic [7:0] rx_data[$];
  int expected_bytes = 1;
  int timeout_cycles = 100000;

  function new(string n = "uart_rx_seq");
    super.new(n);
  endfunction

  task body;
    logic [7:0] lsr_val;
    int timeout_cnt = 0;

    `uvm_info("UART_RX", $sformatf("Waiting for %0d RX bytes", expected_bytes), UVM_MEDIUM)

    while (rx_data.size() < expected_bytes && timeout_cnt < timeout_cycles) begin
      read_reg(3'h5, lsr_val);

      if (lsr_val[0]) begin
        logic [7:0] data;
        read_reg(3'h0, data);
        rx_data.push_back(data);
        if (sb_handle != null) sb_handle.record_rx(3'h0, data);
        `uvm_info("UART_RX", $sformatf("Received byte: 0x%02h", data), UVM_HIGH)
      end else begin
        timeout_cnt++;
        @(posedge m_sequencer.vif.clk);
      end
    end

    if (timeout_cnt >= timeout_cycles) begin
      `uvm_error("UART_RX", $sformatf("Timeout! Received %0d/%0d bytes", rx_data.size(), expected_bytes))
    end
  endtask
endclass

// -------------------------------------------------------------------------
// UART Loopback Sequence — enables MCR loopback, TX/RX comparison
// -------------------------------------------------------------------------
class uart_loopback_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils(uart_loopback_seq)

  rand logic [7:0] test_data[$];
  int num_passes = 0;
  int errors = 0;
  int rx_timeout = 500000;

  constraint c_test_data {
    test_data.size() inside {[1:16]};
  }

  function new(string n = "uart_loopback_seq");
    super.new(n);
  endfunction

  task body;
    logic [7:0] mcr_val;

    `uvm_info("UART_LB", "Starting loopback test", UVM_MEDIUM)

    read_reg(3'h4, mcr_val);
    mcr_val[4] = 1'b1;
    write_reg(3'h4, mcr_val);
    `uvm_info("UART_LB", "Loopback enabled (MCR[4]=1)", UVM_MEDIUM)

    foreach (test_data[i]) begin
      logic [7:0] rx_byte;
      bit received;

      write_reg(3'h0, test_data[i]);
      `uvm_info("UART_LB", $sformatf("TX[%0d] = 0x%02h", i, test_data[i]), UVM_MEDIUM)

      uart_wait_for_rx(rx_byte, received);

      if (received) begin
        if (rx_byte === test_data[i]) begin
          num_passes++;
          `uvm_info("UART_LB", $sformatf("Loopback MATCH[%0d]: TX=0x%02h RX=0x%02h",
                    i, test_data[i], rx_byte), UVM_MEDIUM)
          if (sb_handle != null) sb_handle.record_tx(3'h0, test_data[i]);
        end else begin
          errors++;
          `uvm_error("UART_LB", $sformatf("Loopback MISMATCH[%0d]: TX=0x%02h RX=0x%02h",
                     i, test_data[i], rx_byte))
          if (sb_handle != null) begin
            record_error("LOOPBACK", $sformatf("Mismatch[%0d]: TX=0x%02h RX=0x%02h", i, test_data[i], rx_byte));
          end
        end
      end else begin
        errors++;
        `uvm_error("UART_LB", $sformatf("Loopback timeout[%0d]: TX=0x%02h no RX data received",
                   i, test_data[i]))
        if (sb_handle != null) record_error("LOOPBACK_TIMEOUT", $sformatf("Timeout[%0d]", i));
      end
    end

    mcr_val[4] = 1'b0;
    write_reg(3'h4, mcr_val);
    `uvm_info("UART_LB", "Loopback disabled (MCR[4]=0)", UVM_MEDIUM)

    `uvm_info("UART_LB", $sformatf(
      "\n  === Loopback Test Results ==="
      "\n  Bytes Transmitted: %0d"
      "\n  Bytes Matched:     %0d"
      "\n  Errors:            %0d",
      test_data.size(), num_passes, errors
    ), UVM_LOW)
  endtask

  protected task uart_wait_for_rx(output logic [7:0] data, output bit received);
    int timeout = rx_timeout;
    logic [7:0] lsr_val;
    received = 0;
    while (timeout > 0 && !received) begin
      read_reg(3'h5, lsr_val);
      if (lsr_val[0]) begin
        read_reg(3'h0, data);
        received = 1;
      end else begin
        timeout--;
        @(posedge m_sequencer.vif.clk);
      end
    end
    if (!received) begin
      data = 'x;
    end
  endtask
endclass

// -------------------------------------------------------------------------
// UART Interrupt Sequence — test each interrupt type
// -------------------------------------------------------------------------
class uart_interrupt_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils(uart_interrupt_seq)

  typedef enum {
    INT_RX_DATA, INT_TX_EMPTY, INT_LINE_STATUS, INT_MODEM_STATUS
  } int_type_t;

  rand int_type_t int_type;
  bit interrupt_detected;
  int irq_assertions;
  bit timeout_hit;

  function new(string n = "uart_interrupt_seq");
    super.new(n);
    interrupt_detected = 0;
    irq_assertions = 0;
  endfunction

  task body;
    logic [7:0] ier_val;
    logic [7:0] iir_val;

    `uvm_info("UART_INT", $sformatf("Testing interrupt type: %s", int_type.name()), UVM_MEDIUM)

    case (int_type)
      INT_RX_DATA:    ier_val = 8'h01;
      INT_TX_EMPTY:  ier_val = 8'h02;
      INT_LINE_STATUS: ier_val = 8'h04;
      INT_MODEM_STATUS: ier_val = 8'h08;
    endcase

    write_reg(3'h1, ier_val);

    fork
      wait_for_intr_signal();
      trigger_intr();
      begin
        #10ms;
        timeout_hit = 1'b1;
      end
    join_any
    disable fork;
    if (timeout_hit)
      `uvm_warning("UART_INT", "Interrupt test timed out after 10 ms")

    read_reg(3'h2, iir_val);

    if (iir_val[0] == 1'b0) begin
      `uvm_info("UART_INT", $sformatf("Interrupt pending, IIR = 0x%02h", iir_val), UVM_MEDIUM)
      interrupt_detected = 1;
    end else begin
      `uvm_warning("UART_INT", $sformatf("No interrupt pending after stimulus, IIR=0x%02h", iir_val))
    end

    if (sb_handle != null) begin
      sb_handle.check_interrupt(iir_val, interrupt_detected);
      sb_handle.check_interrupt_cause(iir_val);
    end
  endtask

  task wait_for_intr_signal();
    int timeout = 200000;
    for (int i = 0; i < timeout; i++) begin
      @(posedge m_sequencer.vif.clk);
      if (m_sequencer.vif.uart_intr) begin
        irq_assertions++;
        `uvm_info("UART_INT", $sformatf("Interrupt asserted on uart_intr (count=%0d)", irq_assertions), UVM_MEDIUM)
        if (irq_assertions >= 1) return;
      end
    end
    `uvm_warning("UART_INT", "Timeout waiting for interrupt signal")
  endtask

  task trigger_intr();
    case (int_type)
      INT_TX_EMPTY: begin
        #100ns;
        write_reg(3'h0, 8'hAA);
        `uvm_info("UART_INT", "Trigger: TX data written to THR", UVM_MEDIUM)
      end
      INT_RX_DATA: begin
        logic [7:0] mcr_val;
        read_reg(3'h4, mcr_val);
        mcr_val[4] = 1'b1;
        write_reg(3'h4, mcr_val);
        `uvm_info("UART_INT", "Trigger: Loopback enabled (MCR[4]=1)", UVM_MEDIUM)
        #100ns;
        write_reg(3'h0, 8'h55);
        `uvm_info("UART_INT", "Trigger: TX byte 0x55 written, expected to echo to RBR", UVM_MEDIUM)
        #10us;
      end
      INT_LINE_STATUS: begin
        logic [7:0] lcr_val;
        read_reg(3'h3, lcr_val);
        lcr_val[3] = 1'b1;
        lcr_val[4] = 1'b1;
        lcr_val[5] = 1'b0;
        write_reg(3'h3, lcr_val);
        `uvm_info("UART_INT", "Trigger: Even parity enabled in LCR", UVM_MEDIUM)
        #100ns;
        write_reg(3'h0, 8'hA5);
        `uvm_info("UART_INT", "Trigger: TX byte 0xA5 (no parity bit in data)", UVM_MEDIUM)
        #20us;
        lcr_val[3] = 1'b0;
        write_reg(3'h3, lcr_val);
      end
      INT_MODEM_STATUS: begin
        logic [7:0] mcr_val;
        read_reg(3'h4, mcr_val);
        mcr_val[0] = ~mcr_val[0];
        write_reg(3'h4, mcr_val);
        `uvm_info("UART_INT", "Trigger: Modem control toggled (MCR[0])", UVM_MEDIUM)
        #10us;
      end
    endcase
  endtask
endclass

