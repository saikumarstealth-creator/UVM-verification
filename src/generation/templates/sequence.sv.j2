      `uvm_warning("CFG", $sformatf("Scoreboard handle not found for %s", get_type_name()))
  endtask

  task body;
    {{ spec.design_name }}_apb_config_seq      cfg_seq;
    {{ spec.design_name }}_apb_write_read_seq  wr_seq;
    {{ spec.design_name }}_apb_error_seq       err_seq;
    {{ spec.design_name }}_apb_back2back_seq   b2b_seq;

    `uvm_info("APB_VSEQ", "Starting APB virtual sequence on virtual sequencer", UVM_LOW)

    // 1. Configure slave
    cfg_seq = {{ spec.design_name }}_apb_config_seq::type_id::create("cfg_seq");
    cfg_seq.reg_model = reg_model;
    cfg_seq.wait_states = 2;
    cfg_seq.inject_slave_err = 0;
    cfg_seq.start(p_sequencer.bus_seqr);

    // 2. Write-read test
    wr_seq = {{ spec.design_name }}_apb_write_read_seq::type_id::create("wr_seq");
    wr_seq.reg_model = reg_model;
    wr_seq.target_reg = 0;
    wr_seq.write_data = 8'hA5;
    wr_seq.start(p_sequencer.bus_seqr);

    // 3. Error injection test
    err_seq = {{ spec.design_name }}_apb_error_seq::type_id::create("err_seq");
    err_seq.reg_model = reg_model;
    err_seq.num_errors = 3;
    err_seq.start(p_sequencer.bus_seqr);

    // 4. Back-to-back stress test
    b2b_seq = {{ spec.design_name }}_apb_back2back_seq::type_id::create("b2b_seq");
    b2b_seq.reg_model = reg_model;
    b2b_seq.burst_count = 16;
    b2b_seq.start(p_sequencer.bus_seqr);

    `uvm_info("APB_VSEQ", "APB virtual sequence completed", UVM_LOW)
  endtask
endclass

