    {{ spec.design_name }}_seq_lib::add_sequence({{ spec.design_name }}_interrupt_seq::get_type());
{% endif %}
{% if _need_tx %}
    {{ spec.design_name }}_seq_lib::add_sequence({{ spec.design_name }}_error_injection_seq::get_type());
{% endif %}
{% if _need_lcr and _need_tx %}
    {{ spec.design_name }}_seq_lib::add_sequence({{ spec.design_name }}_random_seq::get_type());
    {{ spec.design_name }}_seq_lib::add_sequence({{ spec.design_name }}_baud_change_seq::get_type());
    {{ spec.design_name }}_seq_lib::add_sequence({{ spec.design_name }}_coverage_seq::get_type());
    {{ spec.design_name }}_seq_lib::add_sequence({{ spec.design_name }}_virtual_seq::get_type());
{% endif %}
    // Always generated (use reg_model generically):
    {{ spec.design_name }}_seq_lib::add_sequence({{ spec.design_name }}_reg_hw_reset_seq::get_type());
    {{ spec.design_name }}_seq_lib::add_sequence({{ spec.design_name }}_reg_bit_bash_seq::get_type());
    {{ spec.design_name }}_seq_lib::add_sequence({{ spec.design_name }}_reg_access_seq::get_type());
    {{ spec.design_name }}_seq_lib::add_sequence({{ spec.design_name }}_reg_mem_walk_seq::get_type());
    {{ spec.design_name }}_seq_lib::add_sequence({{ spec.design_name }}_reg_aliasing_seq::get_type());
    {{ spec.design_name }}_seq_lib::add_sequence({{ spec.design_name }}_reset_test_seq::get_type());
  endfunction

  function new(string name = "{{ spec.design_name }}_seq_lib");
    super.new(name);
    init_sequence_library();
    add_sequences();
  endfunction
