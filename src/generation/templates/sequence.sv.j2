class {{ spec.design_name }}_i2c_nack_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_i2c_nack_seq)

  rand logic [6:0] invalid_addr;
  int nack_count;

