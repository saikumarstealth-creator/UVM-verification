// -------------------------------------------------------------------------
// SPI FIFO Overflow Sequence — stress TX FIFO with burst data
// -------------------------------------------------------------------------
class {{ spec.design_name }}_spi_fifo_overflow_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_spi_fifo_overflow_seq)

  rand int burst_size;
  int overflow_events;

  constraint c_spi_fifo { burst_size inside {[16:64]}; }

  function new(string n = "{{ spec.design_name }}_spi_fifo_overflow_seq");
    super.new(n);
  endfunction

  task body;
    logic [7:0] status;

    `uvm_info("SPI_FIFO", $sformatf("FIFO overflow test: %0d bytes", burst_size), UVM_LOW)

    write_reg(1, 8'h01);

    for (int i = 0; i < burst_size; i++) begin
      write_reg(2, 8'($urandom_range(0, 255)));
      if (i % 8 == 0) begin
        read_reg(4, status);
        if (status[1]) overflow_events++;
      end
    end

    write_reg(1, 8'h00);

    if (overflow_events > 0)
      `uvm_info("SPI_FIFO", $sformatf("FIFO overflow detected: %0d events", overflow_events), UVM_LOW)
    else
      `uvm_info("SPI_FIFO", "No overflow — FIFO depth adequate for burst", UVM_MEDIUM)
  endtask
endclass

