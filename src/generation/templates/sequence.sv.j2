// -------------------------------------------------------------------------
// UART FIFO Overflow Sequence — fills TX FIFO, verifies overflow handling
// -------------------------------------------------------------------------
class {{ spec.design_name }}_fifo_overflow_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_fifo_overflow_seq)

  rand int num_overflow_bytes;

  constraint c_overflow {
    num_overflow_bytes inside {[16:64]};
  }

  function new(string n = "{{ spec.design_name }}_fifo_overflow_seq");
    super.new(n);
  endfunction

  task body;
    logic [7:0] lsr_val;
    int overflow_events;

    `uvm_info("{{ spec.design_name|upper }}_FIFO", $sformatf("FIFO overflow test: %0d bytes", num_overflow_bytes), UVM_LOW)

    for (int i = 0; i < num_overflow_bytes; i++) begin
      write_reg({{ spec.design_name|upper }}_THR_ADDR, 8'($urandom_range(0, 255)));
      if (i >= 16 && (i % 4) == 0) begin
        read_reg({{ spec.design_name|upper }}_LSR_ADDR, lsr_val);
        if (lsr_val[1]) begin
          overflow_events++;
          `uvm_info("{{ spec.design_name|upper }}_FIFO", $sformatf("Overflow flag detected at byte %0d", i), UVM_MEDIUM)
        end
      end
    end

    if (overflow_events > 0)
      `uvm_info("{{ spec.design_name|upper }}_FIFO", $sformatf("FIFO overflow correctly detected: %0d times", overflow_events), UVM_LOW)
    else
      `uvm_warning("{{ spec.design_name|upper }}_FIFO", "No overflow events detected — FIFO may be larger than test data")
  endtask
endclass

// -------------------------------------------------------------------------
// UART Long Run Sequence — sustained traffic of 100+ bytes
// -------------------------------------------------------------------------
class {{ spec.design_name }}_long_run_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_long_run_seq)

  rand int total_bytes;
  int tx_completed;
  int errors;

  constraint c_long_run {
    total_bytes inside {[100:500]};
  }

  function new(string n = "{{ spec.design_name }}_long_run_seq");
    super.new(n);
  endfunction

  task body;
    {{ spec.design_name }}_config_seq cfg_seq;
    logic [7:0] expected_data[$];
    int chunk_size = 16;

    `uvm_info("{{ spec.design_name|upper }}_LONG", $sformatf("Long run test: %0d total bytes", total_bytes), UVM_LOW)

    cfg_seq = {{ spec.design_name }}_config_seq::type_id::create("cfg_seq");
    cfg_seq.reg_model = reg_model;
    cfg_seq.start(m_sequencer);

    for (int i = 0; i < total_bytes; i += chunk_size) begin
      {{ spec.design_name }}_tx_seq tx_seq;
      int this_chunk = (i + chunk_size > total_bytes) ? total_bytes - i : chunk_size;

      tx_seq = {{ spec.design_name }}_tx_seq::type_id::create($sformatf("long_tx_%0d", i));
      tx_seq.reg_model = reg_model;
      tx_seq.num_bytes = this_chunk;
      if (!tx_seq.randomize()) begin
        `uvm_error("{{ spec.design_name|upper }}_LONG", "TX chunk randomization failed")
      end else begin
        tx_seq.start(m_sequencer);
        tx_completed += this_chunk;
        foreach (tx_seq.tx_data[j]) expected_data.push_back(tx_seq.tx_data[j]);
      end
      #2us;
    end

    // Wait for all TX to drain, then receive and verify
    #100us;
    begin
      logic [7:0] rx_data[$];
      int rx_timeout = expected_data.size() * 1000;
      while (rx_data.size() < expected_data.size() && rx_timeout > 0) begin
        logic [7:0] lsr_val;
        read_reg({{ addr_bits }}'h05, lsr_val);
        if (lsr_val[0]) begin
          logic [7:0] byte_val;
          read_reg({{ addr_bits }}'h00, byte_val);
          rx_data.push_back(byte_val);
        end
        @(posedge vif.clk);
        rx_timeout--;
      end
      foreach (expected_data[i]) begin
        if (i < rx_data.size()) begin
          if (expected_data[i] !== rx_data[i]) begin
            errors++;
            `uvm_error("{{ spec.design_name|upper }}_LONG", $sformatf("Mismatch[%0d]: TX=0x%02h RX=0x%02h", i, expected_data[i], rx_data[i]))
          end
        end else begin
          errors++;
          `uvm_error("{{ spec.design_name|upper }}_LONG", $sformatf("Missing RX[%0d]: expected 0x%02h not received", i, expected_data[i]))
        end
      end
    end

    `uvm_info("{{ spec.design_name|upper }}_LONG", $sformatf(
      "Long run complete: %0d/%0d bytes TX, %0d errors",
      tx_completed, total_bytes, errors), UVM_LOW)

    if (errors > 0)
      `uvm_error("{{ spec.design_name|upper }}_LONG", $sformatf("%0d errors during long run test", errors))
  endtask
endclass

// =========================================================================
// UART Framing Error Sequence — dedicated framing error injection via
// driver-level stop-bit corruption; verifies LSR.FE (bit 3).
// Requires: THR (0x00), LCR (0x03), LSR (0x05)
// =========================================================================
{% if ('0x00' in _reg_addr_set or '0x0' in _reg_addr_set) and ('0x03' in _reg_addr_set or '0x3' in _reg_addr_set) and ('0x05' in _reg_addr_set or '0x5' in _reg_addr_set) %}
class {{ spec.design_name }}_framing_error_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_framing_error_seq)

  rand int num_injections;
  int fe_detected;
  int fe_missed;

  constraint c_framing_count { num_injections inside {[1:8]}; }

  function new(string n = "{{ spec.design_name }}_framing_error_seq");
    super.new(n);
    num_injections = 3;
  endfunction

  task body;
    logic [7:0] lcr_val;
    logic [7:0] lsr_val;

    `uvm_info("FE_INJ", $sformatf("=== Framing Error Injection Test (%0d injections) ===", num_injections), UVM_LOW)

    // Configure 8N1
    read_reg({{ addr_bits }}'h03, lcr_val);
    lcr_val[1:0] = 2'b11;
    lcr_val[2] = 1'b0;
    lcr_val[3] = 1'b0;
    write_reg({{ addr_bits }}'h03, lcr_val);
    `uvm_info("FE_INJ", $sformatf("LCR configured for 8N1: 0x%02h", lcr_val), UVM_LOW)

    for (int i = 0; i < num_injections; i++) begin
      {{ spec.design_name }}_seq_item inj_req;
      logic [7:0] tx_byte;
      tx_byte = $urandom_range(0, 255);

      inj_req = {{ spec.design_name }}_seq_item::type_id::create($sformatf("fe_inj_%0d", i));
      start_item(inj_req);
      if (!inj_req.randomize() with {
        we == 1;
        addr == {{ addr_bits }}'h0;
        data == tx_byte;
        delay == 0;
        corrupt_parity == 0;
        corrupt_stop_bit == 1;
        force_break == 0;
      }) `uvm_fatal("RAND", "Framing injection randomization failed")
      finish_item(inj_req);

      repeat(500) @(posedge vif.clk);

      read_reg({{ addr_bits }}'h05, lsr_val);
      if (lsr_val[3]) begin
        fe_detected++;
        `uvm_info("FE_INJ", $sformatf("Inj %0d: framing error DETECTED LSR[3]=1 (data=0x%02h)", i, tx_byte), UVM_LOW)
      end else begin
        fe_missed++;
        `uvm_error("FE_INJ", $sformatf("Inj %0d: framing error NOT detected LSR[3]=0 (data=0x%02h)", i, tx_byte))
      end
      read_reg({{ addr_bits }}'h05, lsr_val);
    end

    `uvm_info("FE_INJ", $sformatf(
      "=== Framing Test Report: %0d/%0d detected, %0d missed ===",
      fe_detected, num_injections, fe_missed), UVM_LOW)

    if (fe_missed > 0)
      `uvm_error("FE_INJ", $sformatf("Framing error detection FAILED: %0d/%0d missed", fe_missed, num_injections))
    else
      `uvm_info("FE_INJ", "Framing error detection PASSED", UVM_LOW)
  endtask
endclass
{% endif %}

// =========================================================================
// UART FIFO Trigger Level Sequence — verifies RX trigger interrupts at
// all four 16550-compatible levels (1, 4, 8, 14 bytes).
// Uses loopback mode to feed RX; monitors IIR for trigger match.
// Requires: FCR (0x02), IER (0x01), IIR (0x02), MCR (0x04), THR (0x00)
// =========================================================================
{% if ('0x02' in _reg_addr_set or '0x2' in _reg_addr_set) and ('0x01' in _reg_addr_set or '0x1' in _reg_addr_set) and ('0x04' in _reg_addr_set or '0x4' in _reg_addr_set) and ('0x00' in _reg_addr_set or '0x0' in _reg_addr_set) %}
class {{ spec.design_name }}_fifo_trigger_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_fifo_trigger_seq)

  int trigger_levels[4] = '{1, 4, 8, 14};
  int trigger_bits[4] = '{2'b00, 2'b01, 2'b10, 2'b11};
  int passed_levels;
  int failed_levels;

  function new(string n = "{{ spec.design_name }}_fifo_trigger_seq");
    super.new(n);
  endfunction

  task body;
    logic [7:0] fcr_val;
    logic [7:0] ier_val;
    logic [7:0] iir_val;
    logic [7:0] mcr_val;

    `uvm_info("FIFO_TRIG", "=== FIFO Trigger Level Test ===", UVM_LOW)

    // Enable loopback
    read_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);
    mcr_val[4] = 1'b1;
    write_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);

    // Enable RX data interrupt
    write_reg({{ spec.design_name|upper }}_IER_ADDR, 8'h01);

    for (int t = 0; t < 4; t++) begin
      int bytes_sent;
      bit trigger_verified;

      // Set FIFO trigger level: FCR[7:6] = trigger_bits[t]; also enable FIFO + reset
      fcr_val = {trigger_bits[t], 2'b00, 1'b0, 2'b11};
      write_reg({{ spec.design_name|upper }}_FCR_ADDR, fcr_val);
      repeat(10) @(posedge vif.clk);

      `uvm_info("FIFO_TRIG", $sformatf("Trigger level %0d bytes (FCR[7:6]=%b)",
                trigger_levels[t], trigger_bits[t]), UVM_MEDIUM)

      // Send bytes via loopback (one more than trigger level to guarantee trigger)
      for (int b = 0; b < trigger_levels[t] + 1; b++) begin
        write_reg({{ spec.design_name|upper }}_THR_ADDR, 8'hA0 + b);
        bytes_sent++;
        repeat(100) @(posedge vif.clk);
      end

      // Check IIR for RX data pending (IIR[3:1]=010 for RX data available)
      read_reg({{ spec.design_name|upper }}_IIR_ADDR, iir_val);
      `uvm_info("FIFO_TRIG", $sformatf("After %0d TX bytes: IIR=0x%02h (pending=%b, cause=%b)",
                bytes_sent, iir_val, !iir_val[0], iir_val[3:1]), UVM_MEDIUM)

      if (!iir_val[0] && iir_val[3:1] == 3'b010) begin
        passed_levels++;
        trigger_verified = 1;
        `uvm_info("FIFO_TRIG", $sformatf("Level %0d: RX trigger PASS", trigger_levels[t]), UVM_LOW)
      end else begin
        failed_levels++;
        `uvm_error("FIFO_TRIG", $sformatf("Level %0d: RX trigger FAIL (IIR=0x%02h, exp cause=010 pending=0)",
                   trigger_levels[t], iir_val))
      end

      // Drain RX FIFO by reading RBR
      for (int b = 0; b < bytes_sent; b++) begin
        logic [7:0] rbr_val;
        read_reg({{ spec.design_name|upper }}_RBR_ADDR, rbr_val);
      end
      repeat(10) @(posedge vif.clk);
    end

    // Disable loopback
    read_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);
    mcr_val[4] = 1'b0;
    write_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);

    `uvm_info("FIFO_TRIG", $sformatf(
      "=== FIFO Trigger Test: %0d passed, %0d failed ===",
      passed_levels, failed_levels), UVM_LOW)

    if (failed_levels > 0)
      `uvm_error("FIFO_TRIG", $sformatf("%0d trigger level(s) failed", failed_levels))
  endtask
endclass
{% endif %}

// =========================================================================
// UART Flow Control Sequence — verifies RTS/CTS flow control handshake
// via modem loopback. Asserts RTS (MCR[1]), checks CTS (MSR[4]),
// toggles and re-verifies.
// Requires: MCR (0x04), MSR (0x06)
// =========================================================================
{% if ('0x04' in _reg_addr_set or '0x4' in _reg_addr_set) and ('0x06' in _reg_addr_set or '0x6' in _reg_addr_set) %}
class {{ spec.design_name }}_flow_control_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_flow_control_seq)

  int checks_passed;
  int checks_failed;

  function new(string n = "{{ spec.design_name }}_flow_control_seq");
    super.new(n);
  endfunction

  task body;
    logic [7:0] mcr_val;
    logic [7:0] msr_val;

    `uvm_info("FC_CTRL", "=== Flow Control (RTS/CTS) Test ===", UVM_LOW)

    // Enable loopback so MCR signals loop to MSR
    read_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);
    mcr_val[4] = 1'b1;
    write_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);
    repeat(5) @(posedge vif.clk);

    // Test 1: Assert RTS (MCR[1]=1), expect CTS (MSR[4]=1) via loop
    read_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);
    mcr_val[1] = 1'b1;
    write_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);
    repeat(5) @(posedge vif.clk);
    read_reg({{ spec.design_name|upper }}_MSR_ADDR, msr_val);
    if (msr_val[4]) begin
      checks_passed++;
      `uvm_info("FC_CTRL", $sformatf("RTS=1 -> CTS=1 PASS (MSR=0x%02h)", msr_val), UVM_MEDIUM)
    end else begin
      checks_failed++;
      `uvm_error("FC_CTRL", $sformatf("RTS=1 -> CTS=0 FAIL (MSR=0x%02h)", msr_val))
    end

    // Test 2: Deassert RTS (MCR[1]=0), expect CTS (MSR[4]=0)
    read_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);
    mcr_val[1] = 1'b0;
    write_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);
    repeat(5) @(posedge vif.clk);
    read_reg({{ spec.design_name|upper }}_MSR_ADDR, msr_val);
    if (!msr_val[4]) begin
      checks_passed++;
      `uvm_info("FC_CTRL", $sformatf("RTS=0 -> CTS=0 PASS (MSR=0x%02h)", msr_val), UVM_MEDIUM)
    end else begin
      checks_failed++;
      `uvm_error("FC_CTRL", $sformatf("RTS=0 -> CTS=1 FAIL (MSR=0x%02h)", msr_val))
    end

    // Test 3: Toggle DTR (MCR[0]), verify DSR (MSR[5])
    read_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);
    mcr_val[0] = 1'b1;
    write_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);
    repeat(5) @(posedge vif.clk);
    read_reg({{ spec.design_name|upper }}_MSR_ADDR, msr_val);
    if (msr_val[5]) begin
      checks_passed++;
      `uvm_info("FC_CTRL", $sformatf("DTR=1 -> DSR=1 PASS (MSR=0x%02h)", msr_val), UVM_MEDIUM)
    end else begin
      checks_failed++;
      `uvm_error("FC_CTRL", $sformatf("DTR=1 -> DSR=0 FAIL (MSR=0x%02h)", msr_val))
    end

    // Test 4: Delta-bit detection — MSR[0] (delta CTS) should be set after a change
    read_reg({{ spec.design_name|upper }}_MSR_ADDR, msr_val);
    if (msr_val[0]) begin
      checks_passed++;
      `uvm_info("FC_CTRL", "Delta CTS detected (MSR[0]=1) PASS", UVM_MEDIUM)
    end else begin
      `uvm_info("FC_CTRL", "Delta CTS not set (MSR[0]=0) — acceptable if no change", UVM_MEDIUM)
    end

    // Disable loopback
    read_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);
    mcr_val[4] = 1'b0;
    write_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);

    `uvm_info("FC_CTRL", $sformatf(
      "=== Flow Control Test: %0d passed, %0d failed ===",
      checks_passed, checks_failed), UVM_LOW)

    if (checks_failed > 0)
      `uvm_error("FC_CTRL", $sformatf("%0d flow control check(s) failed", checks_failed))
  endtask
endclass
{% endif %}

// =========================================================================
// UART Full Duplex Sequence — simultaneous TX and RX via loopback;
// sends and receives multiple bytes in parallel, verifies data integrity.
// Requires: MCR (0x04), THR (0x00), RBR (0x00), LSR (0x05)
// =========================================================================
{% if ('0x04' in _reg_addr_set or '0x4' in _reg_addr_set) and ('0x00' in _reg_addr_set or '0x0' in _reg_addr_set) and ('0x05' in _reg_addr_set or '0x5' in _reg_addr_set) %}
class {{ spec.design_name }}_full_duplex_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_full_duplex_seq)

  rand int num_bytes;
  logic [7:0] tx_data[$];
  logic [7:0] rx_data[$];
  int matches;
  int mismatches;

  constraint c_full_dup { num_bytes inside {[4:64]}; }

  function new(string n = "{{ spec.design_name }}_full_duplex_seq");
    super.new(n);
  endfunction

  task body;
    logic [7:0] mcr_val;

    `uvm_info("FULL_DUP", $sformatf("=== Full Duplex Test (%0d bytes) ===", num_bytes), UVM_LOW)

    // Enable loopback
    read_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);
    mcr_val[4] = 1'b1;
    write_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);
    repeat(5) @(posedge vif.clk);

    // Generate random TX data
    for (int i = 0; i < num_bytes; i++) begin
      tx_data.push_back($urandom_range(0, 255));
    end

    // Simultaneous TX and RX
    fork
      begin
        for (int i = 0; i < num_bytes; i++) begin
          write_reg({{ spec.design_name|upper }}_THR_ADDR, tx_data[i]);
          if (sb_handle != null) sb_handle.record_tx({{ spec.design_name|upper }}_THR_ADDR, tx_data[i]);
          `uvm_info("FULL_DUP", $sformatf("TX[%0d] = 0x%02h", i, tx_data[i]), UVM_MEDIUM)
          repeat(200) @(posedge vif.clk);
        end
      end
      begin
        int rx_timeout;
        while (rx_data.size() < num_bytes && rx_timeout < num_bytes * 500) begin
          logic [7:0] lsr_val;
          logic [7:0] rbr_val;
          read_reg({{ spec.design_name|upper }}_LSR_ADDR, lsr_val);
          if (lsr_val[0]) begin
            read_reg({{ spec.design_name|upper }}_RBR_ADDR, rbr_val);
            rx_data.push_back(rbr_val);
            if (sb_handle != null) sb_handle.record_rx({{ spec.design_name|upper }}_RBR_ADDR, rbr_val);
            `uvm_info("FULL_DUP", $sformatf("RX[%0d] = 0x%02h", rx_data.size()-1, rbr_val), UVM_MEDIUM)
          end
          @(posedge vif.clk);
          rx_timeout++;
        end
      end
    join

    // Compare TX vs RX
    for (int i = 0; i < tx_data.size(); i++) begin
      if (i < rx_data.size()) begin
        if (tx_data[i] === rx_data[i]) begin
          matches++;
          `uvm_info("FULL_DUP", $sformatf("MATCH[%0d]: TX=0x%02h RX=0x%02h", i, tx_data[i], rx_data[i]), UVM_HIGH)
        end else begin
          mismatches++;
          `uvm_error("FULL_DUP", $sformatf("MISMATCH[%0d]: TX=0x%02h RX=0x%02h", i, tx_data[i], rx_data[i]))
        end
      end else begin
        mismatches++;
        `uvm_error("FULL_DUP", $sformatf("MISSING RX[%0d]: TX=0x%02h not received", i, tx_data[i]))
      end
    end

    // Disable loopback
    read_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);
    mcr_val[4] = 1'b0;
    write_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);

    `uvm_info("FULL_DUP", $sformatf(
      "=== Full Duplex: %0d TX, %0d RX, %0d match, %0d mismatch ===",
      tx_data.size(), rx_data.size(), matches, mismatches), UVM_LOW)

    if (mismatches > 0)
      `uvm_error("FULL_DUP", $sformatf("%0d full duplex mismatch(es)", mismatches))
  endtask
endclass
{% endif %}

// =========================================================================
// UART Long Regression Sequence — extended stress with random configs,
// TX/RX loopback bursts, and error injection interleaved across many
// iterations. Models a production soak test.
// Requires: all standard UART registers (0x00-0x05)
// =========================================================================
{% if _need_lcr and _need_tx and ('0x04' in _reg_addr_set or '0x4' in _reg_addr_set) %}
class {{ spec.design_name }}_long_regression_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_long_regression_seq)

  rand int num_iterations;
  rand int baud_rates[$];
  rand int data_bits_vals[$];
  int total_tx;
  int total_rx;
  int total_errors;
  int total_configs;

  constraint c_regression {
    num_iterations inside {[10:100]};
    baud_rates.size() inside {[1:5]};
    data_bits_vals.size() inside {[1:4]};
    foreach (baud_rates[i]) baud_rates[i] inside {9600, 19200, 38400, 57600, 115200, 1000000};
    foreach (data_bits_vals[i]) data_bits_vals[i] inside {5, 6, 7, 8};
  }

  function new(string n = "{{ spec.design_name }}_long_regression_seq");
    super.new(n);
  endfunction

  task body;
    {{ spec.design_name }}_config_seq cfg_seq;

    `uvm_info("LONG_REGR", $sformatf("=== Long Regression: %0d iterations ===", num_iterations), UVM_LOW)

    for (int iter = 0; iter < num_iterations; iter++) begin
      {{ spec.design_name }}_loopback_seq lb_seq;
      int rand_baud;
      int rand_dbits;
      int rand_parity;
      int rand_stop;

      // Random config for this iteration
      rand_baud = baud_rates[$urandom_range(0, baud_rates.size()-1)];
      rand_dbits = data_bits_vals[$urandom_range(0, data_bits_vals.size()-1)];
      rand_parity = $urandom_range(0, 1);
      rand_stop = ($urandom_range(0, 1)) ? 2 : 1;

      cfg_seq = {{ spec.design_name }}_config_seq::type_id::create($sformatf("cfg_iter_%0d", iter));
      cfg_seq.reg_model = reg_model;
      cfg_seq.baud_rate = rand_baud;
      cfg_seq.data_bits = rand_dbits;
      cfg_seq.stop_bits = rand_stop;
      cfg_seq.parity_en = rand_parity;
      cfg_seq.start(m_sequencer);
      total_configs++;
      repeat(50) @(posedge vif.clk);

      // Loopback burst
      lb_seq = {{ spec.design_name }}_loopback_seq::type_id::create($sformatf("lb_iter_%0d", iter));
      lb_seq.reg_model = reg_model;
      lb_seq.sb_handle = sb_handle;
      if (!lb_seq.randomize() with { test_data.size() inside {[4:12]}; }) begin
        `uvm_error("LONG_REGR", $sformatf("Iter %0d: loopback randomization failed", iter))
      end else begin
        lb_seq.start(m_sequencer);
        total_tx += lb_seq.test_data.size();
        total_errors += lb_seq.errors;
        `uvm_info("LONG_REGR", $sformatf("Iter %0d: baud=%0d %0d%c%0d tx=%0d err=%0d",
                  iter, rand_baud, rand_dbits, rand_stop == 2 ? "N" : "n", rand_parity,
                  lb_seq.test_data.size(), lb_seq.errors), UVM_MEDIUM)
      end

      // Every 5 iterations, inject a parity error
      if (iter % 5 == 0 && iter > 0) begin
        {{ spec.design_name }}_error_injection_seq inj_seq;
        inj_seq = {{ spec.design_name }}_error_injection_seq::type_id::create($sformatf("inj_iter_%0d", iter));
        inj_seq.reg_model = reg_model;
        inj_seq.inj_type = {{ spec.design_name }}_error_injection_seq::INJ_PARITY;
        inj_seq.num_injections = 2;
        inj_seq.start(m_sequencer);
      end
    end

    `uvm_info("LONG_REGR", $sformatf(
      "\n  === Long Regression Report ==="
      "\n  Iterations:     %0d"
      "\n  Configs Tried:  %0d"
      "\n  TX Bytes:       %0d"
      "\n  Errors:         %0d",
      num_iterations, total_configs, total_tx, total_errors), UVM_LOW)

    if (total_errors > 0)
      `uvm_error("LONG_REGR", $sformatf("%0d errors during long regression", total_errors))
    else
      `uvm_info("LONG_REGR", "Long regression PASSED", UVM_LOW)
  endtask
endclass
{% endif %}

// =========================================================================
// UART Reset Sequence — applies hardware reset via interface signals.
// Reusable mid-test: can be called at any time to reset the DUT mid-transfer.
// Requires: vif.rst_n, vif (clock)
// =========================================================================
class {{ spec.design_name }}_reset_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_reset_seq)

  rand int reset_cycles;
  rand int post_reset_cycles;

  constraint c_reset_len {
    reset_cycles inside {[5:20]};
    post_reset_cycles inside {[5:10]};
  }

  function new(string n = "{{ spec.design_name }}_reset_seq");
    super.new(n);
    reset_cycles = 10;
    post_reset_cycles = 5;
  endfunction

  task body;
    `uvm_info("RST_SEQ", "Asserting reset", UVM_MEDIUM)
    vif.rst_n <= 1'b0;
{% if p == "uart" %}
    vif.uart_rx <= 1'b1;
    vif.cts_n <= 1'b0;
{% endif %}
    repeat (reset_cycles) @(posedge vif.clk);
    `uvm_info("RST_SEQ", "Deasserting reset", UVM_MEDIUM)
    vif.rst_n <= 1'b1;
    repeat (post_reset_cycles) @(posedge vif.clk);
    `uvm_info("RST_SEQ", "Reset complete", UVM_MEDIUM)
  endtask
endclass

// =========================================================================
// UART Baud Divisor Verification — verifies DLL/DLH programming affects
// the actual baud rate by measuring TX bit timing via LSR polling.
// Requires: DLL (0x00), DLH (0x01), LCR (0x03), LSR (0x05), THR (0x00)
// =========================================================================
{% if ('0x00' in _reg_addr_set or '0x0' in _reg_addr_set) and ('0x01' in _reg_addr_set or '0x1' in _reg_addr_set) and ('0x03' in _reg_addr_set or '0x3' in _reg_addr_set) and ('0x05' in _reg_addr_set or '0x5' in _reg_addr_set) %}
class {{ spec.design_name }}_baud_divisor_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_baud_divisor_seq)

  int divisors[4][2] = '{'{1, 0}, '{8, 0}, '{54, 0}, '{104, 0}};
  int pass_count;
  int fail_count;

  function new(string n = "{{ spec.design_name }}_baud_divisor_seq");
    super.new(n);
  endfunction

  task body;
    logic [7:0] lcr_val;
    logic [7:0] lsr_val;

    `uvm_info("BAUD_DIV", "=== Baud Divisor Verification ===", UVM_LOW)

    foreach (divisors[i]) begin
      logic [15:0] divisor;
      divisor = {divisors[i][1], divisors[i][0]};

      read_reg({{ addr_bits }}'h03, lcr_val);
      lcr_val[7] = 1'b1;
      write_reg({{ addr_bits }}'h03, lcr_val);
      write_reg({{ addr_bits }}'h00, divisor[7:0]);
      write_reg({{ addr_bits }}'h01, divisor[15:8]);
      lcr_val[7] = 1'b0;
      write_reg({{ addr_bits }}'h03, lcr_val);
      repeat(10) @(posedge vif.clk);

      write_reg({{ addr_bits }}'h00, 8'hA5);
      repeat(500) @(posedge vif.clk);
      read_reg({{ addr_bits }}'h05, lsr_val);

      `uvm_info("BAUD_DIV", $sformatf("Divisor %0d (0x%04h): LSR=0x%02h THRE=%0d TEMT=%0d",
                i, divisor, lsr_val, lsr_val[5], lsr_val[6]), UVM_MEDIUM)

      if (lsr_val[5] && lsr_val[6]) begin
        pass_count++;
        `uvm_info("BAUD_DIV", $sformatf("Divisor %0d: TX completed OK", i), UVM_LOW)
      end else begin
        fail_count++;
        `uvm_error("BAUD_DIV", $sformatf("Divisor %0d: TX stuck after write (LSR=0x%02h)", i, lsr_val))
      end
    end

    lcr_val[7] = 1'b0;
    write_reg({{ addr_bits }}'h03, lcr_val);

    `uvm_info("BAUD_DIV", $sformatf("=== Baud Divisor: %0d pass, %0d fail ===",
              pass_count, fail_count), UVM_LOW)
    if (fail_count > 0)
      `uvm_error("BAUD_DIV", $sformatf("%0d divisor verification(s) failed", fail_count))
  endtask
endclass
{% endif %}

// =========================================================================
// UART DLAB Switching Test — toggles LCR[7] to verify DLL/DLH vs THR/IER
// aliasing works correctly per 16550 specification.
// Requires: LCR (0x03), DLL/THR (0x00), DLH/IER (0x01)
// =========================================================================
{% if ('0x00' in _reg_addr_set or '0x0' in _reg_addr_set) and ('0x01' in _reg_addr_set or '0x1' in _reg_addr_set) and ('0x03' in _reg_addr_set or '0x3' in _reg_addr_set) %}
class {{ spec.design_name }}_dlab_switching_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_dlab_switching_seq)

  int pass_count;
  int fail_count;

  function new(string n = "{{ spec.design_name }}_dlab_switching_seq");
    super.new(n);
  endfunction

  task body;
    logic [7:0] lcr_val;
    logic [7:0] val0, val1;

    `uvm_info("DLAB_SW", "=== DLAB Bit Switching Test ===", UVM_LOW)

    // 1. With DLAB=0, write to THR (0x00) and IER (0x01)
    read_reg({{ addr_bits }}'h03, lcr_val);
    lcr_val[7] = 1'b0;
    write_reg({{ addr_bits }}'h03, lcr_val);
    repeat(5) @(posedge vif.clk);

    write_reg({{ addr_bits }}'h00, 8'hA5);
    write_reg({{ addr_bits }}'h01, 8'h0F);
    repeat(5) @(posedge vif.clk);

    // 2. Set DLAB=1, read DLL/DLH, verify they are NOT 0xA5/0x0F
    read_reg({{ addr_bits }}'h03, lcr_val);
    lcr_val[7] = 1'b1;
    write_reg({{ addr_bits }}'h03, lcr_val);
    repeat(5) @(posedge vif.clk);

    read_reg({{ addr_bits }}'h00, val0);
    read_reg({{ addr_bits }}'h01, val1);

    if (val0 == 8'hA5) begin
      fail_count++;
      `uvm_error("DLAB_SW", $sformatf("DLL=0x%02h matches THR write — aliasing failure", val0))
    end else begin
      pass_count++;
      `uvm_info("DLAB_SW", $sformatf("DLL=0x%02h differs from THR — correct", val0), UVM_LOW)
    end

    if (val1 == 8'h0F) begin
      fail_count++;
      `uvm_error("DLAB_SW", $sformatf("DLH=0x%02h matches IER write — aliasing failure", val1))
    end else begin
      pass_count++;
      `uvm_info("DLAB_SW", $sformatf("DLH=0x%02h differs from IER — correct", val1), UVM_LOW)
    end

    // Restore DLAB=0
    read_reg({{ addr_bits }}'h03, lcr_val);
    lcr_val[7] = 1'b0;
    write_reg({{ addr_bits }}'h03, lcr_val);

    `uvm_info("DLAB_SW", $sformatf("=== DLAB Switching: %0d pass, %0d fail ===",
              pass_count, fail_count), UVM_LOW)
    if (fail_count > 0)
      `uvm_error("DLAB_SW", $sformatf("%0d aliasing check(s) failed", fail_count))
  endtask
endclass
{% endif %}

// =========================================================================
// UART THR/RBR Alias Test — verifies that reading 0x00 with DLAB=0
// returns RBR (receiver buffer), not THR (transmit holding).
// Requires: THR/RBR (0x00), LCR (0x03), LSR (0x05)
// =========================================================================
{% if ('0x00' in _reg_addr_set or '0x0' in _reg_addr_set) and ('0x03' in _reg_addr_set or '0x3' in _reg_addr_set) and ('0x05' in _reg_addr_set or '0x5' in _reg_addr_set) %}
class {{ spec.design_name }}_thr_rbr_alias_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_thr_rbr_alias_seq)

  int pass_count;
  int fail_count;

  function new(string n = "{{ spec.design_name }}_thr_rbr_alias_seq");
    super.new(n);
  endfunction

  task body;
    logic [7:0] lcr_val;
    logic [7:0] rd_val;
    logic [7:0] lsr_val;

    `uvm_info("RBR_ALIAS", "=== THR/RBR Alias Verification ===", UVM_LOW)

    // 1. Write a known pattern to THR (DLAB=0, addr 0x00)
    read_reg({{ addr_bits }}'h03, lcr_val);
    lcr_val[7] = 1'b0;
    write_reg({{ addr_bits }}'h03, lcr_val);
    repeat(5) @(posedge vif.clk);

    write_reg({{ addr_bits }}'h00, 8'hA5);
    repeat(100) @(posedge vif.clk);

    // 2. Immediately read back same address — should NOT return 0xA5
    read_reg({{ addr_bits }}'h00, rd_val);
    read_reg({{ addr_bits }}'h05, lsr_val);

    if (rd_val == 8'hA5 && !lsr_val[0]) begin
      fail_count++;
      `uvm_error("RBR_ALIAS", $sformatf("Read back 0x%02h = THR value (RBR not separate)", rd_val))
    end else begin
      pass_count++;
      `uvm_info("RBR_ALIAS", $sformatf("Read returned 0x%02h (LSR.DR=%0d) — RBR/THR correctly aliased",
                rd_val, lsr_val[0]), UVM_LOW)
    end

    `uvm_info("RBR_ALIAS", $sformatf("=== THR/RBR Alias: %0d pass, %0d fail ===",
              pass_count, fail_count), UVM_LOW)
    if (fail_count > 0)
      `uvm_error("RBR_ALIAS", "THR/RBR alias check FAILED — read returns write data")
  endtask
endclass
{% endif %}

// =========================================================================
// UART Interrupt Priority Verification — asserts multiple interrupt
// sources simultaneously, verifies IIR priority encoding per 16550 spec:
//   1=LSR, 2=RX Data, 3=TX Empty
// Requires: IER (0x01), IIR (0x02), LCR (0x03), MCR (0x04), THR (0x00)
// =========================================================================
{% if ('0x01' in _reg_addr_set or '0x1' in _reg_addr_set) and ('0x02' in _reg_addr_set or '0x2' in _reg_addr_set) and ('0x04' in _reg_addr_set or '0x4' in _reg_addr_set) and ('0x00' in _reg_addr_set or '0x0' in _reg_addr_set) and ('0x03' in _reg_addr_set or '0x3' in _reg_addr_set) %}
class {{ spec.design_name }}_interrupt_priority_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_interrupt_priority_seq)

  int priority_order[3] = '{3'b100, 3'b010, 3'b001};
  string priority_names[3] = '{"RX Data", "TX Empty", "Line Status"};
  int pass_count;
  int fail_count;

  function new(string n = "{{ spec.design_name }}_interrupt_priority_seq");
    super.new(n);
  endfunction

  task body;
    logic [7:0] ier_val;
    logic [7:0] iir_val;
    logic [7:0] mcr_val;
    logic [7:0] lcr_val;

    `uvm_info("INT_PRIO", "=== Interrupt Priority Verification ===", UVM_LOW)

    // Enable loopback
    read_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);
    mcr_val[4] = 1'b1;
    write_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);

    // Test: Enable all interrupts, trigger multiple, verify priority
    ier_val = 8'h0F;  // Enable all 4 interrupt types
    write_reg({{ spec.design_name|upper }}_IER_ADDR, ier_val);
    repeat(5) @(posedge vif.clk);

    // Trigger line status (parity error)
    read_reg({{ addr_bits }}'h03, lcr_val);
    lcr_val[3] = 1'b1;
    lcr_val[4] = 1'b1;
    write_reg({{ addr_bits }}'h03, lcr_val);
    repeat(5) @(posedge vif.clk);
    write_reg({{ spec.design_name|upper }}_THR_ADDR, 8'hA5);
    repeat(500) @(posedge vif.clk);

    // Trigger RX data via loopback
    write_reg({{ spec.design_name|upper }}_THR_ADDR, 8'h55);
    repeat(500) @(posedge vif.clk);

    // Read IIR — should show highest priority pending
    read_reg({{ spec.design_name|upper }}_IIR_ADDR, iir_val);

    if (!iir_val[0]) begin
      `uvm_info("INT_PRIO", $sformatf("IIR=0x%02h cause=%b", iir_val, iir_val[3:1]), UVM_LOW)
      if (iir_val[3:1] == 3'b100) begin
        pass_count++;
        `uvm_info("INT_PRIO", "Priority 1 (Line Status) correct — highest priority", UVM_LOW)
      end else begin
        fail_count++;
        `uvm_warning("INT_PRIO", $sformatf("Expected priority 1 (LSR), got cause=%b", iir_val[3:1]))
      end
    end else begin
      fail_count++;
      `uvm_warning("INT_PRIO", "No interrupt pending when multiple sources active")
    end

    // Disable loopback, restore LCR
    read_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);
    mcr_val[4] = 1'b0;
    write_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);
    read_reg({{ addr_bits }}'h03, lcr_val);
    lcr_val[3] = 1'b0;
    write_reg({{ addr_bits }}'h03, lcr_val);

    `uvm_info("INT_PRIO", $sformatf("=== Interrupt Priority: %0d pass, %0d fail ===",
              pass_count, fail_count), UVM_LOW)
    if (fail_count > 0)
      `uvm_error("INT_PRIO", "Interrupt priority verification FAILED")
  endtask
endclass
{% endif %}

// =========================================================================
// UART FIFO Reset Verification — asserts FCR bit 1 (RCVR FIFO reset)
// and bit 2 (XMIT FIFO reset), verifies FIFOs are cleared by writing
// then resetting and checking emptiness.
// Requires: FCR (0x02), THR (0x00), LSR (0x05)
// =========================================================================
{% if ('0x02' in _reg_addr_set or '0x2' in _reg_addr_set) and ('0x00' in _reg_addr_set or '0x0' in _reg_addr_set) and ('0x05' in _reg_addr_set or '0x5' in _reg_addr_set) %}
class {{ spec.design_name }}_fifo_reset_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_fifo_reset_seq)

  int pass_count;
  int fail_count;

  function new(string n = "{{ spec.design_name }}_fifo_reset_seq");
    super.new(n);
  endfunction

  task body;
    logic [7:0] fcr_val;
    logic [7:0] lsr_val;

    `uvm_info("FIFO_RST", "=== FIFO Reset Verification ===", UVM_LOW)

    // Enable FIFO and fill TX FIFO (FCR=0x01: enable only, no reset)
    fcr_val = 8'b000_00_001;
    write_reg({{ spec.design_name|upper }}_FCR_ADDR, fcr_val);
    repeat(10) @(posedge vif.clk);

    for (int i = 0; i < 16; i++) begin
      write_reg({{ spec.design_name|upper }}_THR_ADDR, 8'hA0 + i);
      repeat(50) @(posedge vif.clk);
    end

    read_reg({{ spec.design_name|upper }}_LSR_ADDR, lsr_val);
    `uvm_info("FIFO_RST", $sformatf("After fill: LSR=0x%02h THRE=%0d TEMT=%0d",
              lsr_val, lsr_val[5], lsr_val[6]), UVM_MEDIUM)

    // Assert XMIT FIFO reset (FCR bit 2)
    fcr_val = 8'b000_00_100;
    write_reg({{ spec.design_name|upper }}_FCR_ADDR, fcr_val);
    repeat(10) @(posedge vif.clk);

    read_reg({{ spec.design_name|upper }}_LSR_ADDR, lsr_val);
    if (lsr_val[5] && lsr_val[6]) begin
      pass_count++;
      `uvm_info("FIFO_RST", "XMIT FIFO reset: THRE/TEMT set after reset — PASS", UVM_LOW)
    end else begin
      fail_count++;
      `uvm_error("FIFO_RST", $sformatf("XMIT FIFO reset: THRE=%0d TEMT=%0d after reset (expected 1,1)",
                 lsr_val[5], lsr_val[6]))
    end

    // Re-enable FIFO, verify empty
    fcr_val = 8'b000_00_001;
    write_reg({{ spec.design_name|upper }}_FCR_ADDR, fcr_val);
    repeat(10) @(posedge vif.clk);

    `uvm_info("FIFO_RST", $sformatf("=== FIFO Reset: %0d pass, %0d fail ===",
              pass_count, fail_count), UVM_LOW)
    if (fail_count > 0)
      `uvm_error("FIFO_RST", $sformatf("%0d FIFO reset check(s) failed", fail_count))
  endtask
endclass
{% endif %}

// =========================================================================
// UART Modem Status Register Test — verifies MSR delta bits and modem
// signal loopback via MCR[4] (loopback mode).
// Requires: MCR (0x04), MSR (0x06)
// =========================================================================
{% if ('0x04' in _reg_addr_set or '0x4' in _reg_addr_set) and ('0x06' in _reg_addr_set or '0x6' in _reg_addr_set) %}
class {{ spec.design_name }}_modem_status_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_modem_status_seq)

  int pass_count;
  int fail_count;

  function new(string n = "{{ spec.design_name }}_modem_status_seq");
    super.new(n);
  endfunction

  task body;
    logic [7:0] mcr_val;
    logic [7:0] msr_val;

    `uvm_info("MOD_STAT", "=== Modem Status Register Test ===", UVM_LOW)

    // Enable loopback
    read_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);
    mcr_val[4] = 1'b1;
    write_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);
    repeat(5) @(posedge vif.clk);

    // Read initial MSR to clear delta bits
    read_reg({{ spec.design_name|upper }}_MSR_ADDR, msr_val);
    `uvm_info("MOD_STAT", $sformatf("Initial MSR=0x%02h", msr_val), UVM_MEDIUM)

    // Toggle DTR (MCR[0]) → expect DSR (MSR[5]) and delta DSR (MSR[2])
    read_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);
    mcr_val[0] = 1'b1;
    write_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);
    repeat(5) @(posedge vif.clk);
    read_reg({{ spec.design_name|upper }}_MSR_ADDR, msr_val);
    if (msr_val[5]) begin pass_count++; `uvm_info("MOD_STAT", "DSR(MSR[5])=1 after DTR=1 PASS", UVM_MEDIUM); end
    else begin fail_count++; `uvm_error("MOD_STAT", "DSR(MSR[5])=0 after DTR=1 FAIL"); end
    if (msr_val[2]) begin pass_count++; `uvm_info("MOD_STAT", "Delta DSR(MSR[2])=1 after change PASS", UVM_MEDIUM); end

    // Toggle RTS (MCR[1]) → expect CTS (MSR[4]) and delta CTS (MSR[0])
    read_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);
    mcr_val[1] = 1'b1;
    write_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);
    repeat(5) @(posedge vif.clk);
    read_reg({{ spec.design_name|upper }}_MSR_ADDR, msr_val);
    if (msr_val[4]) begin pass_count++; `uvm_info("MOD_STAT", "CTS(MSR[4])=1 after RTS=1 PASS", UVM_MEDIUM); end
    else begin fail_count++; `uvm_error("MOD_STAT", "CTS(MSR[4])=0 after RTS=1 FAIL"); end
    if (msr_val[0]) begin pass_count++; `uvm_info("MOD_STAT", "Delta CTS(MSR[0])=1 PASS", UVM_MEDIUM); end

    // Verify OUT1/MCR[2] maps to RI/MSR[6]
    read_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);
    mcr_val[2] = 1'b1;
    write_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);
    repeat(5) @(posedge vif.clk);
    read_reg({{ spec.design_name|upper }}_MSR_ADDR, msr_val);
    if (msr_val[6]) begin pass_count++; `uvm_info("MOD_STAT", "RI(MSR[6])=1 after OUT1=1 PASS", UVM_MEDIUM); end
    else begin fail_count++; `uvm_warning("MOD_STAT", "RI(MSR[6])=0 after OUT1=1 — may not be supported"); end

    // Disable loopback
    read_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);
    mcr_val[4] = 1'b0;
    write_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);

    `uvm_info("MOD_STAT", $sformatf("=== Modem Status: %0d pass, %0d fail ===",
              pass_count, fail_count), UVM_LOW)
    if (fail_count > 0)
      `uvm_error("MOD_STAT", $sformatf("%0d modem status check(s) failed", fail_count))
  endtask
endclass
{% endif %}

// =========================================================================
// UART Concurrent TX/RX Stress — simultaneous transmit and receive
// with aggressive back-to-back byte interleaving in loopback mode.
// Requires: MCR (0x04), THR/RBR (0x00), LSR (0x05)
// =========================================================================
{% if ('0x04' in _reg_addr_set or '0x4' in _reg_addr_set) and ('0x00' in _reg_addr_set or '0x0' in _reg_addr_set) and ('0x05' in _reg_addr_set or '0x5' in _reg_addr_set) %}
class {{ spec.design_name }}_concurrent_stress_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_concurrent_stress_seq)

  rand int num_bursts;
  rand int burst_size;
  int total_tx;
  int total_rx;
  int mismatches;

  constraint c_concurrent {
    num_bursts inside {[3:10]};
    burst_size inside {[4:16]};
  }

  function new(string n = "{{ spec.design_name }}_concurrent_stress_seq");
    super.new(n);
  endfunction

  task body;
    logic [7:0] mcr_val;

    `uvm_info("CONCUR", $sformatf("=== Concurrent TX/RX Stress: %0d bursts of %0d ===",
              num_bursts, burst_size), UVM_LOW)

    // Enable loopback
    read_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);
    mcr_val[4] = 1'b1;
    write_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);
    repeat(10) @(posedge vif.clk);

    for (int b = 0; b < num_bursts; b++) begin
      logic [7:0] burst_tx[$];
      logic [7:0] burst_rx[$];

      for (int i = 0; i < burst_size; i++) begin
        burst_tx.push_back($urandom_range(0, 255));
      end

      // Simultaneous TX burst and RX collection
      fork
        begin
          foreach (burst_tx[i]) begin
            write_reg({{ spec.design_name|upper }}_THR_ADDR, burst_tx[i]);
            if (sb_handle != null) sb_handle.record_tx({{ spec.design_name|upper }}_THR_ADDR, burst_tx[i]);
            total_tx++;
            repeat(10) @(posedge vif.clk);
          end
        end
        begin
          int poll_timeout = burst_size * 200;
          while (burst_rx.size() < burst_size && poll_timeout > 0) begin
            logic [7:0] lsr_val;
            logic [7:0] rbr_val;
            read_reg({{ spec.design_name|upper }}_LSR_ADDR, lsr_val);
            if (lsr_val[0]) begin
              read_reg({{ spec.design_name|upper }}_RBR_ADDR, rbr_val);
              burst_rx.push_back(rbr_val);
              if (sb_handle != null) sb_handle.record_rx({{ spec.design_name|upper }}_RBR_ADDR, rbr_val);
              total_rx++;
            end
            @(posedge vif.clk);
            poll_timeout--;
          end
        end
      join

      // Compare burst data
      foreach (burst_tx[i]) begin
        if (i < burst_rx.size()) begin
          if (burst_tx[i] !== burst_rx[i]) begin
            mismatches++;
            `uvm_error("CONCUR", $sformatf("Burst %0d byte %0d: TX=0x%02h RX=0x%02h",
                       b, i, burst_tx[i], burst_rx[i]))
          end
        end else begin
          mismatches++;
          `uvm_error("CONCUR", $sformatf("Burst %0d byte %0d: TX=0x%02h not received", b, i, burst_tx[i]))
        end
      end

      `uvm_info("CONCUR", $sformatf("Burst %0d: %0d TX, %0d RX", b, burst_tx.size(), burst_rx.size()), UVM_MEDIUM)
    end

    // Disable loopback
    read_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);
    mcr_val[4] = 1'b0;
    write_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);

    `uvm_info("CONCUR", $sformatf(
      "=== Concurrent Stress: %0d TX, %0d RX, %0d mismatch ===",
      total_tx, total_rx, mismatches), UVM_LOW)
    if (mismatches > 0)
      `uvm_error("CONCUR", $sformatf("%0d concurrent transfer mismatch(es)", mismatches))
  endtask
endclass
{% endif %}

// =========================================================================
// UART Random Reset During Transfer — asserts reset while TX/RX is
// in progress, verifies DUT recovers cleanly.
// Requires: MCR (0x04), THR/RBR (0x00), LSR (0x05)
// =========================================================================
{% if ('0x04' in _reg_addr_set or '0x4' in _reg_addr_set) and ('0x00' in _reg_addr_set or '0x0' in _reg_addr_set) and ('0x05' in _reg_addr_set or '0x5' in _reg_addr_set) %}
class {{ spec.design_name }}_random_reset_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_random_reset_seq)

  rand int num_resets;
  int recovery_ok;

  constraint c_rst_count { num_resets inside {[2:5]}; }

  function new(string n = "{{ spec.design_name }}_random_reset_seq");
    super.new(n);
  endfunction

  task body;
    logic [7:0] mcr_val;
    logic [7:0] lsr_val;

    `uvm_info("RND_RST", $sformatf("=== Random Reset During Transfer: %0d resets ===", num_resets), UVM_LOW)

    for (int r = 0; r < num_resets; r++) begin
      // Start a transfer
      read_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);
      mcr_val[4] = 1'b1;
      write_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);

      write_reg({{ spec.design_name|upper }}_THR_ADDR, 8'hA5);
      repeat($urandom_range(5, 50)) @(posedge vif.clk);

      // Assert reset mid-transfer
      `uvm_info("RND_RST", $sformatf("Asserting reset %0d during active transfer", r), UVM_MEDIUM)
      vif.rst_n <= 1'b0;
      repeat($urandom_range(5, 15)) @(posedge vif.clk);
      vif.rst_n <= 1'b1;
      repeat(10) @(posedge vif.clk);

      // Verify recovery: check LSR THRE/TEMT
      read_reg({{ spec.design_name|upper }}_LSR_ADDR, lsr_val);
      if (lsr_val[5] && lsr_val[6]) begin
        recovery_ok++;
        `uvm_info("RND_RST", $sformatf("Reset %0d: recovery OK, LSR=0x%02h", r, lsr_val), UVM_LOW)
      end else begin
        `uvm_error("RND_RST", $sformatf("Reset %0d: recovery FAILED, LSR=0x%02h", r, lsr_val))
      end

      // Disable loopback
      read_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);
      mcr_val[4] = 1'b0;
      write_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);
    end

    `uvm_info("RND_RST", $sformatf("=== Random Reset: %0d/%0d recovered ===",
              recovery_ok, num_resets), UVM_LOW)
    if (recovery_ok < num_resets)
      `uvm_error("RND_RST", $sformatf("%0d reset(s) did not recover cleanly", num_resets - recovery_ok))
  endtask
endclass
{% endif %}

// =========================================================================
// UART Back-to-Back Interrupt Test — rapidly generates and handles
// interrupts of all types in quick succession, verifying IIR correctly
// identifies each source.
// Requires: IER (0x01), IIR (0x02), MCR (0x04), THR (0x00)
// =========================================================================
{% if ('0x01' in _reg_addr_set or '0x1' in _reg_addr_set) and ('0x02' in _reg_addr_set or '0x2' in _reg_addr_set) and ('0x04' in _reg_addr_set or '0x4' in _reg_addr_set) and ('0x00' in _reg_addr_set or '0x0' in _reg_addr_set) %}
class {{ spec.design_name }}_back2back_intr_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_back2back_intr_seq)

  rand int num_rounds;
  int total_irqs;
  int detected_irqs;
  int priority_errors;

  constraint c_rounds { num_rounds inside {[5:20]}; }

  function new(string n = "{{ spec.design_name }}_back2back_intr_seq");
    super.new(n);
  endfunction

  task body;
    logic [7:0] ier_val;
    logic [7:0] iir_val;
    logic [7:0] mcr_val;

    `uvm_info("B2B_INT", $sformatf("=== Back-to-Back Interrupt Test: %0d rounds ===", num_rounds), UVM_LOW)

    // Enable loopback
    read_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);
    mcr_val[4] = 1'b1;
    write_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);

    for (int r = 0; r < num_rounds; r++) begin
      int irq_type;
      irq_type = $urandom_range(0, 2);

      case (irq_type)
        0: begin // RX data
          ier_val = 8'h01;
          write_reg({{ spec.design_name|upper }}_IER_ADDR, ier_val);
          repeat(5) @(posedge vif.clk);
          write_reg({{ spec.design_name|upper }}_THR_ADDR, 8'h55);
          repeat(500) @(posedge vif.clk);
        end
        1: begin // TX empty
          ier_val = 8'h02;
          write_reg({{ spec.design_name|upper }}_IER_ADDR, ier_val);
          repeat(5) @(posedge vif.clk);
          write_reg({{ spec.design_name|upper }}_THR_ADDR, 8'hAA);
          repeat(500) @(posedge vif.clk);
        end
        2: begin // Line status (parity)
          ier_val = 8'h04;
          write_reg({{ spec.design_name|upper }}_IER_ADDR, ier_val);
          repeat(5) @(posedge vif.clk);
          write_reg({{ spec.design_name|upper }}_THR_ADDR, 8'hA5);
          repeat(500) @(posedge vif.clk);
        end
      endcase

      total_irqs++;
      read_reg({{ spec.design_name|upper }}_IIR_ADDR, iir_val);

      if (!iir_val[0]) begin
        detected_irqs++;
        case (irq_type)
          0: if (iir_val[3:1] != 3'b010) priority_errors++;
          1: if (iir_val[3:1] != 3'b001) priority_errors++;
          2: if (iir_val[3:1] != 3'b100) priority_errors++;
        endcase
        `uvm_info("B2B_INT", $sformatf("Round %0d type=%0d IIR=0x%02h cause=%b", r, irq_type, iir_val, iir_val[3:1]), UVM_HIGH)
      end

      // Clear pending by reading RBR / status
      if (irq_type == 0) begin
        logic [7:0] rbr_val;
        read_reg({{ spec.design_name|upper }}_RBR_ADDR, rbr_val);
      end else begin
        logic [7:0] lsr_val;
        read_reg({{ spec.design_name|upper }}_LSR_ADDR, lsr_val);
      end
      repeat(10) @(posedge vif.clk);
    end

    // Disable loopback
    read_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);
    mcr_val[4] = 1'b0;
    write_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);

    `uvm_info("B2B_INT", $sformatf(
      "=== B2B Interrupt: %0d/%0d detected, %0d priority errors ===",
      detected_irqs, total_irqs, priority_errors), UVM_LOW)
    if (priority_errors > 0)
      `uvm_error("B2B_INT", $sformatf("%0d interrupt priority mismatch(es)", priority_errors))
  endtask
endclass
{% endif %}

// =========================================================================
// UART Functional Coverage Closure — exercises all coverage cross-bins
// from coverage_collector, ensuring each coverpoint is hit at least once.
// Sweeps baud×parity, baud×data_bits, parity×stop_bits combinations.
// =========================================================================
class {{ spec.design_name }}_coverage_closure_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_coverage_closure_seq)

  int baud_list[$] = {9600, 19200, 38400, 57600, 115200, 1000000};
  int dbits_list[$] = {5, 6, 7, 8};
  int sbits_list[$] = {1, 2};
  int parity_modes[5][2] = '{'{0,0}, '{1,1}, '{1,0}, '{1,1}, '{1,0}};
  int coverage_bins[4];
  int total_bins;
  int hit_bins;

  function new(string n = "{{ spec.design_name }}_coverage_closure_seq");
    super.new(n);
    total_bins = baud_list.size() * 5 + baud_list.size() * dbits_list.size() + 5 * sbits_list.size();
  endfunction

  task body;
    {{ spec.design_name }}_config_seq cfg_seq;

    `uvm_info("COV_CLOSE", $sformatf("=== Coverage Closure: %0d combinatorial bins ===", total_bins), UVM_LOW)

    // Sweep baud × parity modes
    foreach (baud_list[b]) begin
      foreach (parity_modes[p]) begin
        if (baud_list[b] <= 115200) begin
          cfg_seq = {{ spec.design_name }}_config_seq::type_id::create($sformatf("cfg_b%0d_p%0d", b, p));
          cfg_seq.reg_model = reg_model;
          cfg_seq.baud_rate = baud_list[b];
          cfg_seq.data_bits = 8;
          cfg_seq.stop_bits = 1;
          cfg_seq.parity_en = parity_modes[p][0];
          cfg_seq.even_parity = parity_modes[p][1];
          cfg_seq.start(m_sequencer);
          hit_bins++;
          coverage_bins[0]++;
          repeat(10) @(posedge vif.clk);
        end
      end
    end

    // Sweep baud × data_bits
    foreach (baud_list[b]) begin
      foreach (dbits_list[d]) begin
        cfg_seq = {{ spec.design_name }}_config_seq::type_id::create($sformatf("cfg_b%0d_d%0d", b, d));
        cfg_seq.reg_model = reg_model;
        cfg_seq.baud_rate = baud_list[b];
        cfg_seq.data_bits = dbits_list[d];
        cfg_seq.stop_bits = 1;
        cfg_seq.parity_en = 0;
        cfg_seq.start(m_sequencer);
        hit_bins++;
        coverage_bins[1]++;
        repeat(10) @(posedge vif.clk);
      end
    end

    // Sweep parity × stop_bits
    foreach (parity_modes[p]) begin
      foreach (sbits_list[s]) begin
        cfg_seq = {{ spec.design_name }}_config_seq::type_id::create($sformatf("cfg_p%0d_s%0d", p, s));
        cfg_seq.reg_model = reg_model;
        cfg_seq.baud_rate = 115200;
        cfg_seq.data_bits = 8;
        cfg_seq.stop_bits = sbits_list[s];
        cfg_seq.parity_en = parity_modes[p][0];
        cfg_seq.even_parity = parity_modes[p][1];
        cfg_seq.start(m_sequencer);
        hit_bins++;
        coverage_bins[2]++;
        repeat(10) @(posedge vif.clk);
      end
    end

    `uvm_info("COV_CLOSE", $sformatf(
      "\n  === Coverage Closure Report ==="
      "\n  Baud×Parity bins:    %0d"
      "\n  Baud×DataBits bins:  %0d"
      "\n  Parity×StopBits bins:%0d"
      "\n  Total bins hit:      %0d/%0d",
      coverage_bins[0], coverage_bins[1], coverage_bins[2], hit_bins, total_bins), UVM_LOW)

    if (hit_bins < total_bins)
      `uvm_warning("COV_CLOSE", $sformatf("Coverage closure incomplete: %0d/%0d bins hit", hit_bins, total_bins))
    else
      `uvm_info("COV_CLOSE", "Full coverage closure achieved!", UVM_LOW)
  endtask
endclass

// -------------------------------------------------------------------------
// UART Illegal Access Sequence — writes/reads to reserved register addresses
// -------------------------------------------------------------------------
class {{ spec.design_name }}_uart_illegal_access_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_uart_illegal_access_seq)

  int illegal_ops;
  int errors_detected;

  function new(string n = "{{ spec.design_name }}_uart_illegal_access_seq");
    super.new(n);
  endfunction

  task body;
    logic [7:0] readback;
    logic [{{ addr_bits-1 }}:0] legal_addrs[$];
    logic [{{ addr_bits-1 }}:0] illegal_addrs[$];

    `uvm_info("UART_ILL", "Starting UART illegal access test", UVM_LOW)

    begin
      uvm_reg rglist[$];
      reg_model.get_registers(rglist);
      foreach (rglist[i]) begin
        legal_addrs.push_back(rglist[i].get_address());
      end
    end

    // Generate illegal addresses: the complement of legal addresses in the
    // {{ addr_bits }}-bit address space, capped at a reasonable number.
    for (int a = 0; a < (1 << {{ addr_bits }}); a++) begin
      if (!(a inside {legal_addrs}))
        illegal_addrs.push_back({{ addr_bits }}'(a));
      if (illegal_addrs.size() >= 8) break;
    end

    if (illegal_addrs.size() == 0) begin
      `uvm_info("UART_ILL", "No illegal addresses found — address space fully populated", UVM_LOW)
      return;
    end

    foreach (illegal_addrs[i]) begin
      // Write to reserved address
      write_reg(illegal_addrs[i], 8'hA5);
      illegal_ops++;

      // Read back — reserved addresses should return 0 or x
      read_reg(illegal_addrs[i], readback);
      `uvm_info("UART_ILL", $sformatf("Illegal addr 0x%0h: readback=0x%02h",
                illegal_addrs[i], readback), UVM_MEDIUM)

      // Verify no corruption of legal register state
      foreach (legal_addrs[j]) begin
        logic [7:0] legal_val;
        read_reg(legal_addrs[j], legal_val);
        if (legal_val !== 8'h0) begin
          `uvm_info("UART_ILL", $sformatf("Legal addr 0x%0h intact: 0x%02h",
                    legal_addrs[j], legal_val), UVM_HIGH)
        end
      end
    end

    `uvm_info("UART_ILL", $sformatf("Illegal access test: %0d operations, %0d errors",
              illegal_ops, errors_detected), UVM_LOW)
  endtask
endclass

{% endif %}

