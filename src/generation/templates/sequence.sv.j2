class {{ spec.design_name }}_apb_wait_state_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_apb_wait_state_seq)

  rand int idle_delay;
  rand int completed;
  rand int errors;

  constraint c_ws {
    idle_delay inside {[0:15]};
  }

  function new(string n = "{{ spec.design_name }}_apb_wait_state_seq");
    super.new(n);
