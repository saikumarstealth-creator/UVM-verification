// -------------------------------------------------------------------------
// UART Coverage Sweep Sequence — exercises config coverage groups
// -------------------------------------------------------------------------
class {{ spec.design_name }}_cov_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_cov_seq)

  rand int baud_vals[];
  rand int dbits_vals[];
  rand int sbits_vals[];

  int total_configs;
  int total_tx;

  constraint c_cov_vals {
    baud_vals.size() inside {[1:8]};
    dbits_vals.size() inside {[1:4]};
    sbits_vals.size() inside {[1:2]};
    foreach (baud_vals[i]) baud_vals[i] inside {9600, 19200, 38400, 57600, 115200, 1000000};
    foreach (dbits_vals[i]) dbits_vals[i] inside {5, 6, 7, 8};
    foreach (sbits_vals[i]) sbits_vals[i] inside {1, 2};
  }

  function new(string n = "{{ spec.design_name }}_cov_seq");
    super.new(n);
  endfunction

  task body;
    {{ spec.design_name }}_config_seq cfg_seq;
    {{ spec.design_name }}_tx_seq     tx_seq;

    `uvm_info("COV_SEQ", "Starting coverage sweep", UVM_LOW)

    foreach (baud_vals[i]) begin
      foreach (dbits_vals[j]) begin
        foreach (sbits_vals[k]) begin
          cfg_seq = {{ spec.design_name }}_config_seq::type_id::create($sformatf("cfg_seq_b%0d_d%0d_s%0d", i, j, k));
          cfg_seq.reg_model = reg_model;
          cfg_seq.baud_rate = baud_vals[i];
          cfg_seq.data_bits = dbits_vals[j];
          cfg_seq.stop_bits = sbits_vals[k];
          cfg_seq.start(m_sequencer);
          total_configs++;

          repeat(100) @(posedge vif.clk);
          tx_seq = {{ spec.design_name }}_tx_seq::type_id::create($sformatf("tx_seq_b%0d_d%0d_s%0d", i, j, k));
          tx_seq.reg_model = reg_model;
          tx_seq.num_bytes = 4;
          if (!tx_seq.randomize()) `uvm_fatal("RAND", "TX seq randomization failed")
          tx_seq.start(m_sequencer);
          total_tx++;
        end
      end
    end

    `uvm_info("COV_SEQ", $sformatf(
      "Coverage sweep complete: %0d configs, %0d TX bursts", total_configs, total_tx), UVM_LOW)
  endtask
endclass

// -------------------------------------------------------------------------
// UART Break Sequence — sets break condition, verifies LSR.BI
// -------------------------------------------------------------------------
class {{ spec.design_name }}_break_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_break_seq)

  int break_detected;

  function new(string n = "{{ spec.design_name }}_break_seq");
    super.new(n);
  endfunction

  task body;
    logic [7:0] lcr_val, lsr_val;

    `uvm_info("BREAK_SEQ", "Starting break condition test", UVM_LOW)

    // Read current LCR
    read_reg({{ addr_bits }}'h03, lcr_val);

    // Set break enable (LCR[6] = 1) — hold for multiple frame times
    write_reg({{ addr_bits }}'h03, lcr_val | 8'h40);
    `uvm_info("BREAK_SEQ", "Break condition asserted (LCR[6]=1)", UVM_LOW)
    #200000;

    // Poll LSR for BI (bit 4) with timeout
    begin
      int poll;
      do begin
        read_reg({{ addr_bits }}'h05, lsr_val);
        poll++;
        #10000;
        if (poll > 50) break;
      end while (!lsr_val[4]);
      if (lsr_val[4]) begin
        break_detected++;
        `uvm_info("BREAK_SEQ", $sformatf("Break Interrupt (LSR[4]) detected after %0d polls", poll), UVM_LOW)
      end else begin
        `uvm_warning("BREAK_SEQ", "Break Interrupt NOT detected within timeout")
      end
    end

    // Clear break (LCR[6] = 0)
    write_reg({{ addr_bits }}'h03, lcr_val & ~8'h40);
    `uvm_info("BREAK_SEQ", "Break condition de-asserted", UVM_LOW)
    #100000;

    if (break_detected == 0)
      `uvm_error("BREAK_SEQ", "Break test FAILED — no break detected")
    else
      `uvm_info("BREAK_SEQ", "Break test PASSED", UVM_LOW)

    if (sb_handle != null) sb_handle.record_error("break", break_detected);
  endtask
endclass

// -------------------------------------------------------------------------
// UART Overrun Sequence — TX flood in loopback, verify LSR.OE
// -------------------------------------------------------------------------
class {{ spec.design_name }}_overrun_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_overrun_seq)

  int overrun_detected;
  int tx_count;

  function new(string n = "{{ spec.design_name }}_overrun_seq");
    super.new(n);
  endfunction

  task body;
    logic [7:0] mcr_val, lsr_val;

    `uvm_info("OVR_SEQ", "Starting overrun test — TX flood in loopback", UVM_LOW)

    // Configure UART
    {{ spec.design_name }}_config_seq cfg_seq;
    cfg_seq = {{ spec.design_name }}_config_seq::type_id::create("cfg_seq");
    cfg_seq.reg_model = reg_model;
    cfg_seq.baud_rate = 115200;
    cfg_seq.data_bits = 8;
    cfg_seq.stop_bits = 1;
    cfg_seq.start(m_sequencer);

    // Enable loopback (MCR[4] = 1)
    read_reg({{ addr_bits }}'h04, mcr_val);
    write_reg({{ addr_bits }}'h04, mcr_val | 8'h10);
    `uvm_info("OVR_SEQ", "Loopback enabled (MCR[4]=1)", UVM_LOW)

    // Flood TX without reading RBR to cause overrun (writes are faster than serial TX)
    for (int i = 0; i < 20; i++) begin
      write_reg({{ addr_bits }}'h00, 8'($urandom_range(0, 255)));
      tx_count++;
      @(posedge vif.clk);
    end

    // Wait for loopback data to arrive at RX (at 115200: ~87us/byte, 16 bytes ~1.4ms)
    #200000;

    // Poll LSR for overrun (OE = bit 1) with timeout
    begin
      int poll;
      do begin
        read_reg({{ addr_bits }}'h05, lsr_val);
        poll++;
        #10000;
        if (poll > 100) break;
      end while (!lsr_val[1]);
      if (lsr_val[1]) begin
        overrun_detected++;
        `uvm_info("OVR_SEQ", $sformatf("Overrun (LSR[1]) detected after %0d TX, %0d polls", tx_count, poll), UVM_LOW)
      end else begin
        `uvm_warning("OVR_SEQ", "No overrun detected — may need more TX or faster baud")
      end
    end

    // Read RBR to clear overrun condition
    write_reg({{ addr_bits }}'h00, 8'h00);
    read_reg({{ addr_bits }}'h00, lsr_val);

    // Disable loopback
    write_reg({{ addr_bits }}'h04, mcr_val & ~8'h10);

    if (overrun_detected == 0)
      `uvm_warning("OVR_SEQ", "Overrun test: no overrun observed (DUT-dependent)")
    else
      `uvm_info("OVR_SEQ", "Overrun test PASSED", UVM_LOW)

    if (sb_handle != null) sb_handle.record_error("overrun", overrun_detected);
  endtask
endclass

// -------------------------------------------------------------------------
// UART Stress Sequence — runs random configs and transactions repeatedly
// -------------------------------------------------------------------------
class {{ spec.design_name }}_stress_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_stress_seq)

  rand int num_iterations;
  int total_tx;
  int total_errors;

  constraint c_stress { num_iterations inside {[10:50]}; }

  function new(string n = "{{ spec.design_name }}_stress_seq");
    super.new(n);
  endfunction

  task body;
    `uvm_info("STRESS_SEQ", $sformatf("Starting stress: %0d iterations", num_iterations), UVM_LOW)

    for (int iter = 0; iter < num_iterations; iter++) begin
      {{ spec.design_name }}_random_seq rand_seq;
      rand_seq = {{ spec.design_name }}_random_seq::type_id::create($sformatf("rand_seq_%0d", iter));
      rand_seq.reg_model = reg_model;
      if (!rand_seq.randomize()) begin
        `uvm_error("STRESS_SEQ", $sformatf("Randomization failed at iteration %0d", iter))
        total_errors++;
      end else begin
        rand_seq.start(m_sequencer);
        total_tx += rand_seq.tx_count;
      end
    end

    `uvm_info("STRESS_SEQ", $sformatf(
      "Stress complete: %0d iterations, %0d TX, %0d errors",
      num_iterations, total_tx, total_errors), UVM_LOW)
  endtask
