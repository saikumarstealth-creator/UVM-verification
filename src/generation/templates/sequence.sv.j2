    super.new(n);
  endfunction

  task body;
    logic [7:0] cfg_val;
    cfg_val = {4'b0, inject_slave_err, 3'b0, wait_states[2:0]};
    `uvm_info("APB_CFG", $sformatf(
      "Configuring slave: wait_states=%0d, slave_err=%0d, cfg_val=0x%02h",
      wait_states, inject_slave_err, cfg_val), UVM_LOW)
    write_reg(0, cfg_val);
  endtask
