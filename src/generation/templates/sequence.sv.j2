{% endif %}
{% if spec.coverage.coverpoints.get('data_bits') %}    foreach (dbits_vals[i]) dbits_vals[i] inside { {% for d in spec.coverage.coverpoints.data_bits %}{{ d }}{% if not loop.last %}, {% endif %}{% endfor %} };
{% endif %}
{% if spec.coverage.coverpoints.get('stop_bits') %}    foreach (sbits_vals[i]) sbits_vals[i] inside { {% for s in spec.coverage.coverpoints.stop_bits %}{{ s }}{% if not loop.last %}, {% endif %}{% endfor %} };
{% endif %}
{% endif %}  }

  function new(string n = "{{ spec.design_name }}_cov_seq");
