// Enhanced UVM Sequences for {{ spec.design_name }} ({{ spec.protocol|default("wishbone", true) }})
// Includes: RAL-based sequences, UART TX/RX, baud config, interrupt tests
{% set p = spec.protocol|default("wishbone") %}

class {{ spec.design_name }}_base_seq extends uvm_sequence #({{ spec.design_name }}_seq_item);
  `uvm_object_utils({{ spec.design_name }}_base_seq)

  {{ spec.design_name }}_reg_block       reg_model;
  {{ spec.design_name }}_scoreboard      sb_handle;

  function new(string n = "{{ spec.design_name }}_base_seq");
    super.new(n);
  endfunction

  virtual task pre_body();
    if (sb_handle == null) begin
      uvm_config_db #({{ spec.design_name }}_scoreboard)::get(null, "uvm_test_top.env", "sb", sb_handle);
    end
  endtask

  task body;
    `uvm_info("SEQ", "Starting base sequence", UVM_MEDIUM)
  endtask
endclass

class {{ spec.design_name }}_write_reg_seq extends uvm_sequence #({{ spec.design_name }}_seq_item});
  `uvm_object_utils({{ spec.design_name }}_write_reg_seq)

  rand logic [2:0] reg_addr;
  rand logic [7:0] write_data;

  constraint c_reg_addr { reg_addr inside {0,1,2,3,4,5,6,7}; }

  function new(string n = "{{ spec.design_name }}_write_reg_seq");
    super.new(n);
  endfunction

  task body;
    req = {{ spec.design_name }}_seq_item::type_id::create("req");
    start_item(req);
    assert(req.randomize() with { we == 1; addr == reg_addr; data == write_data; delay == 0; });
    finish_item(req);
    `uvm_info("SEQ", $sformatf("Write reg[0x%0h] = 0x%0h", reg_addr, write_data), UVM_MEDIUM)
  endtask
endclass

class {{ spec.design_name }}_read_reg_seq extends uvm_sequence #({{ spec.design_name }}_seq_item);
  `uvm_object_utils({{ spec.design_name }}_read_reg_seq)

  rand logic [2:0] reg_addr;
  logic [7:0] read_data;

  constraint c_reg_addr { reg_addr inside {0,1,2,3,4,5,6,7}; }

  function new(string n = "{{ spec.design_name }}_read_reg_seq");
    super.new(n);
  endfunction

  task body;
    req = {{ spec.design_name }}_seq_item::type_id::create("req");
    start_item(req);
    assert(req.randomize() with { we == 0; addr == reg_addr; delay == 0; });
    finish_item(req);
    read_data = req.data;
    `uvm_info("SEQ", $sformatf("Read reg[0x%0h] => 0x%0h", reg_addr, read_data), UVM_MEDIUM)
  endtask
endclass

class {{ spec.design_name }}_all_regs_seq extends uvm_sequence #({{ spec.design_name }}_seq_item);
  `uvm_object_utils({{ spec.design_name }}_all_regs_seq)

  function new(string n = "{{ spec.design_name }}_all_regs_seq");
    super.new(n);
  endfunction

  task body;
    for (int i = 0; i < 8; i++) begin
      {{ spec.design_name }}_write_reg_seq wseq;
      {{ spec.design_name }}_read_reg_seq  rseq;
      wseq = {{ spec.design_name }}_write_reg_seq::type_id::create("wseq");
      rseq = {{ spec.design_name }}_read_reg_seq::type_id::create("rseq");
      assert(wseq.randomize() with { reg_addr == i; write_data == (i*16+5); });
      wseq.start(m_sequencer);
      rseq = {{ spec.design_name }}_read_reg_seq::type_id::create("rseq");
      assert(rseq.randomize() with { reg_addr == i; });
      rseq.start(m_sequencer);
    end
  endtask
endclass

class uart_random_regs_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils(uart_random_regs_seq)

  rand logic [7:0] write_data[8];
  rand bit         pattern_type;

  constraint c_patterns {
    if (pattern_type == 0) {
      foreach (write_data[i]) write_data[i] == (i * 32 + 5);
    } else {
      foreach (write_data[i]) write_data[i] inside {
        8'h00, 8'h01, 8'h02, 8'h04, 8'h08, 8'h10, 8'h20, 8'h40, 8'h80, 8'hFF,
        8'hAA, 8'h55, 8'hCC, 8'h33, 8'hFE, 8'hFD, 8'hFB, 8'hF7, 8'hEF, 8'hDF,
        8'hBF, 8'h7F, 8'h11, 8'h22, 8'h44, 8'h88, 8'h66, 8'h99, 8'hBB, 8'hDD
      };
    }
  }

  function new(string n = "uart_random_regs_seq");
    super.new(n);
    pattern_type = 1;
  endfunction

  task body;
    for (int i = 0; i < 8; i++) begin
      {{ spec.design_name }}_write_reg_seq wseq;
      {{ spec.design_name }}_read_reg_seq  rseq;
      wseq = {{ spec.design_name }}_write_reg_seq::type_id::create("wseq");
      assert(wseq.randomize() with { reg_addr == i; write_data == local::write_data[i]; });
      `uvm_info("SEQ_RAND", $sformatf("Randomized write[%0d]: addr=0x%0h data=0x%02h",
                i, i, write_data[i]), UVM_HIGH)
      wseq.start(m_sequencer);
      rseq = {{ spec.design_name }}_read_reg_seq::type_id::create("rseq");
      assert(rseq.randomize() with { reg_addr == i; });
      rseq.start(m_sequencer);
    end
  endtask
endclass

{% if p == "uart" %}

class uart_config_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils(uart_config_seq)

  rand int baud_rate;
  rand int data_bits;
  rand int stop_bits;
  rand bit parity_en;
  rand bit even_parity;

  constraint c_valid {
    baud_rate inside {9600, 19200, 38400, 57600, 115200};
    data_bits inside {5, 6, 7, 8};
    stop_bits inside {1, 2};
  }

  function new(string n = "uart_config_seq");
    super.new(n);
    baud_rate = 115200;
    data_bits = 8;
    stop_bits = 1;
    parity_en = 0;
    even_parity = 0;
  endfunction

  task body;
    uvm_status_e status;
    logic [7:0] lcr_val;
    logic [15:0] divisor;

    divisor = get_divisor(baud_rate);

    lcr_val[1:0] = get_wls(data_bits);
    lcr_val[2] = (stop_bits == 2) ? 1'b1 : 1'b0;
    lcr_val[3] = parity_en;
    lcr_val[4] = even_parity;
    lcr_val[7] = 1'b1;

    `uvm_info("UART_CFG", $sformatf("Configuring: Baud=%0d, Data bits=%0d, Stop bits=%0d, Parity=%0d",
              baud_rate, data_bits, stop_bits, parity_en), UVM_MEDIUM)

    if (reg_model) begin
      reg_model.lcr.write(status, lcr_val, .parent(this));
      reg_model.dll.write(status, divisor[7:0], .parent(this));
      reg_model.dlm.write(status, divisor[15:8], .parent(this));
      lcr_val[7] = 1'b0;
      reg_model.lcr.write(status, lcr_val, .parent(this));
    end else begin
      {{ spec.design_name }}_write_reg_seq wseq;
      wseq = {{ spec.design_name }}_write_reg_seq::type_id::create("wseq");
      wseq.reg_addr = 3'h3; wseq.write_data = lcr_val;
      wseq.start(m_sequencer);
      wseq = {{ spec.design_name }}_write_reg_seq::type_id::create("wseq");
      wseq.reg_addr = 3'h0; wseq.write_data = divisor[7:0];
      wseq.start(m_sequencer);
      wseq = {{ spec.design_name }}_write_reg_seq::type_id::create("wseq");
      wseq.reg_addr = 3'h1; wseq.write_data = divisor[15:8];
      wseq.start(m_sequencer);
      lcr_val[7] = 1'b0;
      wseq = {{ spec.design_name }}_write_reg_seq::type_id::create("wseq");
      wseq.reg_addr = 3'h3; wseq.write_data = lcr_val;
      wseq.start(m_sequencer);
    end
  endtask

  function logic [1:0] get_wls(int bits);
    case (bits)
      5: return 2'b00;
      6: return 2'b01;
      7: return 2'b10;
      8: return 2'b11;
      default: return 2'b11;
    endcase
  endfunction

  function logic [15:0] get_divisor(int baud);
    int clk_freq = 100_000_000;
    return (clk_freq / (16 * baud));
  endfunction
endclass

class uart_tx_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils(uart_tx_seq)

  rand logic [7:0] tx_data[$];
  int num_bytes;

  constraint c_tx_data {
    tx_data.size() == num_bytes;
    num_bytes inside {[1:32]};
  }

  function new(string n = "uart_tx_seq");
    super.new(n);
    num_bytes = 1;
  endfunction

  task body;
    uvm_status_e status;
    logic [7:0] lsr_val;

    `uvm_info("UART_TX", $sformatf("Transmitting %0d bytes: %p", num_bytes, tx_data), UVM_MEDIUM)

    for (int i = 0; i < num_bytes; i++) begin
      wait_for_tx_empty();

      if (reg_model) begin
        reg_model.rbr_thr.write(status, tx_data[i], .parent(this));
      end else begin
        {{ spec.design_name }}_write_reg_seq wseq;
        wseq = {{ spec.design_name }}_write_reg_seq::type_id::create("wseq");
        wseq.reg_addr = 3'h0;
        wseq.write_data = tx_data[i];
        wseq.start(m_sequencer);
      end
      `uvm_info("UART_TX", $sformatf("Wrote byte: 0x%02h", tx_data[i]), UVM_HIGH)
    end

    `uvm_info("UART_TX", "TX sequence complete", UVM_MEDIUM)
  endtask

  task wait_for_tx_empty();
    logic [7:0] lsr_data;
    int timeout = 10000;

    for (int i = 0; i < timeout; i++) begin
      {{ spec.design_name }}_read_reg_seq rseq;
      rseq = {{ spec.design_name }}_read_reg_seq::type_id::create("rseq");
      rseq.reg_addr = 3'h5;
      rseq.start(m_sequencer);
      if (rseq.read_data[5]) begin
        return;
      end
      @(posedge m_sequencer.vif.clk);
    end
    `uvm_error("UART_TX", "Timeout waiting for TX empty")
  endtask
endclass

class uart_rx_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils(uart_rx_seq)

  logic [7:0] rx_data[$];
  int expected_bytes = 1;
  int timeout_cycles = 100000;

  function new(string n = "uart_rx_seq");
    super.new(n);
  endfunction

  task body;
    uvm_status_e status;
    logic [7:0] lsr_val;
    int timeout_cnt = 0;

    `uvm_info("UART_RX", $sformatf("Waiting for %0d RX bytes", expected_bytes), UVM_MEDIUM)

    while (rx_data.size() < expected_bytes && timeout_cnt < timeout_cycles) begin
      if (reg_model) begin
        reg_model.lsr.read(status, lsr_val, .parent(this));
      end else begin
        {{ spec.design_name }}_read_reg_seq rseq;
        rseq = {{ spec.design_name }}_read_reg_seq::type_id::create("rseq");
        rseq.reg_addr = 3'h5;
        rseq.start(m_sequencer);
        lsr_val = rseq.read_data;
      end

      if (lsr_val[0]) begin
        logic [7:0] data;
        if (reg_model) begin
          reg_model.rbr_thr.read(status, data, .parent(this));
        end else begin
          {{ spec.design_name }}_read_reg_seq rseq2;
          rseq2 = {{ spec.design_name }}_read_reg_seq::type_id::create("rseq2");
          rseq2.reg_addr = 3'h0;
          rseq2.start(m_sequencer);
          data = rseq2.read_data;
        end
        rx_data.push_back(data);
        `uvm_info("UART_RX", $sformatf("Received byte: 0x%02h", data), UVM_HIGH)
      end else begin
        timeout_cnt++;
        @(posedge m_sequencer.vif.clk);
      end
    end

    if (timeout_cnt >= timeout_cycles) begin
      `uvm_error("UART_RX", $sformatf("Timeout! Received %0d/%0d bytes", rx_data.size(), expected_bytes))
    end
  endtask
endclass

class uart_loopback_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils(uart_loopback_seq)

  rand logic [7:0] test_data[$];
  int num_passes = 0;
  int errors = 0;
  int rx_timeout = 500000;

  constraint c_test_data {
    test_data.size() inside {[1:16]};
  }

  function new(string n = "uart_loopback_seq");
    super.new(n);
  endfunction

  task body;
    logic [7:0] mcr_val;

    `uvm_info("UART_LB", "Starting loopback test", UVM_MEDIUM)

    uart_write_reg(3'h4, 8'h1A);
    #100ns;
    uart_read_reg(3'h4, mcr_val);
    mcr_val[4] = 1'b1;
    uart_write_reg(3'h4, mcr_val);
    `uvm_info("UART_LB", "Loopback enabled (MCR[4]=1)", UVM_MEDIUM)

    foreach (test_data[i]) begin
      logic [7:0] rx_byte;
      bit received;

      uart_write_reg(3'h0, test_data[i]);
      `uvm_info("UART_LB", $sformatf("TX[%0d] = 0x%02h", i, test_data[i]), UVM_MEDIUM)

      uart_wait_for_rx(rx_byte, received);

      if (received) begin
        if (rx_byte === test_data[i]) begin
          num_passes++;
          `uvm_info("UART_LB", $sformatf("Loopback MATCH[%0d]: TX=0x%02h RX=0x%02h",
                    i, test_data[i], rx_byte), UVM_MEDIUM)
          if (sb_handle != null) sb_handle.loopback_matches++;
        end else begin
          errors++;
          `uvm_error("UART_LB", $sformatf("Loopback MISMATCH[%0d]: TX=0x%02h RX=0x%02h",
                     i, test_data[i], rx_byte))
          if (sb_handle != null) sb_handle.loopback_mismatches++;
        end
      end else begin
        errors++;
        `uvm_error("UART_LB", $sformatf("Loopback timeout[%0d]: TX=0x%02h no RX data received",
                   i, test_data[i]))
      end
    end

    mcr_val[4] = 1'b0;
    uart_write_reg(3'h4, mcr_val);
    `uvm_info("UART_LB", "Loopback disabled (MCR[4]=0)", UVM_MEDIUM)

    `uvm_info("UART_LB", $sformatf(
      "\n  === Loopback Test Results ==="
      "\n  Bytes Transmitted: %0d"
      "\n  Bytes Matched:     %0d"
      "\n  Errors:            %0d",
      test_data.size(), num_passes, errors
    ), UVM_LOW)
  endtask

  protected task uart_wait_for_rx(output logic [7:0] data, output bit received);
    int timeout = rx_timeout;
    logic [7:0] lsr_val;
    received = 0;
    while (timeout > 0 && !received) begin
      uart_read_reg(3'h5, lsr_val);
      if (lsr_val[0]) begin
        uart_read_reg(3'h0, data);
        received = 1;
      end else begin
        timeout--;
        @(posedge m_sequencer.vif.clk);
      end
    end
    if (!received) begin
      data = 8'hXX;
    end
  endtask

  protected task uart_write_reg(logic [2:0] addr, logic [7:0] data);
    if (reg_model) begin
      uvm_status_e st;
      case (addr)
        3'h0: reg_model.rbr_thr.write(st, data, .parent(this));
        3'h1: reg_model.ier.write(st, data, .parent(this));
        3'h2: reg_model.iir.write(st, data, .parent(this));
        3'h3: reg_model.lcr.write(st, data, .parent(this));
        3'h4: reg_model.mcr.write(st, data, .parent(this));
        3'h5: reg_model.lsr.write(st, data, .parent(this));
        3'h6: reg_model.msr.write(st, data, .parent(this));
        3'h7: reg_model.scr.write(st, data, .parent(this));
      endcase
    end else begin
      {{ spec.design_name }}_write_reg_seq wseq;
      wseq = {{ spec.design_name }}_write_reg_seq::type_id::create("wseq");
      wseq.reg_addr = addr;
      wseq.write_data = data;
      wseq.start(m_sequencer);
    end
  endtask

  protected task uart_read_reg(logic [2:0] addr, output logic [7:0] data);
    if (reg_model) begin
      uvm_status_e st;
      case (addr)
        3'h0: reg_model.rbr_thr.read(st, data, .parent(this));
        3'h1: reg_model.ier.read(st, data, .parent(this));
        3'h2: reg_model.iir.read(st, data, .parent(this));
        3'h3: reg_model.lcr.read(st, data, .parent(this));
        3'h4: reg_model.mcr.read(st, data, .parent(this));
        3'h5: reg_model.lsr.read(st, data, .parent(this));
        3'h6: reg_model.msr.read(st, data, .parent(this));
        3'h7: reg_model.scr.read(st, data, .parent(this));
      endcase
    end else begin
      {{ spec.design_name }}_read_reg_seq rseq;
      rseq = {{ spec.design_name }}_read_reg_seq::type_id::create("rseq");
      rseq.reg_addr = addr;
      rseq.start(m_sequencer);
      data = rseq.read_data;
    end
  endtask
endclass

class uart_interrupt_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils(uart_interrupt_seq)

  typedef enum {
    INT_RX_DATA, INT_TX_EMPTY, INT_LINE_STATUS, INT_MODEM_STATUS
  } int_type_t;

  rand int_type_t int_type;
  bit interrupt_detected;
  int irq_assertions;

  function new(string n = "uart_interrupt_seq");
    super.new(n);
    interrupt_detected = 0;
    irq_assertions = 0;
  endfunction

  task body;
    logic [7:0] ier_val;
    logic [7:0] iir_val;

    `uvm_info("UART_INT", $sformatf("Testing interrupt type: %s", int_type.name()), UVM_MEDIUM)

    case (int_type)
      INT_RX_DATA:    ier_val = 8'h01;
      INT_TX_EMPTY:  ier_val = 8'h02;
      INT_LINE_STATUS: ier_val = 8'h04;
      INT_MODEM_STATUS: ier_val = 8'h08;
    endcase

    uart_write_reg(3'h1, ier_val);

    fork
      wait_for_intr_signal();
      trigger_intr();
    join_any
    disable fork;

    uart_read_reg(3'h2, iir_val);

    if (iir_val[0] == 1'b0) begin
      `uvm_info("UART_INT", $sformatf("Interrupt pending, IIR = 0x%02h", iir_val), UVM_MEDIUM)
      interrupt_detected = 1;
    end else begin
      `uvm_warning("UART_INT", $sformatf("No interrupt pending after stimulus, IIR=0x%02h", iir_val))
    end

    if (sb_handle != null) begin
      sb_handle.check_interrupt(iir_val, interrupt_detected);
      sb_handle.check_interrupt_cause(iir_val);
    end
  endtask

  task wait_for_intr_signal();
    int timeout = 200000;
    for (int i = 0; i < timeout; i++) begin
      @(posedge m_sequencer.vif.clk);
      if (m_sequencer.vif.uart_intr) begin
        irq_assertions++;
        `uvm_info("UART_INT", $sformatf("Interrupt asserted on uart_intr (count=%0d)", irq_assertions), UVM_MEDIUM)
        if (irq_assertions >= 1) return;
      end
    end
    `uvm_warning("UART_INT", "Timeout waiting for interrupt signal")
  endtask

  task trigger_intr();
    case (int_type)
      INT_TX_EMPTY: begin
        #100ns;
        uart_write_reg(3'h0, 8'hAA);
        `uvm_info("UART_INT", "Trigger: TX data written to THR", UVM_MEDIUM)
      end
      INT_RX_DATA: begin
        logic [7:0] mcr_val;
        uart_read_reg(3'h4, mcr_val);
        mcr_val[4] = 1'b1;
        uart_write_reg(3'h4, mcr_val);
        `uvm_info("UART_INT", "Trigger: Loopback enabled (MCR[4]=1)", UVM_MEDIUM)
        #100ns;
        uart_write_reg(3'h0, 8'h55);
        `uvm_info("UART_INT", "Trigger: TX byte 0x55 written, expected to echo to RBR", UVM_MEDIUM)
        #10us;
      end
      INT_LINE_STATUS: begin
        logic [7:0] lcr_val;
        uart_read_reg(3'h3, lcr_val);
        lcr_val[3] = 1'b1;
        lcr_val[4] = 1'b1;
        lcr_val[5] = 1'b0;
        uart_write_reg(3'h3, lcr_val);
        `uvm_info("UART_INT", "Trigger: Even parity enabled in LCR", UVM_MEDIUM)
        #100ns;
        uart_write_reg(3'h0, 8'hA5);
        `uvm_info("UART_INT", "Trigger: TX byte 0xA5 (no parity bit in data)", UVM_MEDIUM)
        #20us;
        lcr_val[3] = 1'b0;
        uart_write_reg(3'h3, lcr_val);
      end
      INT_MODEM_STATUS: begin
        logic [7:0] mcr_val;
        uart_read_reg(3'h4, mcr_val);
        mcr_val[0] = ~mcr_val[0];
        uart_write_reg(3'h4, mcr_val);
        `uvm_info("UART_INT", "Trigger: Modem control toggled (MCR[0])", UVM_MEDIUM)
        #10us;
      end
    endcase
  endtask

  protected task uart_write_reg(logic [2:0] addr, logic [7:0] data);
    if (reg_model) begin
      uvm_status_e st;
      case (addr)
        3'h0: reg_model.rbr_thr.write(st, data, .parent(this));
        3'h1: reg_model.ier.write(st, data, .parent(this));
        3'h2: reg_model.iir.write(st, data, .parent(this));
        3'h3: reg_model.lcr.write(st, data, .parent(this));
        3'h4: reg_model.mcr.write(st, data, .parent(this));
        3'h5: reg_model.lsr.write(st, data, .parent(this));
        3'h6: reg_model.msr.write(st, data, .parent(this));
        3'h7: reg_model.scr.write(st, data, .parent(this));
      endcase
    end else begin
      {{ spec.design_name }}_write_reg_seq wseq;
      wseq = {{ spec.design_name }}_write_reg_seq::type_id::create("wseq");
      wseq.reg_addr = addr;
      wseq.write_data = data;
      wseq.start(m_sequencer);
    end
  endtask

  protected task uart_read_reg(logic [2:0] addr, output logic [7:0] data);
    if (reg_model) begin
      uvm_status_e st;
      case (addr)
        3'h0: reg_model.rbr_thr.read(st, data, .parent(this));
        3'h1: reg_model.ier.read(st, data, .parent(this));
        3'h2: reg_model.iir.read(st, data, .parent(this));
        3'h3: reg_model.lcr.read(st, data, .parent(this));
        3'h4: reg_model.mcr.read(st, data, .parent(this));
        3'h5: reg_model.lsr.read(st, data, .parent(this));
        3'h6: reg_model.msr.read(st, data, .parent(this));
        3'h7: reg_model.scr.read(st, data, .parent(this));
      endcase
    end else begin
      {{ spec.design_name }}_read_reg_seq rseq;
      rseq = {{ spec.design_name }}_read_reg_seq::type_id::create("rseq");
      rseq.reg_addr = addr;
