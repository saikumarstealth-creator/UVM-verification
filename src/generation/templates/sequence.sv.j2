// -------------------------------------------------------------------------
// UART Reset Test — verifies all regs match expected reset values
// -------------------------------------------------------------------------
class uart_reset_test_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils(uart_reset_test_seq)

  int num_mismatches;

  function new(string n = "uart_reset_test_seq");
    super.new(n);
  endfunction

  task body;
    uvm_status_e status;
    uvm_reg_data_t val;
    string regs_to_check[$];

    `uvm_info("UART_RST", "Starting register reset value verification", UVM_LOW)

    // 1. Apply hardware reset stimulus
    `uvm_info("UART_RST", "Applying hardware reset", UVM_MEDIUM)
    m_sequencer.vif.rst_n <= 1'b0;
    repeat (10) @(posedge m_sequencer.vif.clk);
    m_sequencer.vif.rst_n <= 1'b1;
    repeat (5) @(posedge m_sequencer.vif.clk);

    regs_to_check = {
      {% for r in sorted_regs %}"{{ r.name|lower }}"{% if not loop.last %}, {% endif %}{% endfor %}
    };

    foreach (regs_to_check[i]) begin
      if (reg_model != null) begin
        uvm_reg rg = reg_model.get_reg_by_name(regs_to_check[i]);
        if (rg != null) begin
          rg.read(status, val, .parent(this));
          `uvm_info("UART_RST", $sformatf("Reg %s = 0x%0h (reset: 0x%0h)",
                    regs_to_check[i], val, rg.get_reset()), UVM_MEDIUM)
          if (val !== rg.get_reset()) begin
            num_mismatches++;
            `uvm_error("UART_RST", $sformatf("Reg %s mismatch: got 0x%0h, expected 0x%0h",
                      regs_to_check[i], val, rg.get_reset()))
          end
        end
      end
    end

    if (num_mismatches == 0) begin
      `uvm_info("UART_RST", "All register reset values match", UVM_LOW)
    end else begin
      `uvm_error("UART_RST", $sformatf("%0d register(s) have unexpected reset values", num_mismatches))
    end
  endtask
endclass

// -------------------------------------------------------------------------
// UART Coverage Exploration Sequence — sweeps all config combinations
// Requires: LCR (0x03) for config_seq, THR+LSR (0x00+0x05) for tx_seq
// -------------------------------------------------------------------------
{% if _need_lcr and _need_tx %}
class uart_coverage_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils(uart_coverage_seq)

  int baud_list[$] = {9600, 19200, 38400, 57600, 115200, 230400, 1000000};
  int data_bits_list[$] = {5, 6, 7, 8};
  int stop_bits_list[$] = {1, 2};
  int parity_modes[3][2] = '{'{0,0}, '{1,1}, '{1,0}};

  int total_combos;
  int covered_combos;
  int cov_write;
  int cov_read;
  int cov_addr;
  int cov_data;
  int cov_baud;
  int cov_parity;
  int cov_wordlen;

  function new(string n = "uart_coverage_seq");
    super.new(n);
    total_combos = baud_list.size() * data_bits_list.size() * stop_bits_list.size() * 3;
    covered_combos = 0;
  endfunction

  task body;
    `uvm_info("UART_COV", $sformatf("Starting coverage exploration: %0d combinations", total_combos), UVM_LOW)

    foreach (baud_list[b]) begin
      foreach (data_bits_list[d]) begin
        foreach (stop_bits_list[s]) begin
          logic [7:0] pattern;

          exercise_config(baud_list[b], data_bits_list[d], stop_bits_list[s], 0, 0);
          exercise_config(baud_list[b], data_bits_list[d], stop_bits_list[s], 1, 0);
          exercise_config(baud_list[b], data_bits_list[d], stop_bits_list[s], 1, 1);

          pattern = (d == 0) ? 8'h55 : (d == 1) ? 8'hAA : (d == 2) ? 8'hCC : 8'h33;
          uart_tx_seq tx_seq;
          tx_seq = uart_tx_seq::type_id::create($sformatf("tx_seq_%0d_%0d_%0d", b, d, s));
          tx_seq.tx_data = {pattern, ~pattern, 8'h00, 8'hFF};
          tx_seq.num_bytes = 4;
          tx_seq.start(m_sequencer);
          #50us;
        end
      end
    end

    if (sb_handle != null) begin
      sb_handle.extract_coverage(cov_write, cov_read, cov_addr, cov_data,
                                  cov_baud, cov_parity, cov_wordlen);
      `uvm_info("UART_COV", $sformatf(
        "\n  === Coverage Report ==="
        "\n  Bus Writes:       %0d"
        "\n  Bus Reads:        %0d"
        "\n  Addr Bins Hit:    %0d/8"
        "\n  Data Patterns:    %0d/3 (alt+walk+edge)"
        "\n  Baud Rates:       %0d/%0d"
        "\n  Parity Modes:     %0d/5"
        "\n  Word Lengths:     %0d/4",
        cov_write, cov_read, cov_addr, cov_data,
        cov_baud, baud_list.size(),
        cov_parity, cov_wordlen
      ), UVM_LOW)
    end
  endtask

  protected task exercise_config(int baud, int dbits, int sbits, bit pen, bit eps);
    uart_config_seq cfg_seq;
    cfg_seq = uart_config_seq::type_id::create($sformatf("cfg_seq_%0d", covered_combos));
    cfg_seq.baud_rate = baud;
    cfg_seq.data_bits = dbits;
    cfg_seq.stop_bits = sbits;
    cfg_seq.parity_en = pen;
    cfg_seq.even_parity = eps;
    cfg_seq.start(m_sequencer);
    `uvm_info("UART_COV", $sformatf("Config: baud=%0d data=%0d stop=%0d parity(en=%0d,even=%0d)",
              baud, dbits, sbits, pen, eps), UVM_HIGH)
    covered_combos++;
  endtask
endclass
{% endif %}  {# /LCR+THR+LSR check for uart_coverage_seq #}

{% set _need_vseq = _need_lcr and _need_tx %}
{% set _need_vseq = _need_vseq and ('0x04' in _reg_addr_set or '0x4' in _reg_addr_set) %}
{% set _need_vseq = _need_vseq and ('0x01' in _reg_addr_set or '0x1' in _reg_addr_set) %}
{% set _need_vseq = _need_vseq and ('0x02' in _reg_addr_set or '0x2' in _reg_addr_set) %}
// -------------------------------------------------------------------------
// UART Virtual Sequence — orchestrates multiple sequences together
// Requires: all registers for sub-sequences (0x00-0x05 must be defined)
// Uses virtual sequencer handles for enterprise layering.
// Start on vsequencer.bus_seqr (or sub-sequencer) via:
//   p_sequencer.bus_seqr
// -------------------------------------------------------------------------
{% if _need_vseq %}
class uart_virtual_seq extends uvm_sequence #({{ spec.design_name }}_seq_item);
  `uvm_object_utils(uart_virtual_seq)
  `uvm_declare_p_sequencer({{ spec.design_name }}_virtual_sequencer)

  {{ spec.design_name }}_reg_block  reg_model;
  {{ spec.design_name }}_scoreboard sb_handle;

  function new(string n = "uart_virtual_seq");
    super.new(n);
  endfunction

  virtual task pre_body();
    if (!uvm_config_db #({{ spec.design_name }}_scoreboard)::get(null, "uvm_test_top.env", "sb", sb_handle))
      `uvm_warning("CFG", $sformatf("Scoreboard handle not found for %s", get_type_name()))
  endtask

  task body;
    uart_config_seq         cfg_seq;
    uart_tx_seq             tx_seq;
    uart_rx_seq             rx_seq;
    uart_loopback_seq       lb_seq;
    uart_interrupt_seq      int_seq;
    uart_error_injection_seq inj_seq;

    `uvm_info("UART_VSEQ", "Starting virtual sequence on virtual sequencer", UVM_LOW)

    // 1. Configure UART (on bus sequencer)
    cfg_seq = uart_config_seq::type_id::create("cfg_seq");
    cfg_seq.reg_model = reg_model;
    cfg_seq.baud_rate = 115200;
    cfg_seq.data_bits = 8;
    cfg_seq.start(p_sequencer.bus_seqr);

    // 2. Run loopback test
    lb_seq = uart_loopback_seq::type_id::create("lb_seq");
    lb_seq.reg_model = reg_model;
    lb_seq.sb_handle = sb_handle;
    lb_seq.test_data = {8'h55, 8'hAA, 8'h33, 8'hCC, 8'h01, 8'h02, 8'h03, 8'h04};
    lb_seq.start(p_sequencer.bus_seqr);

    // 3. Run interrupt test (TX empty)
    int_seq = uart_interrupt_seq::type_id::create("int_seq");
    int_seq.reg_model = reg_model;
    int_seq.int_type = uart_interrupt_seq::INT_TX_EMPTY;
    int_seq.start(p_sequencer.bus_seqr);

    // 4. Run error injection test
    inj_seq = uart_error_injection_seq::type_id::create("inj_seq");
    inj_seq.reg_model = reg_model;
    inj_seq.sb_handle = sb_handle;
    inj_seq.inj_type = uart_error_injection_seq::INJ_PARITY;
    inj_seq.num_injections = 2;
    inj_seq.start(p_sequencer.bus_seqr);

    `uvm_info("UART_VSEQ", "Virtual sequence completed", UVM_LOW)
  endtask
endclass
{% endif %}  {# /full-register check for uart_virtual_seq #}

{% set _need_ier = '0x01' in _reg_addr_set or '0x1' in _reg_addr_set %}
{% set _need_iir = '0x02' in _reg_addr_set or '0x2' in _reg_addr_set %}
{% set _need_mcr = '0x04' in _reg_addr_set or '0x4' in _reg_addr_set %}
// =========================================================================
//  UART Sequence Library — for regression automation
//  Spec-driven: only includes sequences whose register requirements are met.
// =========================================================================
class uart_seq_lib extends uvm_sequence_library #({{ spec.design_name }}_seq_item);
  `uvm_object_utils(uart_seq_lib)
  `uvm_sequence_library_utils(uart_seq_lib)

  static function void add_sequences();
{% if _need_lcr %}
    uart_seq_lib::add_sequence(uart_config_seq::get_type());
{% endif %}
{% if _need_tx %}
    uart_seq_lib::add_sequence(uart_tx_seq::get_type());
    uart_seq_lib::add_sequence(uart_rx_seq::get_type());
{% endif %}
{% if _need_mcr and _need_tx %}
    uart_seq_lib::add_sequence(uart_loopback_seq::get_type());
{% endif %}
{% if _need_ier and _need_iir and _need_mcr and _need_tx and _need_lcr %}
    uart_seq_lib::add_sequence(uart_interrupt_seq::get_type());
{% endif %}
{% if _need_tx %}
    uart_seq_lib::add_sequence(uart_error_injection_seq::get_type());
{% endif %}
{% if _need_lcr and _need_tx %}
    uart_seq_lib::add_sequence(uart_random_seq::get_type());
    uart_seq_lib::add_sequence(uart_baud_change_seq::get_type());
    uart_seq_lib::add_sequence(uart_coverage_seq::get_type());
    uart_seq_lib::add_sequence(uart_virtual_seq::get_type());
{% endif %}
    // Always generated (use reg_model generically):
    uart_seq_lib::add_sequence(uart_reg_hw_reset_seq::get_type());
    uart_seq_lib::add_sequence(uart_reg_bit_bash_seq::get_type());
    uart_seq_lib::add_sequence(uart_reg_access_seq::get_type());
    uart_seq_lib::add_sequence(uart_reg_mem_walk_seq::get_type());
    uart_seq_lib::add_sequence(uart_reg_aliasing_seq::get_type());
    uart_seq_lib::add_sequence(uart_reset_test_seq::get_type());
  endfunction

  function new(string name = "uart_seq_lib");
    super.new(name);
    init_sequence_library();
    add_sequences();
  endfunction
endclass

