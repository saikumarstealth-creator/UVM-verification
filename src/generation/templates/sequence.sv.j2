    for (int i = 0; i < num_transactions; i++) begin
      tx_seq = {{ spec.design_name }}_tx_seq::type_id::create($sformatf("tx_seq_%0d", i));
      tx_seq.reg_model = reg_model;
      if (!tx_seq.randomize() with { num_bytes == 1; }) begin
        `uvm_error("{{ spec.design_name|upper }}_RAND", "TX seq randomization failed")
      end else begin
        tx_seq.start(m_sequencer);
        tx_count++;
      end
    end

    `uvm_info("{{ spec.design_name|upper }}_RAND", $sformatf(
      "Random traffic complete: %0d TX transactions",
      tx_count
    ), UVM_LOW)
  endtask
