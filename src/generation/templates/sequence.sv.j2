// -------------------------------------------------------------------------
// I2C NACK Sequence — tests slave NACK response
// -------------------------------------------------------------------------
class {{ spec.design_name }}_i2c_nack_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_i2c_nack_seq)

  rand logic [6:0] invalid_addr;
  int nack_count;

  constraint c_nack_addr { invalid_addr inside {[8'h78:8'h7F]}; }

  function new(string n = "{{ spec.design_name }}_i2c_nack_seq");
    super.new(n);
  endfunction

  task body;
    logic [7:0] status;

    `uvm_info("I2C_NACK", $sformatf("NACK test: invalid addr 0x%02h", invalid_addr), UVM_LOW)

    write_reg(0, {1'b0, invalid_addr});
    write_reg(1, 8'h01);
    write_reg(2, 8'hA5);
    #200;

    read_reg(5, status);
    `uvm_info("I2C_NACK", $sformatf("NACK status: 0x%02h", status), UVM_MEDIUM)

    if (status[0]) begin
      nack_count++;
      `uvm_info("I2C_NACK", "NACK correctly detected", UVM_LOW)
    end else begin
      `uvm_warning("I2C_NACK", "NACK not detected — slave may have ACKed invalid addr")
    end

    write_reg(1, 8'h00);
  endtask
