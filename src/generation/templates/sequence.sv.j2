// -------------------------------------------------------------------------
// UART FIFO Overflow Sequence — fills TX FIFO, verifies overflow handling
// -------------------------------------------------------------------------
class {{ spec.design_name }}_fifo_overflow_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_fifo_overflow_seq)

  rand int num_overflow_bytes;

  constraint c_overflow {
    num_overflow_bytes inside {[16:64]};
  }

  function new(string n = "{{ spec.design_name }}_fifo_overflow_seq");
    super.new(n);
  endfunction

  task body;
    logic [7:0] lsr_val;
    int overflow_events;

    `uvm_info("{{ spec.design_name|upper }}_FIFO", $sformatf("FIFO overflow test: %0d bytes", num_overflow_bytes), UVM_LOW)

    for (int i = 0; i < num_overflow_bytes; i++) begin
      write_reg({{ spec.design_name|upper }}_THR_ADDR, 8'($urandom_range(0, 255)));
      if (i >= 16 && (i % 4) == 0) begin
        read_reg({{ spec.design_name|upper }}_LSR_ADDR, lsr_val);
        if (lsr_val[1]) begin
          overflow_events++;
          `uvm_info("{{ spec.design_name|upper }}_FIFO", $sformatf("Overflow flag detected at byte %0d", i), UVM_MEDIUM)
        end
      end
    end

    if (overflow_events > 0)
      `uvm_info("{{ spec.design_name|upper }}_FIFO", $sformatf("FIFO overflow correctly detected: %0d times", overflow_events), UVM_LOW)
    else
      `uvm_warning("{{ spec.design_name|upper }}_FIFO", "No overflow events detected — FIFO may be larger than test data")
  endtask
endclass

// -------------------------------------------------------------------------
// UART Stress Sequence — rapid config changes + continuous traffic
// -------------------------------------------------------------------------
class {{ spec.design_name }}_stress_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_stress_seq)

  rand int stress_iterations;

  constraint c_stress {
    stress_iterations inside {[5:20]};
  }

  function new(string n = "{{ spec.design_name }}_stress_seq");
    super.new(n);
  endfunction

  task body;
    int baud_list[5] = '{9600, 19200, 57600, 115200, 1000000};
    int random_data[$];
    int total_tx;
    int total_rx;

    `uvm_info("{{ spec.design_name|upper }}_STRESS", $sformatf("Starting stress test: %0d iterations", stress_iterations), UVM_LOW)

    for (int iter = 0; iter < stress_iterations; iter++) begin
      {{ spec.design_name }}_config_seq cfg_seq;
      int chosen_baud = baud_list[$urandom_range(0, 4)];
      int chosen_bits = 5 + $urandom_range(0, 3);
      int chosen_stop = 1 + $urandom_range(0, 1);

      cfg_seq = {{ spec.design_name }}_config_seq::type_id::create($sformatf("stress_cfg_%0d", iter));
      cfg_seq.reg_model = reg_model;
      cfg_seq.baud_rate = chosen_baud;
      cfg_seq.data_bits = chosen_bits;
      cfg_seq.stop_bits = chosen_stop;
      cfg_seq.parity_en = $urandom;
      cfg_seq.start(m_sequencer);
      total_tx++;

      repeat (3) begin
        {{ spec.design_name }}_tx_seq tx_seq;
        tx_seq = {{ spec.design_name }}_tx_seq::type_id::create($sformatf("stress_tx_%0d_%0d", iter, total_tx));
        tx_seq.reg_model = reg_model;
        tx_seq.num_bytes = 1 + $urandom_range(0, 4);
        if (!tx_seq.randomize()) begin
          `uvm_error("{{ spec.design_name|upper }}_STRESS", "TX seq randomization failed")
        end else begin
          tx_seq.start(m_sequencer);
          total_tx++;
        end
      end
      #10us;
    end

    `uvm_info("{{ spec.design_name|upper }}_STRESS", $sformatf(
      "Stress test complete: %0d iterations, %0d TX ops",
      stress_iterations, total_tx), UVM_LOW)
  endtask
endclass

// -------------------------------------------------------------------------
// UART Long Run Sequence — sustained traffic of 100+ bytes
// -------------------------------------------------------------------------
class {{ spec.design_name }}_long_run_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_long_run_seq)

  rand int total_bytes;
  int tx_completed;
  int errors;

  constraint c_long_run {
    total_bytes inside {[100:500]};
  }

  function new(string n = "{{ spec.design_name }}_long_run_seq");
    super.new(n);
  endfunction

  task body;
    {{ spec.design_name }}_config_seq cfg_seq;
    logic [7:0] expected_data[$];
    int chunk_size = 16;

    `uvm_info("{{ spec.design_name|upper }}_LONG", $sformatf("Long run test: %0d total bytes", total_bytes), UVM_LOW)

    cfg_seq = {{ spec.design_name }}_config_seq::type_id::create("cfg_seq");
    cfg_seq.reg_model = reg_model;
    cfg_seq.start(m_sequencer);

    for (int i = 0; i < total_bytes; i += chunk_size) begin
      {{ spec.design_name }}_tx_seq tx_seq;
      int this_chunk = (i + chunk_size > total_bytes) ? total_bytes - i : chunk_size;

      tx_seq = {{ spec.design_name }}_tx_seq::type_id::create($sformatf("long_tx_%0d", i));
      tx_seq.reg_model = reg_model;
      tx_seq.num_bytes = this_chunk;
      if (!tx_seq.randomize()) begin
        `uvm_error("{{ spec.design_name|upper }}_LONG", "TX chunk randomization failed")
      end else begin
        tx_seq.start(m_sequencer);
        tx_completed += this_chunk;
        foreach (tx_seq.tx_data[j]) expected_data.push_back(tx_seq.tx_data[j]);
      end
      #2us;
    end

    `uvm_info("{{ spec.design_name|upper }}_LONG", $sformatf(
      "Long run complete: %0d/%0d bytes TX",
      tx_completed, total_bytes), UVM_LOW)

    if (errors > 0)
      `uvm_error("{{ spec.design_name|upper }}_LONG", $sformatf("%0d errors during long run test", errors))
  endtask
endclass

