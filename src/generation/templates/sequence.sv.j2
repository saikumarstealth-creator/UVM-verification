// -------------------------------------------------------------------------
// I2C Virtual Sequence
// -------------------------------------------------------------------------
class {{ spec.design_name }}_i2c_virtual_seq extends uvm_sequence #({{ spec.design_name }}_seq_item);
  `uvm_object_utils({{ spec.design_name }}_i2c_virtual_seq)
  `uvm_declare_p_sequencer({{ spec.design_name }}_virtual_sequencer)

  {{ spec.design_name }}_reg_block  reg_model;
  {{ spec.design_name }}_scoreboard sb_handle;

  function new(string n = "{{ spec.design_name }}_i2c_virtual_seq");
    super.new(n);
  endfunction

  virtual task pre_body();
    if (!uvm_config_db #({{ spec.design_name }}_scoreboard)::get(null, "uvm_test_top.env", "sb", sb_handle))
      `uvm_warning("CFG", $sformatf("Scoreboard not found for %s", get_type_name()))
  endtask

  task body;
    {{ spec.design_name }}_i2c_master_write_seq    wr_seq;
    {{ spec.design_name }}_i2c_master_read_seq     rd_seq;
    {{ spec.design_name }}_i2c_repeated_start_seq  rs_seq;
    {{ spec.design_name }}_i2c_nack_seq            nack_seq;

    `uvm_info("I2C_VSEQ", "Starting I2C virtual sequence", UVM_LOW)

    wr_seq = {{ spec.design_name }}_i2c_master_write_seq::type_id::create("wr_seq");
    wr_seq.reg_model = reg_model;
    wr_seq.slave_addr = 7'h50;
    wr_seq.write_data = {8'h55, 8'hAA, 8'h33};
    wr_seq.start(p_sequencer.bus_seqr);

    rd_seq = {{ spec.design_name }}_i2c_master_read_seq::type_id::create("rd_seq");
    rd_seq.reg_model = reg_model;
    rd_seq.slave_addr = 7'h50;
    rd_seq.num_bytes = 3;
    rd_seq.start(p_sequencer.bus_seqr);

    rs_seq = {{ spec.design_name }}_i2c_repeated_start_seq::type_id::create("rs_seq");
    rs_seq.reg_model = reg_model;
    rs_seq.slave_addr = 7'h50;
    rs_seq.write_data = 8'hCC;
    rs_seq.start(p_sequencer.bus_seqr);

    nack_seq = {{ spec.design_name }}_i2c_nack_seq::type_id::create("nack_seq");
    nack_seq.reg_model = reg_model;
    nack_seq.invalid_addr = 7'h7F;
    nack_seq.start(p_sequencer.bus_seqr);

    `uvm_info("I2C_VSEQ", "I2C virtual sequence complete", UVM_LOW)
  endtask
endclass

