    {{ spec.design_name }}_seq_item outstanding_reqs[$];

    `uvm_info("AXI_OUT", $sformatf("Outstanding transactions: %0d", outstanding_count), UVM_LOW)

    for (int i = 0; i < outstanding_count; i++) begin
      {{ spec.design_name }}_seq_item req;
