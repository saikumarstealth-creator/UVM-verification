// Enhanced UVM Sequences for {{ spec.design_name }} ({{ spec.protocol|default("wishbone", true) }})
// Includes: RAL-based sequences, register access, protocol-specific tests
`include "uvm_macros.svh"
import uvm_pkg::*;
{% set p = spec.protocol|default("wishbone") %}
{% set regs = spec.registers if spec.registers else [] %}
{% set num_regs = regs|length %}
{% if num_regs == 0 %}{% set num_regs = 8 %}{% endif %}
{% set addr_ints = regs|map(attribute='address')|map('replace', '0x', '')|map('replace', 'h', '')|map('int', 16)|list %}
{% set max_addr_val = addr_ints|max if addr_ints else 0 %}
{% set addr_bits = [max_addr_val.bit_length(), 3]|max %}
{% set sizes = regs|map(attribute='size')|select('number')|list %}
{% set data_width = sizes|max if sizes else 8 %}
{% set ro_regs = regs|selectattr('access', 'equalto', 'ro')|map(attribute='name')|map('lower')|list %}
{% set wo_regs = regs|selectattr('access', 'equalto', 'wo')|map(attribute='name')|map('lower')|list %}
{% set reg_names = regs|map(attribute='name')|map('lower')|list %}
{% set sorted_regs = regs|sort(attribute='address') %}
{% set reg_addresses = addr_ints|sort %}
{% set reg_upper = regs|map(attribute='name')|map('upper')|list %}
{% set _all_signal_names = [] %}
{% for _iface in spec.interfaces %}{% for _sig in _iface.signals %}{% set _tmp = _all_signal_names.append(_sig.name.lower()) %}{% endfor %}{% endfor %}
{% set _pready_aliases = ['pready', 'ready', 'ack', 'wb_ack'] %}
{% set _has_pready = _all_signal_names|select('in', _pready_aliases)|list|length > 0 %}
{% set _pslverr_aliases = ['pslverr', 'slverr', 'err', 'wb_err'] %}
{% set _has_pslverr = _all_signal_names|select('in', _pslverr_aliases)|list|length > 0 %}
{% set _wb_aliases = ['wb_cyc', 'cyc', 'wb_stb', 'stb', 'wb_we', 'we', 'wb_ack', 'ack'] %}
{% set _wb_count = _all_signal_names|select('in', _wb_aliases)|list|length %}
{% set _is_wb = _wb_count >= 3 %}

// Register address constants (generated from spec — only if register exists)
{% set seen_addrs = [] %}
{% for reg in sorted_regs %}
{% set a = reg.address|replace('0x', '')|replace('h', '') %}
{% if a not in seen_addrs %}
{% set _ = seen_addrs.append(a) %}
localparam logic [{{ addr_bits-1 }}:0] {{ spec.design_name|upper }}_{{ reg.name|upper }}_ADDR = {{ addr_bits }}'h{{ a }};
{% endif %}
{% endfor %}
{% if p == "uart" %}
  // Aliases for UART 16550-compatible register names (spec-driven)
  // Only generated when a register exists at the given address.
  {% set _ua = {
    '0x00': spec.design_name|upper ~ '_THR', '0x0': spec.design_name|upper ~ '_THR',
    '0x01': spec.design_name|upper ~ '_IER', '0x1': spec.design_name|upper ~ '_IER',
    '0x02': spec.design_name|upper ~ '_IIR', '0x2': spec.design_name|upper ~ '_IIR',
    '0x03': spec.design_name|upper ~ '_LCR', '0x3': spec.design_name|upper ~ '_LCR',
    '0x04': spec.design_name|upper ~ '_MCR', '0x4': spec.design_name|upper ~ '_MCR',
    '0x05': spec.design_name|upper ~ '_LSR', '0x5': spec.design_name|upper ~ '_LSR',
    '0x06': spec.design_name|upper ~ '_MSR', '0x6': spec.design_name|upper ~ '_MSR',
    '0x07': spec.design_name|upper ~ '_SCR', '0x7': spec.design_name|upper ~ '_SCR',
  } %}
  {% for r in sorted_regs %}
    {% set a_clean = r.address|lower %}
    {% if a_clean in _ua %}
      {% set const_name = _ua[a_clean] %}
// {{ const_name }} — {{ r.name }} (address {{ r.address }})
localparam logic [2:0] {{ const_name }}_ADDR = 3'h{{ a_clean|replace('0x', '')|replace('h', '') }};
    {% endif %}
  {% endfor %}
  // Aliased 16550 registers at shared addresses (always emitted for UART)
localparam logic [2:0] {{ spec.design_name|upper }}_RBR_ADDR = 3'h0;
localparam logic [2:0] {{ spec.design_name|upper }}_DLL_ADDR = 3'h0;
localparam logic [2:0] {{ spec.design_name|upper }}_DLH_ADDR = 3'h1;
localparam logic [2:0] {{ spec.design_name|upper }}_FCR_ADDR = 3'h2;
{% endif %}

// ---------------------------------------------------------------------------
// Base Sequence — all sequences inherit from here
// ---------------------------------------------------------------------------
class {{ spec.design_name }}_base_seq extends uvm_sequence #({{ spec.design_name }}_seq_item);
  `uvm_object_utils({{ spec.design_name }}_base_seq)

  {{ spec.design_name }}_reg_block       reg_model;
  {{ spec.design_name }}_scoreboard      sb_handle;
  {{ spec.design_name }}_seq_item        req;
  {{ spec.design_name }}_seq_item        rsp;
  protected virtual {{ spec.design_name }}_intf vif;

  function new(string n = "{{ spec.design_name }}_base_seq");
    super.new(n);
  endfunction

  virtual task pre_body();
    {{ spec.design_name }}_sequencer seqr;
    if (!uvm_config_db #({{ spec.design_name }}_scoreboard)::get(null, "uvm_test_top.env", "sb", sb_handle))
      `uvm_warning("CFG", $sformatf("Scoreboard handle not found for %s", get_type_name()))
    if (!uvm_config_db #({{ spec.design_name }}_reg_block)::get(null, "uvm_test_top.env", "reg_model", reg_model))
      `uvm_info("CFG", $sformatf("reg_model not set via config_db for %s", get_type_name()), UVM_MEDIUM)
    if ($cast(seqr, m_sequencer)) vif = seqr.vif;
  endtask

  task body;
    `uvm_info("SEQ", "Starting base sequence", UVM_MEDIUM)
  endtask

  // ---------------------------------------------------------------
  // Helper: Write to a register by address
  // ---------------------------------------------------------------
  protected task write_reg(logic [{{ addr_bits-1 }}:0] addr, logic [7:0] data);
    if (reg_model) begin
      uvm_status_e st;
      uvm_reg rg;
{% if p == "uart" %}
      // DLAB-aware register access: read LCR if available and redirect
      // addr {0,1} to the DLAB alias when LCR[7]=1.  Register lookups
      // use get_reg_by_offset() (not hardcoded names) so any register
      // name from the spec is handled automatically.
      if (addr inside { {{ addr_bits }}'h0, {{ addr_bits }}'h1 }) begin
        logic [7:0] lcr_val;
        uvm_reg lcr_rg = reg_model.get_reg_by_offset('h03);
        if (lcr_rg != null) begin
          lcr_rg.read(st, lcr_val, .parent(this));
          if (lcr_val[7]) begin
            rg = reg_model.get_reg_by_offset(addr);
            if (rg != null) begin
              rg.write(st, data, .parent(this));
              if (sb_handle != null) sb_handle.record_tx(addr, data);
              return;
            end
          end
        end
      end
{% endif %}
      rg = reg_model.get_reg_by_offset(addr);
      if (rg != null)
        rg.write(st, data, .parent(this));
      else
        `uvm_error("REG", $sformatf("Write to unmapped address 0x%0h", addr))
    end else begin
      {{ spec.design_name }}_seq_item req_h;
      req_h = {{ spec.design_name }}_seq_item::type_id::create("req_h");
      start_item(req_h);
      if (!req_h.randomize() with { we == 1; addr == local::addr; data == local::data; delay == 0; })
        `uvm_fatal("RAND", "write_reg req_h randomization failed")
      finish_item(req_h);
      get_response(rsp);
    end
    if (sb_handle != null) sb_handle.record_tx(addr, data);
  endtask

  // ---------------------------------------------------------------
  // Helper: Read from a register by address
  // ---------------------------------------------------------------
  protected task read_reg(logic [{{ addr_bits-1 }}:0] addr, output logic [7:0] data);
    if (reg_model) begin
      uvm_status_e st;
      uvm_reg rg;
{% if p == "uart" %}
      // DLAB-aware register read — same approach as write_reg:
      // use get_reg_by_offset() with DLAB redirection, no hardcoded names.
      if (addr inside { {{ addr_bits }}'h0, {{ addr_bits }}'h1 }) begin
        logic [7:0] lcr_val;
        uvm_reg lcr_rg = reg_model.get_reg_by_offset('h03);
        if (lcr_rg != null) begin
          lcr_rg.read(st, lcr_val, .parent(this));
          if (lcr_val[7]) begin
            rg = reg_model.get_reg_by_offset(addr);
            if (rg != null) begin
              rg.read(st, data, .parent(this));
              if (sb_handle != null) sb_handle.record_rx(addr, data);
              return;
            end
          end
        end
      end
{% endif %}
      rg = reg_model.get_reg_by_offset(addr);
      if (rg != null)
        rg.read(st, data, .parent(this));
      else
        `uvm_error("REG", $sformatf("Read from unmapped address 0x%0h", addr))
    end else begin
      {{ spec.design_name }}_seq_item req_h;
      req_h = {{ spec.design_name }}_seq_item::type_id::create("req_h");
      start_item(req_h);
      if (!req_h.randomize() with { we == 0; addr == local::addr; delay == 0; })
        `uvm_fatal("RAND", "read_reg req_h randomization failed")
      finish_item(req_h);
      get_response(rsp);
      data = rsp.data;
    end
    if (sb_handle != null) sb_handle.record_rx(addr, data);
  endtask

  // ---------------------------------------------------------------
  // Helper: Report error to scoreboard
  // ---------------------------------------------------------------
  protected task record_error(string err_type, string msg);
    if (sb_handle != null) sb_handle.record_error(err_type, msg);
    `uvm_error("SEQ_ERR", $sformatf("[%s] %s", err_type, msg))
  endtask
endclass

// ---------------------------------------------------------------------------
// Write Register Sequence
// ---------------------------------------------------------------------------
class {{ spec.design_name }}_write_reg_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_write_reg_seq)

  rand logic [{{ addr_bits-1 }}:0] reg_addr;
  rand logic [{{ data_width-1 }}:0] write_data;

  constraint c_reg_addr { reg_addr inside { {% for r in sorted_regs if r.name|lower not in ro_regs %}{{ addr_bits }}'h{{ r.address[2:] }}{% if not loop.last %}, {% endif %}{% endfor %} }; }

  function new(string n = "{{ spec.design_name }}_write_reg_seq");
    super.new(n);
  endfunction

  task body;
    write_reg(reg_addr, write_data);
    `uvm_info("SEQ", $sformatf("Write reg[0x%0h] = 0x%0h", reg_addr, write_data), UVM_MEDIUM)
  endtask
endclass

// ---------------------------------------------------------------------------
// Read Register Sequence
// ---------------------------------------------------------------------------
class {{ spec.design_name }}_read_reg_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_read_reg_seq)

  rand logic [{{ addr_bits-1 }}:0] reg_addr;
  logic [{{ data_width-1 }}:0] read_data;

  constraint c_reg_addr { reg_addr inside { {% for r in sorted_regs %}{{ addr_bits }}'h{{ r.address[2:] }}{% if not loop.last %}, {% endif %}{% endfor %} }; }

  function new(string n = "{{ spec.design_name }}_read_reg_seq");
    super.new(n);
  endfunction

  task body;
    read_reg(reg_addr, read_data);
    `uvm_info("SEQ", $sformatf("Read reg[0x%0h] => 0x%0h", reg_addr, read_data), UVM_MEDIUM)
  endtask
endclass

// ---------------------------------------------------------------------------
// All Registers Sequence
// ---------------------------------------------------------------------------
class {{ spec.design_name }}_all_regs_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_all_regs_seq)

  function new(string n = "{{ spec.design_name }}_all_regs_seq");
    super.new(n);
  endfunction

  task body;
    logic [{{ addr_bits-1 }}:0] addrs[$];
    {% for r in sorted_regs if r.name|lower not in ro_regs %}
    addrs.push_back({{ addr_bits }}'h{{ r.address[2:] }});
    {% endfor %}
    foreach (addrs[i]) begin
      {{ spec.design_name }}_write_reg_seq wseq;
      {{ spec.design_name }}_read_reg_seq  rseq;
      wseq = {{ spec.design_name }}_write_reg_seq::type_id::create($sformatf("wseq_%0d", i));
      rseq = {{ spec.design_name }}_read_reg_seq::type_id::create($sformatf("rseq_%0d", i));
      if (!wseq.randomize() with { reg_addr == addrs[i]; write_data == (addrs[i]*16+5); })
        `uvm_fatal("RAND", "write_reg_seq randomization failed")
      wseq.start(m_sequencer);
      rseq = {{ spec.design_name }}_read_reg_seq::type_id::create($sformatf("rseq_rd_%0d", i));
      if (!rseq.randomize() with { reg_addr == addrs[i]; })
        `uvm_fatal("RAND", "read_reg_seq randomization failed")
      rseq.start(m_sequencer);
    end
  endtask
endclass

// ---------------------------------------------------------------------------
// Random Registers Sequence
// ---------------------------------------------------------------------------
class {{ spec.design_name }}_random_regs_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_random_regs_seq)

  rand logic [{{ data_width-1 }}:0] write_data[];
  rand bit         pattern_type;

  constraint c_size { write_data.size() == {{ (sorted_regs|rejectattr('name', 'in', ro_regs)|list)|length }}; }

  constraint c_patterns {
    if (pattern_type == 0) {
      foreach (write_data[i]) write_data[i] == (i * 32 + 5);
    } else {
      foreach (write_data[i]) write_data[i] inside {
        8'h00, 8'h01, 8'h02, 8'h04, 8'h08, 8'h10, 8'h20, 8'h40, 8'h80, 8'hFF,
        8'hAA, 8'h55, 8'hCC, 8'h33, 8'hFE, 8'hFD, 8'hFB, 8'hF7, 8'hEF, 8'hDF,
        8'hBF, 8'h7F, 8'h11, 8'h22, 8'h44, 8'h88, 8'h66, 8'h99, 8'hBB, 8'hDD
      };
    }
  }

  function new(string n = "{{ spec.design_name }}_random_regs_seq");
    super.new(n);
    pattern_type = 1;
  endfunction

  task body;
    logic [{{ addr_bits-1 }}:0] addrs[$];
    {% for r in sorted_regs if r.name|lower not in ro_regs %}
    addrs.push_back({{ addr_bits }}'h{{ r.address[2:] }});
    {% endfor %}
    foreach (addrs[i]) begin
      {{ spec.design_name }}_write_reg_seq wseq;
      {{ spec.design_name }}_read_reg_seq  rseq;
      wseq = {{ spec.design_name }}_write_reg_seq::type_id::create($sformatf("wseq_%0d", i));
      if (!wseq.randomize() with { reg_addr == addrs[i]; write_data == local::write_data[i]; })
        `uvm_fatal("RAND", "write_reg_seq randomization failed")
      `uvm_info("SEQ_RAND", $sformatf("Randomized write[%0d]: addr=0x%0h data=0x%02h",
                i, addrs[i], write_data[i]), UVM_HIGH)
      wseq.start(m_sequencer);
      rseq = {{ spec.design_name }}_read_reg_seq::type_id::create($sformatf("rseq_%0d", i));
      if (!rseq.randomize() with { reg_addr == addrs[i]; })
        `uvm_fatal("RAND", "read_reg_seq randomization failed")
      rseq.start(m_sequencer);
    end
  endtask
endclass

{% if p == "uart" %}

  {% set _reg_addr_set = sorted_regs|map(attribute='address')|map('lower')|list %}

// =========================================================================
//  UART-Specific Sequences — spec-driven: only generate sequences whose
//  required registers exist in the YAML register map.
// =========================================================================

// -------------------------------------------------------------------------
// UART Smoke / Sanity Sequence — reset, verify LSR[THRE], then configure
// Requires: LSR+THR (0x00+0x05) for status check, LCR (0x03) for config
// -------------------------------------------------------------------------
{% set _need_smoke = ('0x00' in _reg_addr_set or '0x0' in _reg_addr_set) and ('0x05' in _reg_addr_set or '0x5' in _reg_addr_set) %}
{% set _need_smoke = _need_smoke and ('0x03' in _reg_addr_set or '0x3' in _reg_addr_set or '0x003' in _reg_addr_set) %}
{% if _need_smoke %}
class {{ spec.design_name }}_smoke_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_smoke_seq)

  function new(string n = "{{ spec.design_name }}_smoke_seq");
    super.new(n);
  endfunction

  task body;
    logic [7:0] lsr_val;
    logic [7:0] thr_val;

    `uvm_info("SMOKE", "=== UART Smoke/Sanity Test ===", UVM_LOW)

    // 1. Read LSR — verify THRE (bit 5) and TEMT (bit 6) are set after reset
    read_reg({{ addr_bits }}'h05, lsr_val);
    `uvm_info("SMOKE", $sformatf("LSR after reset: 0x%02h (THRE=%0d, TEMT=%0d, DR=%0d)",
              lsr_val, lsr_val[5], lsr_val[6], lsr_val[0]), UVM_LOW)

    if (!lsr_val[5])
      `uvm_warning("SMOKE", "THRE not set — TX may not be ready")

    // 2. Configure UART at 115200 8N1 via LCR
    write_reg({{ addr_bits }}'h03, 8'b000_000_11); // 8-bit word, 1 stop, no parity
    read_reg({{ addr_bits }}'h03, lsr_val);
    `uvm_info("SMOKE", $sformatf("LCR configured: 0x%02h", lsr_val), UVM_LOW)

    // 3. Write a test byte to THR and read back (loopback not required for basic sanity)
    write_reg({{ addr_bits }}'h00, 8'hA5);
    repeat(100) @(posedge vif.clk);
    read_reg({{ addr_bits }}'h05, lsr_val);
    `uvm_info("SMOKE", $sformatf("After TX: LSR=0x%02h (THRE=%0d, TEMT=%0d)",
              lsr_val, lsr_val[5], lsr_val[6]), UVM_LOW)

    `uvm_info("SMOKE", "=== UART Smoke Test PASSED ===", UVM_LOW)
  endtask
endclass
{% endif %}

// -------------------------------------------------------------------------
// UART Configuration Sequence — sets baud, word length, stop bits, parity
// Requires: LCR (address 0x03)
// -------------------------------------------------------------------------
{% if '0x03' in _reg_addr_set or '0x3' in _reg_addr_set or '0x003' in _reg_addr_set %}
class {{ spec.design_name }}_config_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_config_seq)

  rand int baud_rate;
  rand int data_bits;
  rand int stop_bits;
  rand bit parity_en;
  rand bit even_parity;
  rand bit ascii_mode;

  constraint c_valid {
    baud_rate inside {9600, 19200, 38400, 57600, 115200, 1000000};
    data_bits inside {5, 6, 7, 8};
    stop_bits inside {1, 2};
  }

  function new(string n = "{{ spec.design_name }}_config_seq");
    super.new(n);
    baud_rate = 115200;
    data_bits = 8;
    stop_bits = 1;
    parity_en = 0;
    even_parity = 0;
    ascii_mode = 0;
  endfunction

  task body;
    logic [7:0] lcr_val;
    logic [15:0] divisor;

    // Allow config DB override of clock frequency
    void'(uvm_config_db #(int)::get(null, get_full_name(), "clk_freq", clk_freq));

    divisor = get_divisor(baud_rate);

    lcr_val[1:0] = get_wls(data_bits);
    lcr_val[2] = (stop_bits == 2) ? 1'b1 : 1'b0;
    lcr_val[3] = parity_en;
    lcr_val[4] = even_parity;
    lcr_val[7] = 1'b1;

    `uvm_info("{{ spec.design_name|upper }}_CFG", $sformatf("Configuring: Baud=%0d, Data bits=%0d, Stop bits=%0d, Parity=%0d",
              baud_rate, data_bits, stop_bits, parity_en), UVM_MEDIUM)

    write_reg({{ spec.design_name|upper }}_LCR_ADDR, lcr_val);
    write_reg({{ spec.design_name|upper }}_DLL_ADDR, divisor[7:0]);
    write_reg({{ spec.design_name|upper }}_DLH_ADDR, divisor[15:8]);
    lcr_val[7] = 1'b0;
    write_reg({{ spec.design_name|upper }}_LCR_ADDR, lcr_val);
    if (sb_handle != null) sb_handle.record_config(baud_rate, data_bits, stop_bits, parity_en, even_parity);
  endtask

  function logic [1:0] get_wls(int bits);
    case (bits)
      5: return 2'b00;
      6: return 2'b01;
      7: return 2'b10;
      8: return 2'b11;
      default: return 2'b11;
    endcase
  endfunction

  protected int clk_freq = 100_000_000;

  function void set_clk_freq(int freq);
    clk_freq = freq;
  endfunction

  function logic [15:0] get_divisor(int baud);
    return (clk_freq / (16 * baud));
  endfunction
endclass
{% endif %}  {# /LCR exists check for {{ spec.design_name }}_config_seq #}

// -------------------------------------------------------------------------
// UART Transmit Sequence — sends bytes via THR
// Requires: THR/RBR/DLL (address 0x00) and LSR (address 0x05)
// -------------------------------------------------------------------------
{% if ('0x00' in _reg_addr_set or '0x0' in _reg_addr_set) and ('0x05' in _reg_addr_set or '0x5' in _reg_addr_set) %}
class {{ spec.design_name }}_tx_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_tx_seq)

  rand logic [7:0] tx_data[$];
  int num_bytes;
  rand bit ascii_constraint;

  constraint c_tx_data {
    tx_data.size() == num_bytes;
    num_bytes inside {[1:32]};
    if (ascii_constraint) {
      foreach (tx_data[i]) tx_data[i] inside {[8'h20:8'h7E]};
    }
  }

  function new(string n = "{{ spec.design_name }}_tx_seq");
    super.new(n);
    num_bytes = 1;
    ascii_constraint = 0;
  endfunction

  task body;
    `uvm_info("{{ spec.design_name|upper }}_TX", $sformatf("Transmitting %0d bytes: %p", num_bytes, tx_data), UVM_MEDIUM)

    for (int i = 0; i < num_bytes; i++) begin
      wait_for_tx_empty();

      write_reg({{ spec.design_name|upper }}_THR_ADDR, tx_data[i]);
      if (sb_handle != null) sb_handle.record_tx({{ spec.design_name|upper }}_THR_ADDR, tx_data[i]);
      `uvm_info("{{ spec.design_name|upper }}_TX", $sformatf("Wrote byte: 0x%02h (%c)", tx_data[i], tx_data[i]), UVM_HIGH)
    end

    `uvm_info("{{ spec.design_name|upper }}_TX", "TX sequence complete", UVM_MEDIUM)
  endtask

  task wait_for_tx_empty(int timeout = 100000);
    logic [7:0] lsr_data;
    repeat (timeout) begin
      read_reg({{ spec.design_name|upper }}_LSR_ADDR, lsr_data);
      if (lsr_data[5]) begin
        return;
      end
      @(posedge vif.clk);
    end
    `uvm_error("{{ spec.design_name|upper }}_TX", "Timeout waiting for TX empty")
  endtask
endclass
{% endif %}  {# /THR+LSR check for {{ spec.design_name }}_tx_seq #}

// -------------------------------------------------------------------------
// UART Receive Sequence — waits for RX bytes via RBR
// Requires: LSR (0x05) and RBR/THR/DLL (0x00)
// -------------------------------------------------------------------------
{% if ('0x00' in _reg_addr_set or '0x0' in _reg_addr_set) and ('0x05' in _reg_addr_set or '0x5' in _reg_addr_set) %}
class {{ spec.design_name }}_rx_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_rx_seq)

  logic [7:0] rx_data[$];
  int expected_bytes = 1;
  int timeout_cycles = 100000;

  function new(string n = "{{ spec.design_name }}_rx_seq");
    super.new(n);
  endfunction

  task body;
    logic [7:0] lsr_val;
    int timeout_cnt = 0;

    `uvm_info("{{ spec.design_name|upper }}_RX", $sformatf("Waiting for %0d RX bytes", expected_bytes), UVM_MEDIUM)

    while (rx_data.size() < expected_bytes && timeout_cnt < timeout_cycles) begin
      read_reg({{ spec.design_name|upper }}_LSR_ADDR, lsr_val);

      if (lsr_val[0]) begin
        logic [7:0] data;
        read_reg({{ spec.design_name|upper }}_RBR_ADDR, data);
        rx_data.push_back(data);
        if (sb_handle != null) sb_handle.record_rx({{ spec.design_name|upper }}_RBR_ADDR, data);
        `uvm_info("{{ spec.design_name|upper }}_RX", $sformatf("Received byte: 0x%02h", data), UVM_HIGH)
      end else begin
        timeout_cnt++;
        @(posedge vif.clk);
      end
    end

    if (timeout_cnt >= timeout_cycles) begin
      `uvm_error("{{ spec.design_name|upper }}_RX", $sformatf("Timeout! Received %0d/%0d bytes", rx_data.size(), expected_bytes))
    end
  endtask
endclass
{% endif %}  {# /LSR+RBR check for {{ spec.design_name }}_rx_seq #}

// -------------------------------------------------------------------------
// UART Loopback Sequence — enables MCR loopback, TX/RX comparison
// Requires: MCR (0x04), THR/RBR (0x00), LSR (0x05)
// -------------------------------------------------------------------------
{% set _lb_addrs = _reg_addr_set %}
{% if ('0x04' in _lb_addrs or '0x4' in _lb_addrs) and ('0x00' in _lb_addrs or '0x0' in _lb_addrs) and ('0x05' in _lb_addrs or '0x5' in _lb_addrs) %}
class {{ spec.design_name }}_loopback_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_loopback_seq)

  rand logic [7:0] test_data[$];
  int num_passes = 0;
  int errors = 0;
  int rx_timeout = 500000;

  constraint c_test_data {
    test_data.size() inside {[1:16]};
  }

  function new(string n = "{{ spec.design_name }}_loopback_seq");
    super.new(n);
  endfunction

  task body;
    logic [7:0] mcr_val;

    `uvm_info("{{ spec.design_name|upper }}_LB", "Starting loopback test", UVM_MEDIUM)

    read_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);
    mcr_val[4] = 1'b1;
    write_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);
    `uvm_info("{{ spec.design_name|upper }}_LB", "Loopback enabled (MCR[4]=1)", UVM_MEDIUM)

    foreach (test_data[i]) begin
      logic [7:0] rx_byte;
      bit received;

      write_reg({{ spec.design_name|upper }}_THR_ADDR, test_data[i]);
      `uvm_info("{{ spec.design_name|upper }}_LB", $sformatf("TX[%0d] = 0x%02h", i, test_data[i]), UVM_MEDIUM)

      {{ spec.design_name }}_wait_for_rx(rx_byte, received);

      if (received) begin
        if (rx_byte === test_data[i]) begin
          num_passes++;
          `uvm_info("{{ spec.design_name|upper }}_LB", $sformatf("Loopback MATCH[%0d]: TX=0x%02h RX=0x%02h",
                    i, test_data[i], rx_byte), UVM_MEDIUM)
          if (sb_handle != null) sb_handle.record_tx({{ spec.design_name|upper }}_THR_ADDR, test_data[i]);
        end else begin
          errors++;
          `uvm_error("{{ spec.design_name|upper }}_LB", $sformatf("Loopback MISMATCH[%0d]: TX=0x%02h RX=0x%02h",
                     i, test_data[i], rx_byte))
          if (sb_handle != null) begin
            record_error("LOOPBACK", $sformatf("Mismatch[%0d]: TX=0x%02h RX=0x%02h", i, test_data[i], rx_byte));
          end
        end
      end else begin
        errors++;
        `uvm_error("{{ spec.design_name|upper }}_LB", $sformatf("Loopback timeout[%0d]: TX=0x%02h no RX data received",
                   i, test_data[i]))
        if (sb_handle != null) record_error("LOOPBACK_TIMEOUT", $sformatf("Timeout[%0d]", i));
      end
    end

    mcr_val[4] = 1'b0;
    write_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);
    `uvm_info("{{ spec.design_name|upper }}_LB", "Loopback disabled (MCR[4]=0)", UVM_MEDIUM)

    `uvm_info("{{ spec.design_name|upper }}_LB", $sformatf(
      "\n  === Loopback Test Results ==="
      "\n  Bytes Transmitted: %0d"
      "\n  Bytes Matched:     %0d"
      "\n  Errors:            %0d",
      test_data.size(), num_passes, errors
    ), UVM_LOW)
  endtask

  protected task {{ spec.design_name }}_wait_for_rx(output logic [7:0] data, output bit received);
    int timeout = rx_timeout;
    logic [7:0] lsr_val;
    received = 0;
    while (timeout > 0 && !received) begin
      read_reg({{ spec.design_name|upper }}_LSR_ADDR, lsr_val);
      if (lsr_val[0]) begin
        read_reg({{ spec.design_name|upper }}_RBR_ADDR, data);
        received = 1;
      end else begin
        timeout--;
        @(posedge vif.clk);
      end
    end
    if (!received) begin
      data = 'x;
    end
  endtask
endclass
{% endif %}  {# /MCR+THR+LSR check for {{ spec.design_name }}_loopback_seq #}

// -------------------------------------------------------------------------
// UART Interrupt Sequence — test each interrupt type
// Requires: IER (0x01), IIR (0x02), MCR (0x04), THR (0x00), LCR (0x03)
// -------------------------------------------------------------------------
{% if ('0x01' in _reg_addr_set or '0x1' in _reg_addr_set) and ('0x02' in _reg_addr_set or '0x2' in _reg_addr_set) and ('0x04' in _reg_addr_set or '0x4' in _reg_addr_set) and ('0x00' in _reg_addr_set or '0x0' in _reg_addr_set) and ('0x03' in _reg_addr_set or '0x3' in _reg_addr_set) %}
class {{ spec.design_name }}_interrupt_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_interrupt_seq)

  typedef enum {
    INT_RX_DATA, INT_TX_EMPTY, INT_LINE_STATUS, INT_MODEM_STATUS
  } int_type_t;

  rand int_type_t int_type;
  bit interrupt_detected;
  int irq_assertions;
  bit timeout_hit;

  function new(string n = "{{ spec.design_name }}_interrupt_seq");
    super.new(n);
    interrupt_detected = 0;
    irq_assertions = 0;
  endfunction

  task body;
    logic [7:0] ier_val;
    logic [7:0] iir_val;

    `uvm_info("{{ spec.design_name|upper }}_INT", $sformatf("Testing interrupt type: %s", int_type.name()), UVM_MEDIUM)

    case (int_type)
      INT_RX_DATA:    ier_val = 8'h01;
      INT_TX_EMPTY:  ier_val = 8'h02;
      INT_LINE_STATUS: ier_val = 8'h04;
      INT_MODEM_STATUS: ier_val = 8'h08;
    endcase

    write_reg({{ spec.design_name|upper }}_IER_ADDR, ier_val);

    fork
      wait_for_intr_signal();
      trigger_intr();
      begin
        #10ms;
        timeout_hit = 1'b1;
      end
    join_any
    disable fork;
    if (timeout_hit)
      `uvm_warning("{{ spec.design_name|upper }}_INT", "Interrupt test timed out after 10 ms")

    read_reg({{ spec.design_name|upper }}_IIR_ADDR, iir_val);

    if (iir_val[0] == 1'b0) begin
      `uvm_info("{{ spec.design_name|upper }}_INT", $sformatf("Interrupt pending, IIR = 0x%02h", iir_val), UVM_MEDIUM)
      interrupt_detected = 1;
    end else begin
      `uvm_warning("{{ spec.design_name|upper }}_INT", $sformatf("No interrupt pending after stimulus, IIR=0x%02h", iir_val))
    end

    if (sb_handle != null) begin
      sb_handle.check_interrupt(iir_val, interrupt_detected);
      sb_handle.check_interrupt_cause(iir_val);
    end
  endtask

  task wait_for_intr_signal();
    int timeout = 200000;
    for (int i = 0; i < timeout; i++) begin
      @(posedge vif.clk);
      if (vif.{{ spec.design_name }}_intr) begin
        irq_assertions++;
        `uvm_info("{{ spec.design_name|upper }}_INT", $sformatf("Interrupt asserted on {{ spec.design_name }}_intr (count=%0d)", irq_assertions), UVM_MEDIUM)
        if (irq_assertions >= 1) return;
      end
    end
    `uvm_warning("{{ spec.design_name|upper }}_INT", "Timeout waiting for interrupt signal")
  endtask

  task trigger_intr();
    case (int_type)
      INT_TX_EMPTY: begin
        #100ns;
        write_reg({{ spec.design_name|upper }}_THR_ADDR, 8'hAA);
        `uvm_info("{{ spec.design_name|upper }}_INT", "Trigger: TX data written to THR", UVM_MEDIUM)
      end
      INT_RX_DATA: begin
        logic [7:0] mcr_val;
        read_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);
        mcr_val[4] = 1'b1;
        write_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);
        `uvm_info("{{ spec.design_name|upper }}_INT", "Trigger: Loopback enabled (MCR[4]=1)", UVM_MEDIUM)
        #100ns;
        write_reg({{ spec.design_name|upper }}_THR_ADDR, 8'h55);
        `uvm_info("{{ spec.design_name|upper }}_INT", "Trigger: TX byte 0x55 written, expected to echo to RBR", UVM_MEDIUM)
        #10us;
      end
      INT_LINE_STATUS: begin
        logic [7:0] lcr_val;
        read_reg({{ spec.design_name|upper }}_LCR_ADDR, lcr_val);
        lcr_val[3] = 1'b1;
        lcr_val[4] = 1'b1;
        lcr_val[5] = 1'b0;
        write_reg({{ spec.design_name|upper }}_LCR_ADDR, lcr_val);
        `uvm_info("{{ spec.design_name|upper }}_INT", "Trigger: Even parity enabled in LCR", UVM_MEDIUM)
        #100ns;
        write_reg({{ spec.design_name|upper }}_THR_ADDR, 8'hA5);
        `uvm_info("{{ spec.design_name|upper }}_INT", "Trigger: TX byte 0xA5 (no parity bit in data)", UVM_MEDIUM)
        #20us;
        lcr_val[3] = 1'b0;
        write_reg({{ spec.design_name|upper }}_LCR_ADDR, lcr_val);
      end
      INT_MODEM_STATUS: begin
        logic [7:0] mcr_val;
        read_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);
        mcr_val[0] = ~mcr_val[0];
        write_reg({{ spec.design_name|upper }}_MCR_ADDR, mcr_val);
        `uvm_info("{{ spec.design_name|upper }}_INT", "Trigger: Modem control toggled (MCR[0])", UVM_MEDIUM)
        #10us;
      end
    endcase
  endtask
endclass
{% endif %}  {# /IIR+IER+MCR+THR+LCR check for {{ spec.design_name }}_interrupt_seq #}

// -------------------------------------------------------------------------
// UART Baud Change Sequence — sweep all supported baud rates
// Requires: LCR (0x03) for config_seq, THR+LSR (0x00+0x05) for tx_seq
// -------------------------------------------------------------------------
{% set _need_tx = ('0x00' in _reg_addr_set or '0x0' in _reg_addr_set) and ('0x05' in _reg_addr_set or '0x5' in _reg_addr_set) %}
{% set _need_lcr = '0x03' in _reg_addr_set or '0x3' in _reg_addr_set or '0x003' in _reg_addr_set %}
{% if _need_lcr and _need_tx %}
class {{ spec.design_name }}_baud_change_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_baud_change_seq)

  int baud_rates[$] = {9600, 19200, 38400, 57600, 115200, 1000000};

  function new(string n = "{{ spec.design_name }}_baud_change_seq");
    super.new(n);
  endfunction

  task body;
    foreach (baud_rates[i]) begin
      {{ spec.design_name }}_config_seq cfg_seq;
      {{ spec.design_name }}_tx_seq tx_seq;

      `uvm_info("{{ spec.design_name|upper }}_BAUD", $sformatf("Testing baud rate: %0d", baud_rates[i]), UVM_MEDIUM)

      cfg_seq = {{ spec.design_name }}_config_seq::type_id::create($sformatf("cfg_seq_%0d", i));
      cfg_seq.baud_rate = baud_rates[i];
      cfg_seq.data_bits = 8;
      cfg_seq.stop_bits = 1;
      cfg_seq.start(m_sequencer);

      tx_seq = {{ spec.design_name }}_tx_seq::type_id::create($sformatf("tx_seq_%0d", i));
      tx_seq.tx_data = {8'h55, 8'hAA, 8'h33, 8'hCC};
      tx_seq.num_bytes = 4;
      tx_seq.start(m_sequencer);

      #100us;
    end
  endtask
endclass
{% endif %}  {# /LCR+THR+LSR check for {{ spec.design_name }}_baud_change_seq #}

// -------------------------------------------------------------------------
// UART Error Injection Sequence — injects parity, framing, break errors
// Uses driver-level corruption via seq_item corruption flags (not register
// manipulation).  The driver reads corrupt_parity / corrupt_stop_bit /
// force_break during serialisation and corrupts the TX bitstream at the
// pin level.  This is the IEEE 1800.2-correct method.
// Requires: THR (0x00), LSR (0x05)
// -------------------------------------------------------------------------
{% if ('0x00' in _reg_addr_set or '0x0' in _reg_addr_set) and ('0x05' in _reg_addr_set or '0x5' in _reg_addr_set) %}
class {{ spec.design_name }}_error_injection_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_error_injection_seq)

  typedef enum {
    INJ_PARITY, INJ_FRAMING, INJ_BREAK, INJ_ALL
  } inj_type_t;

  rand inj_type_t inj_type;
  rand int        num_injections;
  int             injected_count;
  int             observed_errors;

  constraint c_inj_count { num_injections inside {[1:16]}; }

  function new(string n = "{{ spec.design_name }}_error_injection_seq");
    super.new(n);
    num_injections = 3;
    injected_count = 0;
    observed_errors = 0;
  endfunction

  task body;
    logic [7:0] lsr_val;

    `uvm_info("{{ spec.design_name|upper }}_INJ", $sformatf("Starting error injection: %s, count=%0d",
              inj_type.name(), num_injections), UVM_LOW)

    if (sb_handle != null) begin
      sb_handle.configure_injection(inj_type.name(), num_injections);
    end else begin
      `uvm_warning("{{ spec.design_name|upper }}_INJ", "sb_handle null — configure_injection() not supported, scoreboard may not track injections")
    end

    for (int i = 0; i < num_injections; i++) begin
      {{ spec.design_name }}_seq_item inj_req;
      inj_req = {{ spec.design_name }}_seq_item::type_id::create($sformatf("inj_req_%0d", i));
      start_item(inj_req);

      case (inj_type)
        INJ_PARITY: begin
          if (!inj_req.randomize() with {
            we == 1;
            addr == {{ addr_bits }}'h0;
            data == 8'hA5;
            delay == 0;
            corrupt_parity == 1;
            corrupt_stop_bit == 0;
            force_break == 0;
          }) `uvm_fatal("RAND", "Parity injection req randomization failed")
        end
        INJ_FRAMING: begin
          if (!inj_req.randomize() with {
            we == 1;
            addr == {{ addr_bits }}'h0;
            data == 8'h5A;
            delay == 0;
            corrupt_parity == 0;
            corrupt_stop_bit == 1;
            force_break == 0;
          }) `uvm_fatal("RAND", "Framing injection req randomization failed")
        end
        INJ_BREAK: begin
          if (!inj_req.randomize() with {
            we == 1;
            addr == {{ addr_bits }}'h0;
            data == 8'h00;
            delay == 0;
            corrupt_parity == 0;
            corrupt_stop_bit == 0;
            force_break == 1;
          }) `uvm_fatal("RAND", "Break injection req randomization failed")
        end
        INJ_ALL: begin
          if (i % 3 == 0)
            if (!inj_req.randomize() with {
              we == 1; addr == {{ addr_bits }}'h0; data == 8'hA5; delay == 0;
              corrupt_parity == 1; corrupt_stop_bit == 0; force_break == 0;
            }) `uvm_fatal("RAND", "All-injection parity req failed")
          if (i % 3 == 1)
            if (!inj_req.randomize() with {
              we == 1; addr == {{ addr_bits }}'h0; data == 8'h5A; delay == 0;
              corrupt_parity == 0; corrupt_stop_bit == 1; force_break == 0;
            }) `uvm_fatal("RAND", "All-injection framing req failed")
          if (i % 3 == 2)
            if (!inj_req.randomize() with {
              we == 1; addr == {{ addr_bits }}'h0; data == 8'h00; delay == 0;
              corrupt_parity == 0; corrupt_stop_bit == 0; force_break == 1;
            }) `uvm_fatal("RAND", "All-injection break req failed")
        end
      endcase

      finish_item(inj_req);
      injected_count++;

      #5us;
      read_reg({{ spec.design_name|upper }}_LSR_ADDR, lsr_val);
      case (inj_type)
        INJ_PARITY: begin
          if (lsr_val[2]) begin
            observed_errors++;
            `uvm_info("{{ spec.design_name|upper }}_INJ", $sformatf("Parity error observed LSR[2]: 0x%02h", lsr_val), UVM_MEDIUM)
          end else begin
            `uvm_warning("{{ spec.design_name|upper }}_INJ", "Parity error flag not set in LSR after driver corruption")
          end
        end
        INJ_FRAMING: begin
          if (lsr_val[3]) begin
            observed_errors++;
            `uvm_info("{{ spec.design_name|upper }}_INJ", $sformatf("Framing error observed LSR[3]: 0x%02h", lsr_val), UVM_MEDIUM)
          end else begin
            `uvm_warning("{{ spec.design_name|upper }}_INJ", "Framing error flag not set in LSR after driver corruption")
          end
        end
        INJ_BREAK: begin
          if (lsr_val[4]) begin
            observed_errors++;
            `uvm_info("{{ spec.design_name|upper }}_INJ", $sformatf("Break observed LSR[4]: 0x%02h", lsr_val), UVM_MEDIUM)
          end else begin
            `uvm_warning("{{ spec.design_name|upper }}_INJ", "Break flag not set in LSR after driver corruption")
          end
        end
        INJ_ALL: begin
          if (lsr_val[2] || lsr_val[3] || lsr_val[4])
            observed_errors++;
        end
      endcase
    end

    if (injected_count > 0) begin
      `uvm_info("{{ spec.design_name|upper }}_INJ", $sformatf(
        "\n  === Error Injection Report ==="
        "\n  Type:           %s"
        "\n  Injected:       %0d"
        "\n  Observed in HW: %0d"
        "\n  Detection Rate: %0d/100",
        inj_type.name(), injected_count, observed_errors,
        (injected_count > 0) ? (observed_errors * 100 / injected_count) : 0
      ), UVM_LOW)
    end
  endtask
endclass
{% endif %}  {# /THR+LSR check for {{ spec.design_name }}_error_injection_seq #}

// -------------------------------------------------------------------------
// RO Register Write-Protection Test — verifies writes to read-only registers
// are rejected by the DUT. Reads each RO register, attempts write, reads back
// and confirms value unchanged.
// -------------------------------------------------------------------------
{% set ro_list = regs|selectattr('access', 'equalto', 'ro')|list %}
{% if ro_list %}
class {{ spec.design_name }}_ro_write_protect_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_ro_write_protect_seq)

  rand int num_ro_regs;
  int violations;

  function new(string n = "{{ spec.design_name }}_ro_write_protect_seq");
    super.new(n);
  endfunction

  task body;
    logic [7:0] val_before;
    logic [7:0] val_after;
    logic [7:0] wr_data;
    violations = 0;

    `uvm_info("RO_PROTECT", $sformatf("=== RO Write Protection Test (%0d RO registers) ===", {% for r in ro_list %} 1 {% if not loop.last %} + {% endif %}{% endfor %}), UVM_LOW)

{% for r in ro_list %}
    begin
      read_reg({{ addr_bits }}'h{{ r.address[2:] }}, val_before);
      wr_data = ~val_before;
      write_reg({{ addr_bits }}'h{{ r.address[2:] }}, wr_data);
      read_reg({{ addr_bits }}'h{{ r.address[2:] }}, val_after);
      if (val_after == val_before) begin
        `uvm_info("RO_PROTECT", $sformatf("  %-10s @ 0x%0h: write-protected OK (val=0x%02h)",
                  "{{ r.name }}", {{ addr_bits }}'h{{ r.address[2:] }}, val_after), UVM_LOW)
      end else begin
        `uvm_error("RO_PROTECT", $sformatf("  %-10s @ 0x%0h: RO violation! Before=0x%02h, After write 0x%02h=0x%02h",
                   "{{ r.name }}", {{ addr_bits }}'h{{ r.address[2:] }}, val_before, wr_data, val_after))
        violations++;
      end
    end
{% endfor %}

    if (violations == 0)
      `uvm_info("RO_PROTECT", "*** All RO registers properly write-protected ***", UVM_LOW)
    else
      `uvm_error("RO_PROTECT", $sformatf("*** %0d RO register(s) NOT write-protected! ***", violations))
  endtask
endclass
{% endif %}

// -------------------------------------------------------------------------
// UART LSR Status Sequence — verifies LSR status bits:
//   DR[0], OE[1], PE[2], FE[3], BI[4], THRE[5], TEMT[6]
// -------------------------------------------------------------------------
{% if '0x05' in _reg_addr_set or '0x5' in _reg_addr_set %}
class {{ spec.design_name }}_lsr_status_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_lsr_status_seq)

  bit thre_ok;
  bit temt_ok;
  bit dr_ok;

  function new(string n = "{{ spec.design_name }}_lsr_status_seq");
    super.new(n);
  endfunction

  task body;
    logic [7:0] lsr_val;

    `uvm_info("LSR_STAT", "=== LSR Status Verification ===", UVM_LOW)

    // 1. Verify THRE (bit 5) — should be set after reset (TX empty)
    read_reg({{ addr_bits }}'h05, lsr_val);
    thre_ok = lsr_val[5];
    temt_ok = lsr_val[6];

    `uvm_info("LSR_STAT", $sformatf("After reset: LSR=0x%02h (THRE=%0d, TEMT=%0d, DR=%0d)",
              lsr_val, lsr_val[5], lsr_val[6], lsr_val[0]), UVM_LOW)

    if (!thre_ok)
      `uvm_warning("LSR_STAT", "THRE not set after reset — TX not ready")
    if (!temt_ok)
      `uvm_warning("LSR_STAT", "TEMT not set after reset — TX not empty")

{% if ('0x00' in _reg_addr_set or '0x0' in _reg_addr_set) %}
    // 2. Write to THR (0x00) — THRE should clear momentarily
    write_reg({{ addr_bits }}'h00, 8'hA5);
    repeat(100) @(posedge vif.clk);
    read_reg({{ addr_bits }}'h05, lsr_val);
    `uvm_info("LSR_STAT", $sformatf("After THR write: LSR=0x%02h (THRE=%0d, TEMT=%0d)",
              lsr_val, lsr_val[5], lsr_val[6]), UVM_LOW)
{% endif %}

    `uvm_info("LSR_STAT", "=== LSR Status Verification Complete ===", UVM_LOW)
  endtask
endclass
{% endif %}

// -------------------------------------------------------------------------
// UART Parity Injection Sequence — dedicated parity error injection with
// LSR.PE verification. Configures parity, injects corrupted TX, checks LSR.
// -------------------------------------------------------------------------
{% if ('0x00' in _reg_addr_set or '0x0' in _reg_addr_set) and ('0x03' in _reg_addr_set or '0x3' in _reg_addr_set) and ('0x05' in _reg_addr_set or '0x5' in _reg_addr_set) %}
class {{ spec.design_name }}_parity_inject_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_parity_inject_seq)

  rand int num_injections;
  int pe_detected;
  int pe_missed;

  constraint c_parity_count { num_injections inside {[1:8]}; }

  function new(string n = "{{ spec.design_name }}_parity_inject_seq");
    super.new(n);
    num_injections = 3;
  endfunction

  task body;
    logic [7:0] lcr_val;
    logic [7:0] lsr_val;
    logic [7:0] data_to_send;

    `uvm_info("PAR_INJ", $sformatf("=== Parity Injection Test (%0d injections) ===", num_injections), UVM_LOW)

    // Configure parity: enable, even parity (LCR PEN=1, EPS=1)
    read_reg({{ addr_bits }}'h03, lcr_val);
    lcr_val[3] = 1; // PEN
    lcr_val[4] = 1; // EPS (even parity)
    write_reg({{ addr_bits }}'h03, lcr_val);
    `uvm_info("PAR_INJ", $sformatf("LCR configured for even parity: 0x%02h", lcr_val), UVM_LOW)

    for (int i = 0; i < num_injections; i++) begin
      {{ spec.design_name }}_seq_item inj_req;
      inj_req = {{ spec.design_name }}_seq_item::type_id::create($sformatf("par_inj_%0d", i));

      data_to_send = $urandom_range(0, 255);

      start_item(inj_req);
      if (!inj_req.randomize() with {
        we == 1;
        addr == {{ addr_bits }}'h0;
        data == data_to_send;
        delay == 0;
        corrupt_parity == 1;
        corrupt_stop_bit == 0;
        force_break == 0;
      }) `uvm_fatal("RAND", "Parity injection randomization failed")
      finish_item(inj_req);

      repeat(500) @(posedge vif.clk);

      // Read LSR to check parity error flag
      read_reg({{ addr_bits }}'h05, lsr_val);
      if (lsr_val[2]) begin
        pe_detected++;
        `uvm_info("PAR_INJ", $sformatf("Inj %0d: parity error DETECTED LSR[2]=1 (data=0x%02h)", i, data_to_send), UVM_LOW)
      end else begin
        pe_missed++;
        `uvm_error("PAR_INJ", $sformatf("Inj %0d: parity error NOT detected LSR[2]=0 (data=0x%02h)", i, data_to_send))
      end

      // Clear LSR by reading it
      read_reg({{ addr_bits }}'h05, lsr_val);
    end

    `uvm_info("PAR_INJ", $sformatf(
      "=== Parity Test Report: %0d/%0d detected, %0d missed ===",
      pe_detected, num_injections, pe_missed), UVM_LOW)

    if (pe_missed > 0)
      `uvm_error("PAR_INJ", $sformatf("Parity error detection FAILED: %0d/%0d missed", pe_missed, num_injections))
    else
      `uvm_info("PAR_INJ", "Parity error detection PASSED", UVM_LOW)
  endtask
endclass
{% endif %}

