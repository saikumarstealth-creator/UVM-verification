class {{ spec.design_name }}_spi_clock_mode_seq extends {{ spec.design_name }}_base_seq;
  `uvm_object_utils({{ spec.design_name }}_spi_clock_mode_seq)

  rand int cpol;
  rand int cpha;

  constraint c_mode { cpol inside {[0:1]}; cpha inside {[0:1]}; }

  function new(string n = "{{ spec.design_name }}_spi_clock_mode_seq");
    super.new(n);
  endfunction

  task body;
    `uvm_info("SPI_MODE", $sformatf("SPI mode: CPOL=%0d CPHA=%0d", cpol, cpha), UVM_LOW)

    write_reg(6, {6'b0, cpha, cpol});

    write_reg(1, 8'h01);
    write_reg(2, 8'hA5);
    #500;
    write_reg(2, 8'h5A);
    #500;
    write_reg(2, 8'hFF);
    #500;
    write_reg(1, 8'h00);

    `uvm_info("SPI_MODE", "SPI clock mode test complete", UVM_MEDIUM)
  endtask
endclass

