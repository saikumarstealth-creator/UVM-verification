    wr_seq.start(p_sequencer.bus_seqr);

    rd_seq = {{ spec.design_name }}_axi_read_burst_seq::type_id::create("rd_seq");
    rd_seq.reg_model = reg_model;
    rd_seq.burst_len = 4;
    rd_seq.start(p_sequencer.bus_seqr);

    cmp_seq = {{ spec.design_name }}_axi_write_read_cmp_seq::type_id::create("cmp_seq");
    cmp_seq.reg_model = reg_model;
    cmp_seq.target_addr = 0; cmp_seq.write_val = 8'hA5;
    cmp_seq.start(p_sequencer.bus_seqr);

    out_seq = {{ spec.design_name }}_axi_outstanding_seq::type_id::create("out_seq");
    out_seq.reg_model = reg_model;
    out_seq.outstanding_count = 4;
    out_seq.start(p_sequencer.bus_seqr);

    `uvm_info("AXI_VSEQ", "AXI virtual sequence complete", UVM_LOW)
  endtask
endclass

