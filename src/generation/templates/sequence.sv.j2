    for (int i = 0; i < burst_len; i++) begin
      logic [7:0] rd_data;
      {{ spec.design_name }}_seq_item rd_req;
      rd_req = {{ spec.design_name }}_seq_item::type_id::create($sformatf("axi_rd_%0d", i));
      start_item(rd_req);
      if (!rd_req.randomize() with {
        we == 0; addr == i; delay == 0;
      }) `uvm_fatal("RAND", "AXI read req randomization failed")
      finish_item(rd_req);
      get_response(rsp);
