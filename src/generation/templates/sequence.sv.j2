  endtask

  task body;
    {{ spec.design_name }}_axi_write_burst_seq    wr_seq;
    {{ spec.design_name }}_axi_read_burst_seq     rd_seq;
    {{ spec.design_name }}_axi_write_read_cmp_seq cmp_seq;
    {{ spec.design_name }}_axi_outstanding_seq    out_seq;

    `uvm_info("AXI_VSEQ", "Starting AXI virtual sequence", UVM_LOW)

