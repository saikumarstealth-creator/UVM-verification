// UVM Protocol Compliance Checker for {{ spec.design_name }} ({{ spec.protocol|default("wishbone", true) }})
// Monitors bus transactions and validates against protocol specification rules.
{% set p = spec.protocol|default("wishbone") %}
{% set iface = spec.interfaces[0] if spec.interfaces else None %}
{% set sigs = iface.signals if iface else [] %}

class {{ spec.design_name }}_protocol_checker extends uvm_monitor;
  `uvm_component_utils({{ spec.design_name }}_protocol_checker)

  virtual {{ spec.design_name }}_interface vif;
  uvm_analysis_port #({{ spec.design_name }}_seq_item) item_port;

  // Protocol violation counters
  int num_violations;
  int num_transactions_checked;

  // Violation bitmask
  typedef enum bit [3:0] {
    VIOL_NONE      = 4'b0000,
    VIOL_TIMING    = 4'b0001,
    VIOL_HANDSHAKE = 4'b0010,
    VIOL_DATA      = 4'b0100,
    VIOL_PROTOCOL  = 4'b1000
  } violation_e;

  function new(string n, uvm_component p);
    super.new(n, p);
    item_port = new("item_port", this);
    num_violations = 0;
    num_transactions_checked = 0;
  endfunction

  function void build_phase(uvm_phase phase);
    super.build_phase(phase);
    if (!uvm_config_db #(virtual {{ spec.design_name }}_interface)::get(this, "", "vif", vif))
      `uvm_fatal("CFG", "Virtual interface not found for protocol checker")
  endfunction

  task run_phase(uvm_phase phase);
    fork
      monitor_uprotocol();
      monitor_timing();
    join_none
  endtask

  // -------------------------------------------------------------------------
  // Protocol State Machine & Transaction Monitoring
  // -------------------------------------------------------------------------
  task monitor_uprotocol();
{% if p == "apb" %}
    apb_protocol_monitor();
{% elif p == "uart" %}
    uart_protocol_monitor();
{% elif p == "wishbone" %}
    wishbone_protocol_monitor();
{% elif p in ("spi", "i2c") %}
    serial_protocol_monitor();
{% else %}
    generic_protocol_monitor();
{% endif %}
  endtask

{% if p == "apb" %}
  // APB Protocol Checker
  task apb_protocol_monitor();
    forever begin
      @(posedge vif.{{ spec.clock_reset.clock }});
      if (!vif.{{ spec.clock_reset.reset }}) begin
        // During reset: all signals should be inactive
        if (vif.psel !== 1'b0)
          report_violation(VIOL_PROTOCOL, "PSEL must be 0 during reset");
        continue;
      end

      // Detect transaction start: PSEL asserted
      if (vif.psel && vif.penable && vif.pready) begin
        num_transactions_checked++;
        // Check write data vs read data setup
        if (vif.pwrite) begin
          // Write transaction
          check_apb_write();
        end else begin
          // Read transaction
          check_apb_read();
        end
      end

      // Penalty check assertion timing
      if (vif.penable && !vif.psel)
        report_violation(VIOL_HANDSHAKE, "PENABLE asserted without PSEL");

      // PSLVERR must be valid when PREADY
      if (vif.pready && $isunknown(vif.pslverr))
        report_violation(VIOL_DATA, "PSLVERR is X/Z when PREADY asserted");
    end
  endtask

  task check_apb_write();
    // Validate write strobe timing
    if (vif.pstrb && $isunknown(vif.pwdata))
      report_violation(VIOL_DATA, "PWDATA X/Z when PSTRB active");
  endtask

  task check_apb_read();
    // Validate read data timing
    if ($isunknown(vif.prdata))
      report_violation(VIOL_DATA, "PRDATA is X/Z during read transfer");
  endtask

{% elif p == "uart" %}
  // UART Protocol Checker
  task uart_protocol_monitor();
    logic [7:0] rx_shift;
    int bit_count;
    bit in_frame;

    forever begin
      @(posedge vif.{{ spec.clock_reset.clock }});
      if (!vif.{{ spec.clock_reset.reset }}) begin
        in_frame = 0;
        bit_count = 0;
        continue;
      end

      // Detect start bit: TX or RX line goes low
      if (!in_frame && vif.tx == 1'b0) begin
        in_frame = 1;
        bit_count = 0;
        num_transactions_checked++;
      end

      if (in_frame) begin
        bit_count++;
        // After 10 bit times (start + 8 data + stop), frame should end
        if (bit_count > 10) begin
          if (vif.tx !== 1'b1)
            report_violation(VIOL_TIMING, "Stop bit not high");
          in_frame = 0;
        end
      end

      // Overrun check: new start while previous frame not read
      if (vif.rx === 1'b0 && $past(vif.rx) === 1'b1 && in_frame)
        report_violation(VIOL_PROTOCOL, "Potential overrun: new start before frame complete");
    end
  endtask

{% elif p == "wishbone" %}
  // Wishbone Protocol Checker
  task wishbone_protocol_monitor();
    forever begin
      @(posedge vif.{{ spec.clock_reset.clock }});
      if (!vif.{{ spec.clock_reset.reset }}) continue;

      if (vif.cyc && vif.stb && vif.ack) begin
        num_transactions_checked++;
        // Check data valid
        if (vif.we && $isunknown(vif.dat_o))
          report_violation(VIOL_DATA, "DAT_O X/Z during write cycle");
      end

      // STB without CYC
      if (vif.stb && !vif.cyc)
        report_violation(VIOL_HANDSHAKE, "STB asserted without CYC");

      // ACK without STB
      if (vif.ack && !vif.stb)
        report_violation(VIOL_HANDSHAKE, "ACK asserted without STB");
    end
  endtask

{% elif p in ("spi", "i2c") %}
  // Serial Protocol Checker
  task serial_protocol_monitor();
    forever begin
      @(posedge vif.{{ spec.clock_reset.clock }});
      if (!vif.{{ spec.clock_reset.reset }}) continue;
      {% if p == "spi" %}
      if (!vif.cs_n && $rose(vif.sclk)) begin
        num_transactions_checked++;
      end
      // CS must be low during entire transaction
      if ($fell(vif.cs_n) && $past(vif.cs_n, 2) === 1'b1)
        ; // Transaction start — OK
      {% endif %}
      {% if p == "i2c" %}
      // Start condition: SDA falling while SCL high
      if (vif.scl && $fell(vif.sda))
        num_transactions_checked++;
      // Stop condition: SDA rising while SCL high
      if (vif.scl && $rose(vif.sda))
        ; // Transaction end — OK
      {% endif %}
    end
  endtask

{% else %}
  // Generic Protocol Checker
  task generic_protocol_monitor();
    forever begin
      @(posedge vif.{{ spec.clock_reset.clock }});
      if (!vif.{{ spec.clock_reset.reset }}) continue;
      // Basic transaction detection: look for any signal activity
{% for sig in sigs if sig.direction in ('input', 'inout') %}
      if ($changed(vif.{{ sig.name }}))
        num_transactions_checked++;
{% endfor %}
      #1;
    end
  endtask

{% endif %}

  // -------------------------------------------------------------------------
  // Timing Monitoring
  // -------------------------------------------------------------------------
  task monitor_timing();
    int timeout_cycles = 1000;

    forever begin
      @(posedge vif.{{ spec.clock_reset.clock }});
      if (!vif.{{ spec.clock_reset.reset }}) continue;

      // Check for prolonged inactivity on data/control lines
      // (protocol-specific timeout checks)
{% if p == "apb" %}
      if (vif.psel && !vif.pready) begin
        // Transfer in progress — count wait cycles
        repeat (timeout_cycles) @(posedge vif.{{ spec.clock_reset.clock }});
        if (!vif.pready)
          report_violation(VIOL_TIMING, $sformatf("APB transfer timeout after %0d cycles", timeout_cycles));
      end
{% elif p == "wishbone" %}
      if (vif.stb && !vif.ack) begin
        repeat (timeout_cycles) @(posedge vif.{{ spec.clock_reset.clock }});
        if (!vif.ack)
          report_violation(VIOL_TIMING, $sformatf("Wishbone cycle timeout after %0d cycles", timeout_cycles));
      end
{% endif %}
    end
  endtask

  // -------------------------------------------------------------------------
  // Violation Reporting
  // -------------------------------------------------------------------------
  function void report_violation(violation_e vtype, string msg);
    num_violations++;
    `uvm_warning("PROTOCOL_CHECKER", $sformatf("[%0d] %s (violations=%0d, checked=%0d)",
                 num_violations, msg, num_violations, num_transactions_checked))
  endfunction

  function void report_summary();
    `uvm_info("PROTOCOL_CHECKER", $sformatf(
      "\n  === Protocol Checker Summary for %s ==="
      "\n  Transactions Checked: %0d"
      "\n  Violations Found:     %0d"
      "\n  Status:               %s",
      "{{ spec.design_name }}", num_transactions_checked, num_violations,
      (num_violations == 0) ? "CLEAN" : "VIOLATIONS DETECTED"), UVM_LOW)
  endfunction

  function void extract_phase(uvm_phase phase);
    super.extract_phase(phase);
    report_summary();
  endfunction
endclass
