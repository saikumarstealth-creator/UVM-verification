// UVM Coverage Collector for {{ spec.design_name }} ({{ spec.protocol|default("wishbone", true) }})
{% set p = spec.protocol|default("wishbone") %}
{% set regs = spec.registers if spec.registers else [] %}
{% set addr_ints = regs|map(attribute='address')|map('replace', '0x', '')|map('replace', 'h', '')|map('int', 16)|list %}
{% set max_addr_val = addr_ints|max if addr_ints else 0 %}
{% set addr_width = [max_addr_val.bit_length(), 3]|max %}
{% set sizes = regs|map(attribute='size')|select('number')|list %}
{% set data_width = sizes|max if sizes else 8 %}

class {{ spec.design_name }}_coverage_collector extends uvm_subscriber #({{ spec.design_name }}_seq_item);
  `uvm_component_utils({{ spec.design_name }}_coverage_collector)

  // Register address coverage — dynamically sized from YAML registers
  covergroup reg_address_cg with function sample(bit we, bit [{{ addr_width-1 }}:0] addr, bit [{{ data_width-1 }}:0] data);
    option.per_instance = 1;
    cp_addr: coverpoint addr;
    cp_we:   coverpoint we;
    cp_data: coverpoint data {
      bins zero   = {0};
      bins max    = {({ {data_width{1'b1}} })};
      bins others = default;
    }
    addr_x_we: cross cp_addr, cp_we;
  endgroup

  // Data pattern coverage: alternating, walking-1, edge values
  covergroup data_pattern_cg with function sample(bit [{{ data_width-1 }}:0] data);
    option.per_instance = 1;
    cp_pattern: coverpoint data {
{% for pattern_name, pattern_values in [("alternating", ["AA", "55", "CC", "33"]), ("walking_one", ["01", "02", "04", "08", "10", "20", "40", "80"]), ("walking_zero", ["FE", "FD", "FB", "F7", "EF", "DF", "BF", "7F"]), ("edge", ["00", "FF"]), ("incrementing", ["11", "22", "33", "44", "55", "66", "77", "88", "99", "AA", "BB", "CC", "DD", "EE"])] %}
      bins {{ pattern_name }}[] = { {% for v in pattern_values %}{{ data_width }}'h{{ v }}{% if not loop.last %}, {% endif %}{% endfor %} };
{% endfor %}
      bins others = default;
    }
  endgroup

{% if p == "uart" %}
  // UART-specific coverage: baud rate, frame format, parity mode
  int baud_rates_covered[$];
  // Parity-encoding constants (must match get_parity_mode in scoreboard)
  localparam PARITY_NONE  = 0;
  localparam PARITY_ODD   = 1;
  localparam PARITY_EVEN  = 2;
  localparam PARITY_MARK  = 3;
  localparam PARITY_SPACE = 4;

  covergroup {{ spec.design_name }}_config_cg with function sample(int baud_rate, int data_bits, int stop_bits, int parity_mode);
    option.per_instance = 1;
    option.cross_auto_bin_max = 256;
    cp_baud: coverpoint baud_rate {
      bins standard[] = {9600, 19200, 38400, 57600, 115200, 230400, 460800, 1000000};
    }
    cp_frame: coverpoint {data_bits, stop_bits} {
      bins combos[] = { {5,1}, {5,2}, {6,1}, {6,2}, {7,1}, {7,2}, {8,1}, {8,2} };
    }
    cp_data_bits: coverpoint data_bits {
      bins d5 = {5};
      bins d6 = {6};
      bins d7 = {7};
      bins d8 = {8};
    }
    cp_stop_bits: coverpoint stop_bits {
      bins s1 = {1};
      bins s2 = {2};
    }
    cp_parity: coverpoint parity_mode {
      bins none  = {PARITY_NONE};
      bins odd   = {PARITY_ODD};
      bins even  = {PARITY_EVEN};
      bins mark  = {PARITY_MARK};
      bins space = {PARITY_SPACE};
    }
    cross_baud_parity:      cross cp_baud, cp_parity;
    cross_baud_data_bits:   cross cp_baud, cp_data_bits;
    cross_baud_stop_bits:   cross cp_baud, cp_stop_bits;
    cross_parity_stop_bits: cross cp_parity, cp_stop_bits;
    cross_baud_frame:       cross cp_baud, cp_frame;
  endgroup

  function void sample_uart_config(int baud, int dbits, int sbits, int parity_mode);
    {{ spec.design_name }}_config_cg.sample(baud, dbits, sbits, parity_mode);
    if (!(baud inside {baud_rates_covered}))
      baud_rates_covered.push_back(baud);
  endfunction

  // UART interrupt type coverage (IIR[3:1] encoding)
  covergroup {{ spec.design_name }}_interrupt_cg with function sample(int int_type, bit irq_asserted);
    option.per_instance = 1;
    cp_int_type: coverpoint int_type {
      bins rx_data      = {0};
      bins tx_empty     = {1};
      bins line_status  = {2};
      bins modem_status = {3};
    }
    cp_irq: coverpoint irq_asserted;
    cross_int_irq: cross cp_int_type, cp_irq;
  endgroup

  function void sample_interrupt(int int_type, bit irq_asserted);
    {{ spec.design_name }}_interrupt_cg.sample(int_type, irq_asserted);
  endfunction

  // Error injection type coverage
  covergroup {{ spec.design_name }}_error_cg with function sample(int err_type, bit hw_detected, bit parity_enabled);
    option.per_instance = 1;
    cp_err_type: coverpoint err_type {
      bins parity  = {0};
      bins framing = {1};
      bins brk     = {2};
      bins overrun = {3};
    }
    cp_hw_detected: coverpoint hw_detected;
    cp_parity_en: coverpoint parity_enabled {
      bins disabled = {0};
      bins enabled  = {1};
    }
    cross_err:       cross cp_err_type, cp_hw_detected;
    cross_err_par:   cross cp_err_type, cp_parity_en;
  endgroup

  function void sample_error(int err_type, bit hw_detected, bit parity_enabled = 0);
    {{ spec.design_name }}_error_cg.sample(err_type, hw_detected, parity_enabled);
  endfunction

  // Loopback pass/fail coverage
  covergroup {{ spec.design_name }}_loopback_cg with function sample(int matches, int mismatches);
    option.per_instance = 1;
    cp_result: coverpoint (mismatches == 0) {
      bins pass = {1};
      bins fail = {0};
    }
    cp_matches: coverpoint matches {
      bins zero    = {0};
      bins one     = {1};
      bins several = {[2:10]};
      bins many    = {[11:32]};
    }
    cp_mismatches: coverpoint mismatches {
      bins zero = {0};
      bins some = {[1:$]};
    }
    cross_res_mm: cross cp_result, cp_mismatches;
  endgroup

  function void sample_loopback(int matches, int mismatches);
    {{ spec.design_name }}_loopback_cg.sample(matches, mismatches);
  endfunction

  // -----------------------------------------------------------------------
  // Reset coverage — sample register values after reset to confirm defaults
  // -----------------------------------------------------------------------
  covergroup reset_cg with function sample(bit [{{ addr_width-1 }}:0] addr, bit [{{ data_width-1 }}:0] data);
    option.per_instance = 1;
    cp_rst_addr: coverpoint addr;
    cp_rst_data: coverpoint data {
      bins zero    = {0};
      bins nonzero = default;
    }
    cross_rst: cross cp_rst_addr, cp_rst_data;
  endgroup

  function void sample_reset(bit [{{ addr_width-1 }}:0] addr, bit [{{ data_width-1 }}:0] data);
    reset_cg.sample(addr, data);
  endfunction

  // -----------------------------------------------------------------------
  // FIFO depth coverage — occupancy bins: empty, half, full, overflow
  // -----------------------------------------------------------------------
  localparam FIFO_DEPTH = 16;

  covergroup fifo_cg with function sample(int occupancy, bit fifo_en);
    option.per_instance = 1;
    cp_fifo_occupancy: coverpoint occupancy {
      bins empty    = {0};
      bins half     = {[1:FIFO_DEPTH/2]};
      bins full     = {FIFO_DEPTH};
      bins overflow = {[FIFO_DEPTH+1:$]};
    }
    cp_fifo_en: coverpoint fifo_en;
    cross_fifo: cross cp_fifo_occupancy, cp_fifo_en;
  endgroup

  function void sample_fifo(int occupancy, bit fifo_en);
    fifo_cg.sample(occupancy, fifo_en);
  endfunction

  // -----------------------------------------------------------------------
  // IER × interrupt correlation — cross IER enable bits with IRQ type
  // -----------------------------------------------------------------------
  bit [{{ data_width-1 }}:0] captured_ier;

  covergroup ier_interrupt_cg with function sample(
    bit [{{ data_width-1 }}:0] ier_data, int int_type, bit irq_asserted
  );
    option.per_instance = 1;
    cp_ier_erbfi: coverpoint ier_data[0];
    cp_ier_etbei: coverpoint ier_data[1];
    cp_ier_elsi:  coverpoint ier_data[2];
    cp_ier_edssi: coverpoint ier_data[3];
    cp_int_type: coverpoint int_type {
      bins rx_data      = {0};
      bins tx_empty     = {1};
      bins line_status  = {2};
      bins modem_status = {3};
    }
    cp_irq: coverpoint irq_asserted;
    cross_erbfi_int: cross cp_ier_erbfi, cp_int_type, cp_irq;
    cross_etbei_int: cross cp_ier_etbei, cp_int_type, cp_irq;
    cross_elsi_int:  cross cp_ier_elsi,  cp_int_type, cp_irq;
    cross_edssi_int: cross cp_ier_edssi, cp_int_type, cp_irq;
  endgroup

  function void sample_ier_interrupt(int int_type, bit irq_asserted);
    ier_interrupt_cg.sample(captured_ier, int_type, irq_asserted);
  endfunction

  // -----------------------------------------------------------------------
  // Error × LSR correlation — cross injected error type with LSR status flags
  // -----------------------------------------------------------------------
  bit [{{ data_width-1 }}:0] captured_lsr;

  covergroup error_lsr_cg with function sample(
    int err_type, bit hw_detected, bit lsr_pe, bit lsr_fe, bit lsr_oe
  );
    option.per_instance = 1;
    cp_err_type: coverpoint err_type {
      bins parity  = {0};
      bins framing = {1};
      bins brk     = {2};
      bins overrun = {3};
    }
    cp_hw_detected: coverpoint hw_detected;
    cp_lsr_pe: coverpoint lsr_pe;
    cp_lsr_fe: coverpoint lsr_fe;
    cp_lsr_oe: coverpoint lsr_oe;
    cross_err_pe: cross cp_err_type, cp_hw_detected, cp_lsr_pe;
    cross_err_fe: cross cp_err_type, cp_hw_detected, cp_lsr_fe;
    cross_err_oe: cross cp_err_type, cp_hw_detected, cp_lsr_oe;
  endgroup

  function void sample_error_lsr(int err_type, bit hw_detected);
    error_lsr_cg.sample(err_type, hw_detected,
      captured_lsr[2],  // pe is bit 2 of LSR
      captured_lsr[3],  // fe is bit 3 of LSR
      captured_lsr[1]); // oe is bit 1 of LSR
  endfunction
{% endif %}

{% if regs %}
  // ---------------------------------------------------------------------------
  // Per-register field-level covergroups — auto-generated from YAML spec
  // ---------------------------------------------------------------------------
{% for r in regs %}
  covergroup reg_{{ r.name|lower }}_cg with function sample(bit we, bit [{{ data_width-1 }}:0] data);
    option.per_instance = 1;
    cp_access: coverpoint we;
{% if r.fields %}
    // Fields defined in spec for {{ r.name }}
{% for f in r.fields %}
  {% if ':' in f.bits %}
    {% set parts = f.bits.split(':') %}
    {% set msb = parts[0]|int %}
    {% set lsb = parts[1]|int %}
    {% set f_width = msb - lsb + 1 %}
    {{ f.name|lower }}_cp: coverpoint data[{{ msb }}:{{ lsb }}] {
  {% else %}
    {% set bit_pos = f.bits|int %}
    {% set f_width = 1 %}
    {{ f.name|lower }}_cp: coverpoint data[{{ bit_pos }}] {
  {% endif %}
      bins zero  = {0};
      bins max   = '1;
      bins others = default;
    }
{% endfor %}
{% else %}
    cp_data: coverpoint data {
      bins zero  = {0};
      bins max   = '1;
      bins others = default;
    }
{% endif %}
    {{ r.name|lower }}_access: cross cp_access{% if r.fields %}{% for f in r.fields %}, {{ f.name|lower }}_cp{% endfor %}{% else %}, cp_data{% endif %};
  endgroup

{% endfor %}
{% endif %}

  function new(string n, uvm_component p);
    super.new(n, p);
    reg_address_cg = new();
    data_pattern_cg = new();
{% if p == "uart" %}
    {{ spec.design_name }}_config_cg = new();
    {{ spec.design_name }}_interrupt_cg = new();
    {{ spec.design_name }}_error_cg = new();
    {{ spec.design_name }}_loopback_cg = new();
    reset_cg = new();
    fifo_cg = new();
    ier_interrupt_cg = new();
    error_lsr_cg = new();
    captured_ier = 0;
    captured_lsr = 0;
{% endif %}
{% if regs %}
{% for r in regs %}
    reg_{{ r.name|lower }}_cg = new();
{% endfor %}
{% endif %}
  endfunction

  function void write({{ spec.design_name }}_seq_item item);
    reg_address_cg.sample(item.we, item.addr, item.data);
    data_pattern_cg.sample(item.data);
{% if regs %}
    // Sample per-register covergroups based on address
{% for r in regs %}
    if (item.addr == {{ addr_width }}'h{{ r.address.replace('0x', '').replace('h', '') }}) begin
      reg_{{ r.name|lower }}_cg.sample(item.we, item.data);
    end
{% endfor %}
{% endif %}
{% if p == "uart" %}
    // Capture IER data for IER × interrupt cross-coverage
    if (item.addr == {{ addr_width }}'h01) begin
      captured_ier = item.data;
    end
    // Capture LSR data for error × LSR correlation
    if (item.addr == {{ addr_width }}'h05) begin
      captured_lsr = item.data;
    end
{% endif %}
  endfunction
endclass
