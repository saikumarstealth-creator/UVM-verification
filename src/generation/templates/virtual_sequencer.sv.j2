// Enterprise Virtual Sequencer for {{ spec.design_name }} ({{ spec.protocol|default("wishbone", true) }})
// Holds sub-sequencer handles for each interface in the spec.
// Virtual sequences reference vsequencer.<name>_seqr to arbitrate across
// multiple protocol agents.
{%- set p = spec.protocol|default("wishbone") %}
{%- set intfs = spec.interfaces if spec.interfaces else [] %}
class {{ spec.design_name }}_virtual_sequencer extends uvm_sequencer;
  `uvm_component_utils({{ spec.design_name }}_virtual_sequencer)

  // ── Sub-sequencer handles — one per interface ──────────────────────
  // Populated via config DB so virtual sequences can start items
  // on any sub-sequencer.
{%- for intf in intfs %}
  {%- set if_name = intf.name if intf.name is defined else intf %}
  {%- set sname = if_name|replace("_intf", "") + "_seqr" %}
  uvm_sequencer #({{ spec.design_name }}_seq_item) {{ sname }};
{%- endfor %}

  function new(string n, uvm_component p);
    super.new(n, p);
  endfunction

  function void build_phase(uvm_phase phase);
    super.build_phase(phase);
{%- for intf in intfs %}
  {%- set if_name = intf.name if intf.name is defined else intf %}
  {%- set sname = if_name|replace("_intf", "") + "_seqr" %}
    void'(uvm_config_db #(uvm_sequencer #({{ spec.design_name }}_seq_item))::get(this, "", "{{ sname }}", {{ sname }}));
{%- endfor %}
  endfunction
endclass
