# Compile file for {{ spec.design_name }} ({{ spec.protocol|default("wishbone", true) }})
# UVM library path — set UVM_HOME environment variable or edit here
+incdir+.
+incdir+$(UVM_HOME)/src
-uvmhome $(UVM_HOME)
{% for f in spec.files|default([]) %}
../{{ f }}
{% else %}
top_tb.sv
testbench.sv
interface_{{ spec.design_name }}.sv
driver_{{ spec.design_name }}.sv
monitor_{{ spec.design_name }}.sv
sequencer_{{ spec.design_name }}.sv
agent_{{ spec.design_name }}.sv
scoreboard_{{ spec.design_name }}.sv
coverage_collector_{{ spec.design_name }}.sv
env_{{ spec.design_name }}.sv
sequence_item_{{ spec.design_name }}.sv
sequence_{{ spec.design_name }}.sv
test_{{ spec.design_name }}.sv
ral_{{ spec.design_name }}.sv
{% if spec.protocol|default("wishbone") == "uart" %}
../serial_monitor.sv
{% endif %}
{% endfor %}
