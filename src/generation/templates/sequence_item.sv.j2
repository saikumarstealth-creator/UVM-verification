// UVM Sequence Item for {{ spec.design_name }} ({{ spec.protocol|default("wishbone", true) }})
// Enhanced with field automation, serial-level error injection flags, dynamic addr/data widths
{% set p = spec.protocol|default("wishbone") %}
{% set regs = spec.registers if spec.registers else [] %}
{% set addr_ints = regs|map(attribute='address')|map('replace', '0x', '')|map('replace', 'h', '')|map('int', 16)|list %}
{% set max_addr_val = addr_ints|max if addr_ints else 0 %}
{% set addr_bits = [max_addr_val.bit_length(), 3]|max %}
{% set data_width = spec.data_width or 8 %}

class {{ spec.design_name }}_seq_item extends uvm_sequence_item;

  rand logic       we;
  rand logic [{{ addr_bits-1 }}:0] addr;
  rand logic [{{ data_width-1 }}:0] data;
  rand int unsigned delay;

  // Serial-level error injection flags — consumed by the driver to corrupt the
  // serial bitstream at the pin level (not register-field manipulation)
  rand bit         corrupt_parity;
  rand bit         corrupt_stop_bit;
  rand bit         force_break;

  constraint c_default {
    delay inside {[0:5]};
    soft we == 1'b1;
    soft addr == '0;
    {% if regs %}
    soft addr inside { {% for r in regs %}{{ addr_bits }}'h{{ r.address[2:] }}{% if not loop.last %}, {% endif %}{% endfor %} };
    {% endif %}
  }

  constraint c_no_corruption {
    soft corrupt_parity   == 1'b0;
    soft corrupt_stop_bit == 1'b0;
    soft force_break      == 1'b0;
  }

  `uvm_object_utils_begin({{ spec.design_name }}_seq_item)
    `uvm_field_int(we,              UVM_ALL_ON)
    `uvm_field_int(addr,            UVM_ALL_ON)
    `uvm_field_int(data,            UVM_ALL_ON)
    `uvm_field_int(delay,           UVM_ALL_ON)
    `uvm_field_int(corrupt_parity,   UVM_ALL_ON)
    `uvm_field_int(corrupt_stop_bit, UVM_ALL_ON)
    `uvm_field_int(force_break,      UVM_ALL_ON)
  `uvm_object_utils_end

  function new(string name = "{{ spec.design_name }}_seq_item");
    super.new(name);
  endfunction

  function string convert2string();
    return $sformatf("we=%0d addr=0x%0h data=0x%0h delay=%0d corrupt(p=%0d s=%0d b=%0d)",
      we, addr, data, delay, corrupt_parity, corrupt_stop_bit, force_break);
  endfunction

  function void do_print(uvm_printer printer);
    super.do_print(printer);
    printer.print_field("we",              we,              1);
    printer.print_field("addr",            addr,            {{ addr_bits }});
    printer.print_field("data",            data,            {{ data_width }});
    printer.print_int("delay",            delay);
    printer.print_int("corrupt_parity",    corrupt_parity);
    printer.print_int("corrupt_stop_bit",  corrupt_stop_bit);
    printer.print_int("force_break",       force_break);
  endfunction

  // Called by a sequence to request the driver corrupt the serial transmission.
  // The driver checks these flags during serialisation and toggles the
  // appropriate bit (parity, stop, or TX line held low for break).
  function void set_parity_error();
    corrupt_parity = 1'b1;
  endfunction

  function void set_framing_error();
    corrupt_stop_bit = 1'b1;
  endfunction

  function void set_break_condition();
    force_break = 1'b1;
  endfunction
endclass
