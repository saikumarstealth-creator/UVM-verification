// UVM Sequence Item for {{ spec.design_name }} ({{ spec.protocol|default("wishbone", true) }})
// Enhanced with field automation, typed error injection, do_print, dynamic addr/data widths
{% set p = spec.protocol|default("wishbone") %}
{% set regs = spec.registers if spec.registers else [] %}
{% set addr_ints = regs|map(attribute='address')|map('replace', '0x', '')|map('replace', 'h', '')|map('int', 16)|list %}
{% set max_addr_val = addr_ints|max if addr_ints else 0 %}
{% set addr_bits = [max_addr_val.bit_length(), 3]|max %}
{% set data_width = spec.data_width or 8 %}
{% set num_regs = regs|length %}

class {{ spec.design_name }}_seq_item extends uvm_sequence_item;

  rand logic       we;
  rand logic [{{ addr_bits-1 }}:0] addr;
  rand logic [{{ data_width-1 }}:0] data;
  rand int unsigned delay;
  rand int         inj_tag;

  typedef enum int {
    NO_ERROR,
    PARITY_ERROR,
    FRAMING_ERROR,
    BREAK_ERROR
  } error_type_e;

  rand error_type_e error_type;

  {% if p == "spi" %}
  rand logic [7:0] spi_mosi_data;
  rand int         spi_speed_hz;
  {% elif p == "i2c" %}
  rand logic [6:0] i2c_slave_addr;
  rand bit         i2c_10bit;
  {% elif p == "axi4lite" %}
  rand logic [1:0] awburst;
  rand logic [2:0] awsize;
  {% endif %}

  constraint c_default {
    delay inside {[0:5]};
    soft we == 1'b1;
    soft addr == '0;
    {% if p == "uart" %}
    addr inside {[0:{{ num_regs-1 }}]};
    {% endif %}
  }

  `uvm_object_utils_begin({{ spec.design_name }}_seq_item)
    `uvm_field_int(we,         UVM_ALL_ON)
    `uvm_field_int(addr,       UVM_ALL_ON)
    `uvm_field_int(data,       UVM_ALL_ON)
    `uvm_field_int(delay,      UVM_ALL_ON)
    `uvm_field_int(inj_tag,    UVM_ALL_ON)
    `uvm_field_enum(error_type_e, error_type, UVM_ALL_ON)
    {% if p == "spi" %}
    `uvm_field_int(spi_mosi_data, UVM_ALL_ON)
    `uvm_field_int(spi_speed_hz,  UVM_ALL_ON)
    {% elif p == "i2c" %}
    `uvm_field_int(i2c_slave_addr, UVM_ALL_ON)
    `uvm_field_int(i2c_10bit,     UVM_ALL_ON)
    {% elif p == "axi4lite" %}
    `uvm_field_int(awburst,       UVM_ALL_ON)
    `uvm_field_int(awsize,        UVM_ALL_ON)
    {% endif %}
  `uvm_object_utils_end

  function new(string name = "{{ spec.design_name }}_seq_item");
    super.new(name);
  endfunction

  function string convert2string();
    return $sformatf("we=%0d addr=0x%0h data=0x%0h delay=%0d inj_tag=%0d error_type=%s",
      we, addr, data, delay, inj_tag, error_type.name());
  endfunction

  function void do_print(uvm_printer printer);
    super.do_print(printer);
    printer.print_field("we",         we,         1);
    printer.print_field("addr",       addr,       {{ addr_bits }});
    printer.print_field("data",       data,       {{ data_width }});
    printer.print_int("delay",       delay);
    printer.print_int("inj_tag",     inj_tag);
    printer.print_string("error_type", error_type.name());
    {% if p == "spi" %}
    printer.print_field("spi_mosi_data", spi_mosi_data, 8);
    printer.print_int("spi_speed_hz",    spi_speed_hz);
    {% elif p == "i2c" %}
    printer.print_field("i2c_slave_addr", i2c_slave_addr, 7);
    printer.print_field("i2c_10bit",      i2c_10bit,      1);
    {% elif p == "axi4lite" %}
    printer.print_field("awburst", awburst, 2);
    printer.print_field("awsize",  awsize,  3);
    {% endif %}
  endfunction

  // Error injection — call from sequence to force a specific error type
  function void inject_error(error_type_e err);
    error_type = err;
    case (err)
      PARITY_ERROR:  we = $urandom;
      FRAMING_ERROR: delay = $urandom_range(10, 20);
      BREAK_ERROR:   data = '0;
      default: ; // NO_ERROR
    endcase
  endfunction
endclass
