class {{ seq.name }}_test extends {{ spec.design_name }}_base_test;
  `uvm_component_utils({{ seq.name }}_test)

  function new(string n, uvm_component p);
    super.new(n, p);
  endfunction

  task run_top_sequence();
    {%- set sv_class = seq_to_class.get(seq.name, "uart_config_seq") %}
    {{ sv_class }} seq;
    seq = {{ sv_class }}::type_id::create("seq");
    if (seq == null) `uvm_fatal("SEQ", "Failed to create sequence")
    seq.reg_model = reg_model;
{% if seq.name == "uart_loopback" %}
    seq.test_data = '{8'h55, 8'hAA, 8'h33, 8'hCC};
{% elif seq.name == "uart_error_injection" %}
    seq.inj_type = uart_error_injection_seq::INJ_PARITY;
    seq.num_injections = 5;
{% elif seq.name == "uart_random" %}
    if (!seq.randomize()) `uvm_fatal("RAND", "Randomization failed")
{% endif %}
    `uvm_info("TEST_{{ seq.name|upper }}", $sformatf("Starting test: {{ seq.description }}"), UVM_LOW)
