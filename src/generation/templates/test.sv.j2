class {{ seq.name }}_test extends {{ spec.design_name }}_base_test;
  `uvm_component_utils({{ seq.name }}_test)

  function new(string n, uvm_component p);
    super.new(n, p);
  endfunction

  task run_top_sequence();
    {%- set sv_class = seq_to_class.get(seq.name, "{{ spec.design_name }}_config_seq") %}
    {{ sv_class }} seq;
    seq = {{ sv_class }}::type_id::create("seq");
    if (seq == null) `uvm_fatal("SEQ", "Failed to create sequence")
    seq.reg_model = reg_model;
{% if seq.name == spec.design_name ~ "_loopback" %}
    if (!seq.randomize() with { test_data.size() inside {[4:16]}; })
      `uvm_fatal("RAND", "Loopback seq randomization failed")
{% elif seq.name == spec.design_name ~ "_error_injection" %}
    seq.inj_type = {{ spec.design_name }}_error_injection_seq::INJ_PARITY;
    seq.num_injections = 5;
{% elif seq.name == spec.design_name ~ "_random" %}
    if (!seq.randomize()) `uvm_fatal("RAND", "Randomization failed")
{% endif %}
    `uvm_info("TEST_{{ seq.name|upper }}", $sformatf("Starting test: {{ seq.description }}"), UVM_LOW)
    run_sequence_with_timeout(seq, 10ms);
    `uvm_info("TEST_{{ seq.name|upper }}", "Test completed", UVM_LOW)
  endtask
endclass

