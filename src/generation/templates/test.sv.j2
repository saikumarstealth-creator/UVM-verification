class {{ spec.design_name }}_reset_test extends {{ spec.design_name }}_base_test;
  `uvm_component_utils({{ spec.design_name }}_reset_test)

  function new(string n, uvm_component p);
    super.new(n, p);
  endfunction

  task run_top_sequence();
    {{ spec.design_name }}_reg_hw_reset_seq hw_rst_seq;
    {{ spec.design_name }}_reset_test_seq    sw_rst_seq;

    `uvm_info("TEST_RST", "Starting HW reset verification via RAL", UVM_LOW)
    hw_rst_seq = {{ spec.design_name }}_reg_hw_reset_seq::type_id::create("hw_rst_seq");
    if (hw_rst_seq == null) `uvm_fatal("SEQ", "Failed to create hw_rst_seq")
    hw_rst_seq.reg_model = reg_model;
    begin
      bit rst_timeout;
      fork
        hw_rst_seq.start(env.agent.sequencer);
        begin
          #(default_timeout);
          rst_timeout = 1'b1;
        end
      join_any
      disable fork;
      if (rst_timeout)
        `uvm_fatal("TIMEOUT", "HW reset sequence timed out")
    end

    `uvm_info("TEST_RST", "Starting register reset value verification", UVM_LOW)
    sw_rst_seq = {{ spec.design_name }}_reset_test_seq::type_id::create("sw_rst_seq");
    if (sw_rst_seq == null) `uvm_fatal("SEQ", "Failed to create sw_rst_seq")
    sw_rst_seq.reg_model = reg_model;
    run_sequence_with_timeout(sw_rst_seq);

    `uvm_info("TEST_RST", "Reset verification completed", UVM_LOW)
  endtask
endclass

