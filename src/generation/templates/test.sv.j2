// Enhanced UVM Tests for {{ spec.design_name }}
// Includes: Base test, Register tests, protocol-specific tests
{% set p = spec.protocol|default("wishbone") %}
{% set addr_ints = [] %}
{% for r in spec.registers %}
{% set _ = addr_ints.append(r.address|int(base=16)) %}
{% endfor %}
{% set max_addr_val = addr_ints|max if addr_ints else 0 %}
{% set addr_bits = [max_addr_val.bit_length(), 3]|max %}

class {{ spec.design_name }}_base_test extends uvm_test;
  `uvm_component_utils({{ spec.design_name }}_base_test)

  {{ spec.design_name }}_env env;
  {{ spec.design_name }}_reg_block reg_model;
  virtual {{ spec.design_name }}_intf vif;
  time default_timeout = 100ms;

  function new(string n, uvm_component p);
    super.new(n, p);
  endfunction

  function void build_phase(uvm_phase phase);
    super.build_phase(phase);

    env = {{ spec.design_name }}_env::type_id::create("env", this);

    if (!uvm_config_db#(virtual {{ spec.design_name }}_intf)::get(this, "", "vif", vif)) begin
      `uvm_fatal("NOVIF", "Virtual interface not set")
    end

    reg_model = {{ spec.design_name }}_reg_block::type_id::create("reg_model", this);
    reg_model.build();
    reg_model.lock_model();
    uvm_config_db#({{ spec.design_name }}_reg_block)::set(this, "*", "reg_model", reg_model);
  endfunction

  function void connect_phase(uvm_phase phase);
    super.connect_phase(phase);
    reg_model.default_map.set_sequencer(env.agent.sequencer, env.reg_adapter);
    reg_model.default_map.set_auto_predict(1);
  endfunction

  // ── Factory override helper ─────────────────────────────────────────
  // To use type/instance overrides, call this in a derived test's build_phase
  // BEFORE super.build_phase():
  //
  //   function void build_phase(uvm_phase phase);
  //     // Replace all standard drivers with custom_driver
  //     set_type_override_by_type(
  //       {{ spec.design_name }}_driver::get_type(),
  //       {{ spec.design_name }}_custom_driver::get_type()
  //     );
  //     super.build_phase(phase);
  //   endfunction
  //
  // See factory_overrides_{{ spec.design_name }}.sv for extended examples.

  function void end_of_elaboration_phase(uvm_phase phase);
    uvm_top.print_topology();
    print_test_config();
  endfunction

  function void print_test_config();
    `uvm_info("TEST", "========================================", UVM_LOW)
    `uvm_info("TEST", $sformatf("  Test Name:  %s", get_type_name()), UVM_LOW)
{% if p == "uart" %}
    `uvm_info("TEST", "  Protocol:   UART (16550 compatible)", UVM_LOW)
{% elif p == "spi" %}
    `uvm_info("TEST", "  Protocol:   SPI", UVM_LOW)
{% elif p == "i2c" %}
    `uvm_info("TEST", "  Protocol:   I2C", UVM_LOW)
{% elif p == "axi4lite" %}
    `uvm_info("TEST", "  Protocol:   AXI4-Lite", UVM_LOW)
{% elif p == "apb" %}
    `uvm_info("TEST", "  Protocol:   APB", UVM_LOW)
{% else %}
    `uvm_info("TEST", "  Protocol:   Wishbone", UVM_LOW)
{% endif %}
    `uvm_info("TEST", "========================================", UVM_LOW)
  endfunction

  task run_phase(uvm_phase phase);
    phase.raise_objection(this);
    `uvm_info("TEST", "Starting test...", UVM_LOW)
    apply_reset();
    run_top_sequence();
    phase.drop_objection(this);
  endtask

  virtual task apply_reset();
{% if p == "uart" %}
    vif.rst_n <= 1'b0;
    vif.uart_rx <= 1'b1;
    vif.cts_n <= 1'b0;
    repeat (10) @(posedge vif.clk);
    vif.rst_n <= 1'b1;
    repeat (5) @(posedge vif.clk);
{% else %}
    vif.rst_n <= 1'b0;
    repeat (10) @(posedge vif.clk);
    vif.rst_n <= 1'b1;
    repeat (5) @(posedge vif.clk);
{% endif %}
  endtask

  virtual task run_top_sequence();
    uart_all_regs_seq seq;
    seq = uart_all_regs_seq::type_id::create("seq");
    if (seq == null) `uvm_fatal("SEQ", "Failed to create sequence")
    seq.reg_model = reg_model;
    run_sequence_with_timeout(seq);
  endtask

  // Helper: register write via RAL (uses reg-level API for callbacks, prediction, coverage)
  protected task write_reg(bit [{{ addr_bits-1 }}:0] addr, bit [7:0] data);
    uvm_reg_addr_t addrs[$];
    uvm_reg regs[$];
    uvm_status_e status;
    uvm_reg_data_t val;
    reg_model.get_registers(regs);
    val = data;
    foreach (regs[i]) begin
      addrs = regs[i].get_addresses();
      if (addrs.size() > 0 && addrs[0] == addr) begin
        regs[i].write(status, val);
        return;
      end
    end
    `uvm_warning("WR_REG", $sformatf("No register at address 0x%0h — using raw map write", addr))
    reg_model.default_map.write(status, addr, val);
  endtask

  // Helper: register read via RAL
  protected task read_reg(bit [{{ addr_bits-1 }}:0] addr, output bit [7:0] data);
    uvm_reg_addr_t addrs[$];
    uvm_reg regs[$];
    uvm_reg_data_t val;
    uvm_status_e status;
    reg_model.get_registers(regs);
    foreach (regs[i]) begin
      addrs = regs[i].get_addresses();
      if (addrs.size() > 0 && addrs[0] == addr) begin
        regs[i].read(status, val);
        data = val[7:0];
        return;
      end
    end
    reg_model.default_map.read(status, addr, val);
    data = val[7:0];
  endtask

  protected task run_sequence_with_timeout(uvm_sequence_base seq, time timeout = 0);
    bit timeout_hit;
    time effective_timeout = (timeout > 0) ? timeout : default_timeout;
    fork
      seq.start(env.agent.sequencer);
      begin
        #(effective_timeout);
        timeout_hit = 1'b1;
      end
    join_any
    disable fork;
    if (timeout_hit)
      `uvm_fatal("TIMEOUT", $sformatf("Sequence %s timed out after %0t", seq.get_type_name(), effective_timeout))
  endtask

  // Compute a baud-rate-aware timeout for UART transactions.
  // Each byte takes ~10 bit-times at the given baud rate;
  // margin multiplies for safety across variable DUT response times.
  protected function time compute_timeout(int baud_rate, int num_bytes = 1, real margin = 20.0);
    real bit_time_ns;
    real total_time_ns;
    bit_time_ns = 1_000_000_000.0 / baud_rate;
    total_time_ns = bit_time_ns * 10.0 * num_bytes * margin;
    return total_time_ns * 1ns;
  endfunction

  function void extract_phase(uvm_phase phase);
    super.extract_phase(phase);
    if (env.sb != null && !env.sb.check_data_integrity()) begin
      `uvm_error("SCOREBOARD", "Scoreboard data integrity check FAILED")
    end
  endfunction

  function void report_phase(uvm_phase phase);
    uvm_report_server svr;
    svr = uvm_report_server::get_server();

    if (svr.get_severity_count(UVM_FATAL) +
        svr.get_severity_count(UVM_ERROR) > 0) begin
      `uvm_info("TEST_REPORT", "**************************************", UVM_LOW)
      `uvm_info("TEST_REPORT", "********   TEST FAILED   ************", UVM_LOW)
      `uvm_info("TEST_REPORT", "**************************************", UVM_LOW)
    end else begin
      `uvm_info("TEST_REPORT", "**************************************", UVM_LOW)
      `uvm_info("TEST_REPORT", "********   TEST PASSED   ************", UVM_LOW)
      `uvm_info("TEST_REPORT", "**************************************", UVM_LOW)
    end
  endfunction
endclass

