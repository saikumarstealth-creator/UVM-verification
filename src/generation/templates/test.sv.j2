class uart_fifo_test extends {{ spec.design_name }}_base_test;
  `uvm_component_utils(uart_fifo_test)

  function new(string n, uvm_component p);
    super.new(n, p);
  endfunction

  task run_top_sequence();
    uart_config_seq cfg_seq;
    uart_tx_seq tx_seq;
    logic [7:0] rd_data;

    `uvm_info("TEST_FIFO", "Configuring UART with FIFO enabled (FCR=0x07)", UVM_LOW)
    cfg_seq = uart_config_seq::type_id::create("cfg_seq");
    if (cfg_seq == null) `uvm_fatal("SEQ", "Failed to create cfg_seq")
    cfg_seq.reg_model = reg_model;
    cfg_seq.baud_rate = 115200;
    cfg_seq.data_bits = 8;
    cfg_seq.stop_bits = 1;
    run_sequence_with_timeout(cfg_seq, 10ms);

    // Enable FIFO: RCVR FIFO reset + XMIT FIFO reset + enable
    write_reg(3'h02, 8'h07);
    read_reg(3'h02, rd_data);
    `uvm_info("TEST_FIFO", $sformatf("FCR=0x%0h", rd_data), UVM_LOW)

    // Fill FIFO (16 bytes for 16550)
    `uvm_info("TEST_FIFO", "Filling TX FIFO with 16 bytes", UVM_LOW)
    tx_seq = uart_tx_seq::type_id::create("tx_seq");
    if (tx_seq == null) `uvm_fatal("SEQ", "Failed to create tx_seq")
    tx_seq.reg_model = reg_model;
    tx_seq.tx_data = '{16{8'hA5}};
    tx_seq.num_bytes = 16;
    run_sequence_with_timeout(tx_seq, 10ms);

    // Read LSR to check FIFO status bits
    read_reg(3'h05, rd_data);
    `uvm_info("TEST_FIFO", $sformatf("LSR after FIFO fill=0x%0h (bit5=THR empty, bit6=TX empty)", rd_data), UVM_LOW)

    if (rd_data[5])
      `uvm_info("TEST_FIFO", "THR empty (TX FIFO empty) — OK", UVM_LOW)
    else
      `uvm_warning("TEST_FIFO", "TX FIFO not empty — possible overflow")

    `uvm_info("TEST_FIFO", "FIFO test completed", UVM_LOW)
  endtask
endclass

