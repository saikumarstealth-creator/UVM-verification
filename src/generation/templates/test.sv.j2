// Enhanced UVM Tests for {{ spec.design_name }}
// Includes: Base test, Register tests, protocol-specific tests
{% set p = spec.protocol|default("wishbone") %}

class {{ spec.design_name }}_base_test extends uvm_test;
  `uvm_component_utils({{ spec.design_name }}_base_test)

  {{ spec.design_name }}_env env;
  {{ spec.design_name }}_reg_block reg_model;
  virtual {{ spec.design_name }}_intf vif;

  function new(string n, uvm_component p);
    super.new(n, p);
  endfunction

  function void build_phase(uvm_phase phase);
    env = {{ spec.design_name }}_env::type_id::create("env", this);

    if (!uvm_config_db#(virtual {{ spec.design_name }}_intf)::get(this, "", "vif", vif)) begin
      `uvm_fatal("NOVIF", "Virtual interface not set")
    end

    reg_model = {{ spec.design_name }}_reg_block::type_id::create("reg_model", this);
    reg_model.build();
    reg_model.lock_model();
    uvm_config_db#({{ spec.design_name }}_reg_block)::set(this, "*", "reg_model", reg_model);

    reg_model.default_map.set_sequencer(env.agent.sequencer, env.reg_adapter);
    reg_model.default_map.set_auto_predict(1);
  endfunction

  // ── Factory override helper ─────────────────────────────────────────
  // To use type/instance overrides, call this in a derived test's build_phase
  // BEFORE super.build_phase():
  //
  //   function void build_phase(uvm_phase phase);
  //     // Replace all standard drivers with custom_driver
  //     set_type_override_by_type(
  //       {{ spec.design_name }}_driver::get_type(),
  //       {{ spec.design_name }}_custom_driver::get_type()
  //     );
  //     super.build_phase(phase);
  //   endfunction
  //
  // See factory_overrides_{{ spec.design_name }}.sv for extended examples.

  function void end_of_elaboration_phase(uvm_phase phase);
    uvm_top.print_topology();
    print_test_config();
  endfunction

  function void print_test_config();
    `uvm_info("TEST", "========================================", UVM_LOW)
    `uvm_info("TEST", $sformatf("  Test Name:  %s", get_type_name()), UVM_LOW)
{% if p == "uart" %}
    `uvm_info("TEST", "  Protocol:   UART (16550 compatible)", UVM_LOW)
{% elif p == "spi" %}
    `uvm_info("TEST", "  Protocol:   SPI", UVM_LOW)
{% elif p == "i2c" %}
    `uvm_info("TEST", "  Protocol:   I2C", UVM_LOW)
{% elif p == "axi4lite" %}
    `uvm_info("TEST", "  Protocol:   AXI4-Lite", UVM_LOW)
{% elif p == "apb" %}
    `uvm_info("TEST", "  Protocol:   APB", UVM_LOW)
{% else %}
    `uvm_info("TEST", "  Protocol:   Wishbone", UVM_LOW)
{% endif %}
    `uvm_info("TEST", "========================================", UVM_LOW)
  endfunction

  task run_phase(uvm_phase phase);
    phase.raise_objection(this);
    `uvm_info("TEST", "Starting test...", UVM_LOW)
    apply_reset();
    run_top_sequence();
    phase.drop_objection(this);
  endtask

  virtual task apply_reset();
{% if p == "uart" %}
    vif.rst_n <= 1'b0;
    vif.uart_rx <= 1'b1;
    vif.cts_n <= 1'b0;
    repeat (10) @(posedge vif.clk);
    vif.rst_n <= 1'b1;
    repeat (5) @(posedge vif.clk);
{% else %}
    vif.rst_n <= 1'b0;
    repeat (10) @(posedge vif.clk);
    vif.rst_n <= 1'b1;
    repeat (5) @(posedge vif.clk);
{% endif %}
  endtask

  virtual task run_top_sequence();
    {{ spec.design_name }}_all_regs_seq seq;
    seq = {{ spec.design_name }}_all_regs_seq::type_id::create("seq");
    if (seq == null) `uvm_fatal("SEQ", "Failed to create sequence")
    seq.reg_model = reg_model;
    run_sequence_with_timeout(seq, 10ms);
  endtask

  protected task run_sequence_with_timeout(uvm_sequence_base seq, time timeout);
    bit timeout_hit;
    fork
      seq.start(env.agent.sequencer);
      begin
        #(timeout);
        timeout_hit = 1'b1;
      end
    join_any
    disable fork;
    if (timeout_hit)
      `uvm_fatal("TIMEOUT", $sformatf("Sequence %s timed out after %0t", seq.get_type_name(), timeout))
  endtask

  function void report_phase(uvm_phase phase);
    uvm_report_server svr;
    svr = uvm_report_server::get_server();

    if (svr.get_severity_count(UVM_FATAL) +
        svr.get_severity_count(UVM_ERROR) > 0) begin
      `uvm_info("TEST_REPORT", "**************************************", UVM_LOW)
      `uvm_info("TEST_REPORT", "********   TEST FAILED   ************", UVM_LOW)
      `uvm_info("TEST_REPORT", "**************************************", UVM_LOW)
    end else begin
      `uvm_info("TEST_REPORT", "**************************************", UVM_LOW)
      `uvm_info("TEST_REPORT", "********   TEST PASSED   ************", UVM_LOW)
      `uvm_info("TEST_REPORT", "**************************************", UVM_LOW)
    end
  endfunction
endclass

{% if p == "uart" %}

