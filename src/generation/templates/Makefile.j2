# ============================================================================
# Makefile for {{ spec.design_name }} UVM Testbench
# Auto-generated by UVM-Verification Pipeline
# Protocol: {{ spec.protocol|default("wishbone", true) }}
# ============================================================================
{% set p = spec.protocol|default("wishbone") %}
{% set regs = spec.registers if spec.registers else [] %}
{% set name = spec.design_name %}

# ── Simulator selection ─────────────────────────────────────────────────────
SIM       ?= icarus
UVM_HOME  ?= $(UVM_HOME)
TOP       ?= {{ name }}_top

# ── Directories ─────────────────────────────────────────────────────────────
SRC_DIR   := .
OUT_DIR   := sim_out
LOG_DIR   := $(OUT_DIR)/logs
COV_DIR   := $(OUT_DIR)/coverage
WORK_DIR  := $(OUT_DIR)/work

# ── Source files ────────────────────────────────────────────────────────────
RTL_FILES := $(wildcard rtl/*.v rtl/*.sv)

SV_FILES := \
	{{ name }}_intf.sv \
	{{ name }}_seq_item.sv \
	{{ name }}_driver.sv \
	{{ name }}_monitor.sv \
	{{ name }}_agent.sv \
	{{ name }}_scoreboard.sv \
	{{ name }}_coverage_collector.sv \
	ral_{{ name }}.sv \
	base_seq_{{ name }}.sv \
	virtual_sequencer_{{ name }}.sv \
	{{ name }}_env.sv \
	test_{{ name }}.sv \
	protocol_checker_{{ name }}.sv \
	assertions_{{ name }}.sv \
	testbench_{{ name }}.sv

ALL_SV := $(SV_FILES) $(RTL_FILES)

# ── Icarus (iverilog) ───────────────────────────────────────────────────────
ICARUS_FLAGS := -g2012 -Wall -o $(OUT_DIR)/simv \
	-I$(SRC_DIR) \
	$(addprefix -I, $(UVM_HOME)/src) \
	$(UVM_HOME)/src/uvm_pkg.sv \
	$(addprefix , $(ALL_SV))

.PHONY: compile-icarus run-icarus

compile-icarus:
	mkdir -p $(OUT_DIR) $(LOG_DIR)
	iverilog $(ICARUS_FLAGS) 2>&1 | tee $(LOG_DIR)/compile.log

run-icarus:
	cd $(OUT_DIR) && ./simv 2>&1 | tee ../$(LOG_DIR)/sim.log

# ── VCS ─────────────────────────────────────────────────────────────────────
VCS_FLAGS := -full64 -sverilog +v2k -timescale=1ns/1ps \
	-debug_all -l $(LOG_DIR)/vcs_compile.log \
	-cm line+cond+tgl+assert -cm_dir $(COV_DIR)

.PHONY: compile-vcs run-vcs

compile-vcs:
	mkdir -p $(OUT_DIR) $(LOG_DIR) $(COV_DIR)
	vlogan $(VCS_FLAGS) $(ALL_SV)
	vcs -debug_all -l $(LOG_DIR)/vcs_elab.log -cm line+cond+tgl+assert $(TOP)

run-vcs:
	./simv -l $(LOG_DIR)/vcs_sim.log -cm line+cond+tgl+assert

# ── Questa/ModelSim ─────────────────────────────────────────────────────────
QUESTA_FLAGS := -64 -novopt -sv +UVM_NO_RELNOTES +define+UVM_NO_DPI

.PHONY: compile-questa run-questa

compile-questa:
	mkdir -p $(OUT_DIR) $(LOG_DIR) $(WORK_DIR)
	vlib $(WORK_DIR)/work
	vmap work $(WORK_DIR)/work
	vlog $(QUESTA_FLAGS) -work work $(ALL_SV) 2>&1 | tee $(LOG_DIR)/questa_compile.log

run-questa:
	vsim -c -do "run -all; exit" -l $(LOG_DIR)/questa_sim.log $(TOP)

# ── Common targets ──────────────────────────────────────────────────────────
.PHONY: compile run clean lint regress smoke sanity help

compile: compile-$(SIM)

run: run-$(SIM)

# ── Regression ──────────────────────────────────────────────────────────────
regress: compile
	$(MAKE) run
	@echo "=============================================="
	@echo "  Regression complete for {{ name }}"
	@echo "  Log: $(LOG_DIR)/sim.log"
	@echo "=============================================="

# ── Smoke test (quick sanity during development) ────────────────────────────
SMOKE_TIMEOUT ?= 1ms

smoke: SIM=icarus
smoke:
	@echo "Running smoke test (timeout=$(SMOKE_TIMEOUT))..."
	$(MAKE) compile-icarus
	echo '$(SMOKE_TIMEOUT)' > $(OUT_DIR)/timeout
	$(MAKE) run-icarus
	@echo "Smoke test complete"

# ── Sanity check (compile + run base test) ──────────────────────────────────
sanity:
	@echo "Running sanity check..."
	$(MAKE) compile
	$(MAKE) run
	@echo "Sanity check complete"

# ── All targets (full regression suite) ─────────────────────────────────────
# Runs smoke, sanity, and all test cases in sequence
full: smoke sanity
	@echo "Full regression suite complete for {{ name }}"

# ── Clean ───────────────────────────────────────────────────────────────────
clean:
	rm -rf $(OUT_DIR)
	rm -f *.vpd *.vcd *.fsdb
	rm -rf DVE* csrc* simv* *.key
	rm -rf transcript* vsim.wlf wave.wlf
	rm -rf *.log *.syn *.rpt
	@echo "Clean complete"

# ── Help ────────────────────────────────────────────────────────────────────
help:
	@echo "Usage: make <target> [SIM=icarus|vcs|questa]"
	@echo ""
	@echo "Targets:"
	@echo "  compile    Compile for selected simulator"
	@echo "  run        Run simulation"
	@echo "  regress    Full compile + run"
	@echo "  smoke      Quick smoke test (default: icarus)"
	@echo "  sanity     Sanity check (compile + run base test)"
	@echo "  full       Full regression suite"
	@echo "  clean      Remove build artifacts"
	@echo "  help       Show this message"
	@echo ""
	@echo "Examples:"
	@echo "  make smoke              # Quick icarus test"
	@echo "  make SIM=vcs regress    # VCS full regression"
	@echo "  make SIM=questa compile # Questa compilation only"
